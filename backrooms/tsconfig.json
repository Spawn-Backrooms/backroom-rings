{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "client/**/*.ts",
    "flue/**/*.ts",
    "reference-host/**/*.ts",
    "gateway-host/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "releases/**/*.ts"
  ]
}
