+    await service('ring-indexer', binaries.ringIndexer, ['--db-url', `sqlite://${join(workDirectory, 'ring-indexer.sqlite')}?mode=rwc`,
+      '--rpc-url', urls.rpc, '--photon-url', urls.photon, '--bind', '127.0.0.1', '--port', String(ports.ringIndexer), '--start-slot', '0']);
