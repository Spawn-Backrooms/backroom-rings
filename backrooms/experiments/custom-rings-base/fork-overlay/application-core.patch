+++ b/tools/prepare-spawn-room-localnet.sh
@@ -0,0 +1,111 @@
+#!/usr/bin/env bash
+# Prepare two separate experimental application keys, prove their full circuits,
+# export exact Rust keys/public fixtures, and build the localnet prover/program.
+# Existing upstream/v0 catalogs are never regenerated or overwritten.
+set -euo pipefail
+
+root="$(cd "$(dirname "$0")/.." && pwd)"
+if (($#)); then
+  echo "Usage: tools/prepare-spawn-room-localnet.sh" >&2
+  echo "Uses target/spawn-room-keys; existing keys must match the current complete R1CS." >&2
+  exit 64
+fi
+cd "$root"
+expected_go="$(awk '$1 == "go" { print "go" $2; exit }' prover/go.mod)"
+[[ "$(go env GOVERSION)" == "$expected_go" ]] || {
+  echo "Use the Go version pinned by prover/go.mod: $expected_go" >&2
+  exit 1
+}
+[[ "$(git -C zolana rev-parse HEAD)" == "0fe4f952182b39464d472c52c40b3febe6cbd9ec" ]] || {
+  echo "The Zolana checkout does not match this experimental profile's source pin" >&2
+  exit 1
+}
+export GOENV=off GOWORK=off
+export GOMAXPROCS="${GOMAXPROCS:-2}"
+export GOMEMLIMIT="${GOMEMLIMIT:-3GiB}"
+keys="$root/target/spawn-room-keys"
+mkdir -p "$keys" "$root/target/spawn-prover-keys"
+for operation in advance genesis; do
+  name="spawn-room-$operation-v1"
+  test_name=TestSpawnRoomApplicationGroth16Proof
+  [[ "$operation" != genesis ]] || test_name=TestSpawnRoomGenesisGroth16Proof
+  reuse=0
+  if [[ -e "$keys/$name.key" ]]; then
+    [[ -s "$keys/$name.vk.bin" ]] || {
+      echo "Incomplete prior setup for $name; retain it for diagnosis before making a fresh key directory" >&2
+      exit 1
+    }
+    reuse=1
+  fi
+  (
+    cd prover
+    SPAWN_ROOM_PROOF_DIR="$keys" SPAWN_ROOM_REUSE_LOCAL_KEY="$reuse" \
+      go test ./circuits/transfer -run "^${test_name}$" -timeout 30m -count=1 -v
+  )
+  mkdir -p programs/custom-ring/src/instructions/spawn_room/keys
+  cargo run --locked --manifest-path zolana/Cargo.toml --target-dir "$root/target" -p xtask -- \
+    bsb22-vk "$keys/$name.vk.bin" "$keys/$name.key" \
+    programs/custom-ring/src/instructions/spawn_room/keys "$operation.rs" --insecure-test-setup
+  cp "$keys/$name.proof.json" "test-vectors/proof/$name.json"
+done
+
+# Publish only public key metadata and public proof vectors. Request bodies and
+# proving artifacts remain in ignored target directories.
+python3 - "$root" <<'PY'
+import hashlib, json, pathlib, sys
+root = pathlib.Path(sys.argv[1])
+keys = root / "target/spawn-room-keys"
+served = root / "target/spawn-prover-keys"
+entries = {}
+for operation in ("advance", "genesis"):
+    stem = f"spawn-room-{operation}-v1"
+    file = keys / f"{stem}.key"
+    with file.open("rb") as source:
+        digest = hashlib.file_digest(source, "sha256").hexdigest()
+    proof = json.loads((keys / f"{stem}.proof.json").read_text())
+    if proof["proof"]["provingKeySha256"] != digest:
+        raise SystemExit(f"Proof/key digest mismatch for {stem}")
+    name = f"spawn_room_{operation}_v1.key"
+    link = served / name
+    if link.is_symlink() and link.resolve() == file.resolve():
+        pass
+    elif link.exists() or link.is_symlink():
+        raise SystemExit(f"Refusing to replace unexpected key path {link}")
+    else:
+        link.symlink_to(file)
+    entries[name] = {"sha256": digest, "size": file.stat().st_size}
+# Reuse only local cached upstream keys; normal pinned download commands remain
+# responsible for fetching and checking those artifacts.
+for file in (root / "zolana/prover/server/proving-keys").glob("*.key"):
+    link = served / file.name
+    if not link.exists() and not link.is_symlink():
+        link.symlink_to(file.resolve())
+manifest = {"setup": "insecure localnet only", "keys": entries}
+(keys / "localnet-keys.json").write_text(json.dumps(manifest, indent=2) + "\n")
+lines = ["// Generated by tools/prepare-spawn-room-localnet.sh. Local validator keys only.",
+         "export const SPAWN_ROOM_LOCALNET_INSECURE = true as const;", "",
+         "export const SPAWN_ROOM_LOCALNET_KEYS: Readonly<",
+         "  Record<string, Readonly<{ sha256: string; size: number }>>",
+         "> = Object.freeze({"]
+for name, entry in entries.items():
+    lines += [f'  "{name}": Object.freeze({{',
+              f'    sha256: "{entry["sha256"]}",',
+              f'    size: {entry["size"]},', "  }),"]
+lines += ["});", ""]
+(root / "sdk-libs/ts/src/experimental/spawn-room/localnet-keys.ts").write_text("\n".join(lines))
+print(json.dumps(manifest, indent=2))
+PY
+
+(
+  cd prover
+  SPAWN_ROOM_REQUEST_DIR="$keys" go test ./circuits/transfer \
+    -run '^TestSpawnRoomFullRequestRoundTrip$' -timeout 5m -count=1
+  go build -trimpath -o ../target/spawn-room-prover ./cmd/spawn-room-prover
+)
+rustfmt --edition 2021 programs/custom-ring/src/instructions/spawn_room/keys/{advance,genesis}.rs
+cargo test --locked -p custom-ring-program --test spawn_room_proofs \
+  --features spawn-room-v1-localnet-keys
+CARGO_TARGET_DIR="$root/target/spawn-sbf" \
+  zolana/tools/build-programs.sh --manifest-path programs/custom-ring/Cargo.toml -- \
+  --locked --features bpf-entrypoint,spawn-room-v1-localnet-keys
+sha256sum target/deploy/custom_ring_program.so
