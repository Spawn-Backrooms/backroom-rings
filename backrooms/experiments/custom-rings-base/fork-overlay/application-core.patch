+package transfer_test
+
+import (
+	"bytes"
+	"encoding/json"
+	"fmt"
+	"math/big"
+	"os"
+	"path/filepath"
+	"reflect"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/test"
+	"github.com/helius-labs/zolana-custom-rings/prover/ring"
+)
+
+// Exercise the actual strict server request assignment with the same honest
+// witnesses as the full relation tests, including every private state/grant wire.
+func TestSpawnRoomFullRequestRoundTrip(t *testing.T) {
+	for _, extension := range ring.SpawnRoomExtensions() {
+		t.Run(string(extension.Type), func(t *testing.T) {
+			var assignment frontend.Circuit
+			var params any
+			switch extension.Type {
+			case ring.SpawnRoomAdvanceType:
+				assignment, params = spawnCombined(t), new(ring.SpawnRoomAdvanceParams)
+			case ring.SpawnRoomGenesisType:
+				assignment, params = spawnGenesis(t, "honest"), new(ring.SpawnRoomGenesisParams)
+			default:
+				t.Fatal("unexpected family")
+			}
+			if err := spawnRequestValues(reflect.ValueOf(params).Elem(), reflect.ValueOf(assignment).Elem()); err != nil {
+				t.Fatal(err)
+			}
+			reflect.ValueOf(params).Elem().FieldByName("CircuitType").SetString(string(extension.Type))
+			payload, err := json.Marshal(params)
+			if err != nil {
+				t.Fatal(err)
+			}
+			request := extension.Request()
+			if err := json.Unmarshal(payload, request); err != nil {
+				t.Fatal(err)
+			}
+			decoded, err := request.Assignment()
+			if err != nil {
+				t.Fatal(err)
+			}
+			var serialized [2]bytes.Buffer
+			for i, c := range []frontend.Circuit{assignment, decoded} {
+				w, err := frontend.NewWitness(c, ecc.BN254.ScalarField())
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err := w.WriteTo(&serialized[i]); err != nil {
+					t.Fatal(err)
+				}
+			}
+			if !bytes.Equal(serialized[0].Bytes(), serialized[1].Bytes()) {
+				t.Fatal("request changed a circuit wire")
+			}
+			if err := test.IsSolved(extension.Circuit(), decoded, ecc.BN254.ScalarField()); err != nil {
+				t.Fatal(err)
+			}
+			if directory := os.Getenv("SPAWN_ROOM_REQUEST_DIR"); directory != "" {
+				if err := os.MkdirAll(directory, 0700); err != nil {
+					t.Fatal(err)
+				}
+				if err := os.WriteFile(filepath.Join(directory, string(extension.Type)+".request.json"), append(payload, '\n'), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+		})
+	}
+}
+
+// Cross-language integration: consume requests emitted by the real TypeScript
+// SDK staging pipeline, including its sealed audit/policy/tracking witnesses.
+// They contain private fixture openings and must stay outside tracked source.
+func TestSpawnRoomTypeScriptRequestFixtures(t *testing.T) {
+	directory := os.Getenv("SPAWN_ROOM_TYPESCRIPT_REQUEST_DIR")
+	if directory == "" {
+		t.Skip("set SPAWN_ROOM_TYPESCRIPT_REQUEST_DIR to check actual SDK fixture requests")
+	}
+	for _, extension := range ring.SpawnRoomExtensions() {
+		t.Run(string(extension.Type), func(t *testing.T) {
+			name := "typescript-advance.request.json"
+			if extension.Type == ring.SpawnRoomGenesisType {
+				name = "typescript-genesis.request.json"
+			}
+			payload, err := os.ReadFile(filepath.Join(directory, name))
+			if err != nil {
+				t.Fatal(err)
+			}
+			request := extension.Request()
+			if err := json.Unmarshal(payload, request); err != nil {
+				t.Fatalf("strict request decode: %v", err)
+			}
+			assignment, err := request.Assignment()
+			if err != nil {
+				t.Fatalf("request assignment: %v", err)
+			}
+			if err := test.IsSolved(extension.Circuit(), assignment, ecc.BN254.ScalarField()); err != nil {
+				t.Fatalf("actual SDK request violates the complete ring+application relation: %v", err)
+			}
+		})
+	}
+}
+
+// Test-only inverse of the request's named-field assignment. It is limited to
+// the transfer/application wire types; it never parses an untrusted request.
+func spawnRequestValues(dst, src reflect.Value) error {
+	if dst.Kind() == reflect.Pointer {
+		dst.Set(reflect.New(dst.Type().Elem()))
+		return spawnRequestValues(dst.Elem(), src)
+	}
+	if src.Kind() == reflect.Interface {
+		src = src.Elem()
+	}
+	field := func() (*big.Int, error) {
+		var v fr.Element
+		if _, err := v.SetInterface(src.Interface()); err != nil {
+			return nil, err
+		}
+		return v.BigInt(new(big.Int)), nil
+	}
+	switch {
+	case dst.Type() == reflect.TypeFor[ring.Field]():
+		v, err := field()
+		if err != nil {
+			return err
+		}
+		dst.Set(reflect.ValueOf(ring.Field{Int: v}))
+	case dst.Kind() == reflect.Struct:
+		for i := range dst.NumField() {
+			f := dst.Type().Field(i)
+			if f.Name == "CircuitType" {
+				continue
+			}
+			s := src
+			if !f.Anonymous {
+				s = src.FieldByName(f.Name)
+			}
+			if !s.IsValid() {
+				return fmt.Errorf("missing circuit value %s", f.Name)
+			}
+			if err := spawnRequestValues(dst.Field(i), s); err != nil {
+				return fmt.Errorf("%s: %w", f.Name, err)
+			}
+		}
+	case dst.Kind() == reflect.Slice:
+		dst.Set(reflect.MakeSlice(dst.Type(), src.Len(), src.Len()))
+		for i := range src.Len() {
+			if err := spawnRequestValues(dst.Index(i), src.Index(i)); err != nil {
+				return err
+			}
+		}
+	case dst.Kind() == reflect.Bool:
+		v, err := field()
+		if err != nil {
+			return err
+		}
+		if v.Sign() != 0 && v.Cmp(big.NewInt(1)) != 0 {
+			return fmt.Errorf("not boolean")
+		}
+		dst.SetBool(v.Sign() != 0)
+	case dst.CanUint():
+		v, err := field()
+		if err != nil {
+			return err
+		}
+		if !v.IsUint64() || dst.OverflowUint(v.Uint64()) {
+			return fmt.Errorf("integer overflow")
+		}
+		dst.SetUint(v.Uint64())
+	default:
+		return fmt.Errorf("unsupported %s", dst.Type())
+	}
+	return nil
+}
