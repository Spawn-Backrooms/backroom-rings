+/** Changes only the outer tag and account prefix; both proof-carrying frames remain byte-exact. */
+export async function spawnRoomAdvanceInstruction(
+  proven: ProvenRingTransfer,
+  next: SpawnRoomState,
+): Promise<Instruction> {
