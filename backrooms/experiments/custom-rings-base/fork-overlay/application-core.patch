+  requireThat(!git(join(APP_ROOT, 'zolana'), 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none'), 'Application SDK Zolana submodule must remain clean');
+  const ports = normalizedPorts(config.ports);
+  const urls = Object.fromEntries(Object.entries(ports).map(([name, port]) => [name, `http://127.0.0.1:${port}`]));
+  const ringProgramId = config.programId ?? PROGRAM_ID;
+  requireThat(/^[1-9A-HJ-NP-Za-km-z]{32,44}$/.test(ringProgramId), 'Invalid app program ID');
+  const parent = resolve(config.workParent ?? join(APP_ROOT, 'target/spawn-room-runs'));
