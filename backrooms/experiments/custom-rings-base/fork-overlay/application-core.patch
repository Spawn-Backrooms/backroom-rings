+      'sdk-tests/spawn-room/localnet-journey.test.ts', '--maxWorkers=1', '--reporter=json', `--outputFile=${vitestPath}`], { timeoutMs: 3_600_000 });
+    const evidencePath = join(workDirectory, 'journey-evidence.json');
+    const evidence = await json(evidencePath);
+    validateJourneyResult(await json(vitestPath), evidence);
+    receipt.journey = { evidencePath, evidenceSha256: (await hashFile(evidencePath)).sha256, steps: evidence.steps,
+      vitestPath, vitestSha256: (await hashFile(vitestPath)).sha256 };
