diff --git a/tools/localnet-resource-monitor.mjs b/tools/localnet-resource-monitor.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..49aecba77d3819743505325c08945ebd5d4addf9
--- /dev/null
+++ b/tools/localnet-resource-monitor.mjs
@@ -0,0 +1,104 @@
+import { readFile, readdir } from 'node:fs/promises';
+
+// Only process metadata is read. No command lines, environments, request bodies,
+// or memory contents are collected. Groups are registered when this harness
+// creates them; subprocesses of those groups are part of the same measurement.
+export class LocalnetResourceMonitor {
+  constructor(intervalMs = 250) {
+    this.intervalMs = intervalMs;
+    this.startedAt = new Date().toISOString();
+    this.started = performance.now();
+    this.groups = new Map();
+    this.processes = new Map();
+    this.samples = 0;
+    this.peakConcurrentRssKiB = 0;
+    this.supported = process.platform === 'linux';
+    this.sampling = undefined;
+    this.timer = this.supported ? setInterval(() => { void this.sample(); }, intervalMs) : undefined;
+    this.timer?.unref();
+  }
+
+  registerGroup(pid, scope) {
+    if (Number.isInteger(pid) && pid > 1) this.groups.set(pid, { scope, registered: performance.now(), observed: false });
+  }
+
+  async sample() {
+    if (!this.supported) return;
+    if (this.sampling) return this.sampling;
+    this.sampling = this.collect().catch((error) => { this.lastError = error.code ?? error.message; }).finally(() => { this.sampling = undefined; });
+    return this.sampling;
+  }
+
+  async collect() {
+    const rows = new Map();
+    const names = (await readdir('/proc')).filter((name) => /^\d+$/.test(name));
+    await Promise.all(names.map(async (name) => {
+      try {
+        const value = await readFile(`/proc/${name}/stat`, 'utf8');
+        const end = value.lastIndexOf(')');
+        const fields = value.slice(end + 2).trim().split(/\s+/);
+        rows.set(Number(name), { pid: Number(name), name: value.slice(value.indexOf('(') + 1, end),
+          parent: Number(fields[1]), group: Number(fields[2]), startTicks: fields[19] });
+      } catch { /* Processes can exit between directory and stat reads. */ }
+    }));
+    const scopes = new Map([[process.pid, 'harness']]);
+    for (const row of rows.values()) {
+      const owned = this.groups.get(row.group);
+      if (owned) { owned.observed = true; scopes.set(row.pid, owned.scope); }
+    }
+    // Vitest/native workers can create a process group of their own. Include
+    // them only while their parent relationship leads back to an owned process.
+    for (let changed = true; changed;) {
+      changed = false;
+      for (const row of rows.values()) {
+        if (!scopes.has(row.pid) && scopes.has(row.parent)) {
+          scopes.set(row.pid, scopes.get(row.parent)); changed = true;
+        }
+      }
+    }
+    let rss = 0;
+    const sampledAt = new Date().toISOString();
+    await Promise.all([...scopes].map(async ([pid, scope]) => {
+      const row = rows.get(pid);
+      if (!row) return;
+      try {
+        const status = await readFile(`/proc/${pid}/status`, 'utf8');
+        const current = Number(/^VmRSS:\s+(\d+)\s+kB$/m.exec(status)?.[1] ?? 0);
+        const highWater = Number(/^VmHWM:\s+(\d+)\s+kB$/m.exec(status)?.[1] ?? 0);
+        const identity = `${pid}:${row.startTicks}`;
+        const previous = this.processes.get(identity);
+        this.processes.set(identity, { pid, startTicks: row.startTicks, name: row.name, scope,
+          firstObservedAt: previous?.firstObservedAt ?? sampledAt, lastObservedAt: sampledAt,
+          sampledPeakRssKiB: Math.max(previous?.sampledPeakRssKiB ?? 0, current),
+          observedOsHighWaterRssKiB: Math.max(previous?.observedOsHighWaterRssKiB ?? 0, highWater) });
+        rss += current;
+      } catch { /* A short-lived process may exit before its status is read. */ }
+    }));
+    for (const [group, owned] of this.groups) {
+      if (![...rows.values()].some((row) => row.group === group) && (owned.observed || performance.now() - owned.registered > 1000)) this.groups.delete(group);
+    }
+    this.samples += 1;
+    this.peakConcurrentRssKiB = Math.max(this.peakConcurrentRssKiB, rss);
+  }
+
+  async stop() {
+    clearInterval(this.timer);
+    await this.sample();
+    return {
+      scope: 'this harness, its registered service/command groups, and observed descendants; excludes unrelated Go/build lanes',
+      supported: this.supported, platform: process.platform,
+      method: 'Linux /proc VmRSS and process-lifetime VmHWM, sampled while each owned process exists',
+      sampleIntervalMs: this.intervalMs, samples: this.samples, startedAt: this.startedAt,
+      finishedAt: new Date().toISOString(), measuredDurationMs: Math.round(performance.now() - this.started),
+      sampledPeakConcurrentRssKiB: this.peakConcurrentRssKiB,
+      processes: [...this.processes.values()].sort((a, b) => a.pid - b.pid),
+      limitations: [
+        'Concurrent RSS is a sampled sum, not a kernel-reported instantaneous process-tree peak.',
+        'VmHWM is the OS high-water mark through the last observation; short-lived processes or later peaks may be missed.',
+        'Shared resident pages may be counted in more than one process. Kernel memory and filesystem cache are excluded.',
+        'These are measurements of this disposable local run, not production performance claims.',
+      ],
+      ...(this.lastError === undefined ? {} : { lastSamplingError: this.lastError }),
+    };
+  }
+}
