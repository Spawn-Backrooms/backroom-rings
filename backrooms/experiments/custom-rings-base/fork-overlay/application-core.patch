@@ -0,0 +1,144 @@
+//! Account and instruction wire formats of the dedicated room program.
+use bytemuck::{Pod, Zeroable};
+use solana_address::Address;
+use spr_hasher::primitives::is_canonical_bn254_scalar_be;
+use wincode::{SchemaRead, SchemaWrite};
+
+use crate::CustomRingError;
+
+pub const CONFIG_SEED: &[u8] = b"spawn-room-config-v1";
+pub const GENESIS_SEED: &[u8] = b"spawn-room-genesis-v1";
+pub const GENESIS_DISCRIMINATOR: [u8; 8] = *b"SPRGEN01";
+pub const INITIALIZE_CONFIG: u8 = 0x80;
+pub const UPDATE_GRANT_ROOT: u8 = 0x81;
+pub const CREATE_ROOM: u8 = 0x82;
+pub const ADVANCE_ROOM: u8 = 0x83;
+
+#[derive(Clone, Copy, SchemaRead, SchemaWrite)]
+pub struct InitializeConfig {
+    pub network: [u8; 32],
+    /// Canonical scalar designating the deployed application.
+    pub application_id: [u8; 32],
+    pub grant_root: [u8; 32],
+}
+
+#[derive(Clone, Copy, SchemaRead, SchemaWrite)]
+pub struct UpdateGrantRoot {
+    pub expected_epoch: u64,
+    pub new_root: [u8; 32],
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Pod, Zeroable)]
+#[repr(C)]
+pub struct SpawnRoomConfig {
+    discriminator: [u8; 8],
+    pub network: [u8; 32],
+    pub application_id: [u8; 32],
+    pub publisher: Address,
+    pub grant_root: [u8; 32],
+    epoch_le: [u8; 8],
+}
+
+impl SpawnRoomConfig {
+    pub fn new(ix: InitializeConfig, publisher: Address) -> Result<Self, CustomRingError> {
+        let config = Self {
+            discriminator: *b"SPRCFG01",
+            network: ix.network,
+            application_id: ix.application_id,
+            publisher,
+            grant_root: ix.grant_root,
+            epoch_le: 0u64.to_le_bytes(),
+        };
+        config.validate()?;
+        Ok(config)
+    }
+
+    pub fn validate(&self) -> Result<(), CustomRingError> {
+        if self.discriminator != *b"SPRCFG01"
+            || self.publisher == Address::default()
+            || self.application_id == [0; 32]
+            || !is_canonical_bn254_scalar_be(&self.application_id)
+            || !is_canonical_bn254_scalar_be(&self.grant_root)
+        {
+            return Err(CustomRingError::InvalidInstructionData);
+        }
+        Ok(())
+    }
+
+    pub fn epoch(&self) -> u64 {
+        u64::from_le_bytes(self.epoch_le)
+    }
+
+    /// Called after the program checks the publisher's transaction signature.
+    pub fn update(&mut self, signer: &Address, ix: UpdateGrantRoot) -> Result<(), CustomRingError> {
+        self.validate()?;
+        if signer != &self.publisher
+            || ix.expected_epoch != self.epoch()
+            || !is_canonical_bn254_scalar_be(&ix.new_root)
+        {
+            return Err(CustomRingError::InvalidInstructionData);
+        }
+        let next = self
+            .epoch()
+            .checked_add(1)
+            .ok_or(CustomRingError::InvalidInstructionData)?;
+        self.grant_root = ix.new_root;
+        self.epoch_le = next.to_le_bytes();
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn updates_require_the_pinned_publisher_and_the_current_epoch() {
+        let owner = Address::new_from_array([3; 32]);
+        let mut cfg = SpawnRoomConfig::new(
+            InitializeConfig {
+                network: [4; 32],
+                application_id: [1; 32],
+                grant_root: [2; 32],
+            },
+            owner,
+        )
+        .unwrap();
+        let start = cfg;
+        let update = UpdateGrantRoot {
+            expected_epoch: 0,
+            new_root: [5; 32],
+        };
+        assert!(cfg
+            .update(&Address::new_from_array([8; 32]), update)
+            .is_err());
+        assert!(cfg
+            .update(
+                &owner,
+                UpdateGrantRoot {
+                    new_root: [0xff; 32],
+                    ..update
+                }
+            )
+            .is_err());
+        assert_eq!(cfg, start);
+        cfg.update(&owner, update).unwrap();
+        assert_eq!(cfg.epoch(), 1);
+        assert_eq!(cfg.grant_root, [5; 32]);
+        let committed = cfg;
+        assert!(cfg.update(&owner, update).is_err());
+        assert_eq!(cfg, committed);
+        cfg.epoch_le = u64::MAX.to_le_bytes();
+        let exhausted = cfg;
+        assert!(cfg
+            .update(
+                &owner,
+                UpdateGrantRoot {
+                    expected_epoch: u64::MAX,
+                    ..update
+                }
+            )
+            .is_err());
+        assert_eq!(cfg, exhausted);
+    }
+}
