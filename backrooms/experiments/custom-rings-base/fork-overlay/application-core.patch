@@ -0,0 +1,39 @@
+// Command spawn-room-prover adds two experimental application circuits to the
+// pinned upstream prover. It does not alter the upstream command or its catalog.
+package main
+
+import (
+	"fmt"
+	"os"
+	"strings"
+
+	"github.com/helius-labs/zolana-custom-rings/prover/ring"
+	"github.com/helius-labs/zolana/prover/server/app"
+	"github.com/helius-labs/zolana/prover/server/prover/common"
+	"github.com/rs/zerolog"
+)
+
+func main() {
+	for _, extension := range ring.SpawnRoomExtensions() {
+		common.RegisterExtension(extension)
+	}
+	command := ""
+	for _, arg := range os.Args[1:] {
+		if !strings.HasPrefix(arg, "-") {
+			command = arg
+			break
+		}
+	}
+	// As in the pinned prover, witness errors never enter a serving/proving log.
+	if command == "start" || command == "prove" {
+		zerolog.SetGlobalLevel(zerolog.Disabled)
+	}
+	if err := app.Run(os.Args); err != nil {
+		if command == "prove" {
+			fmt.Fprintln(os.Stderr, "room proof failed; check the experimental key and witness")
+		} else {
+			fmt.Fprintf(os.Stderr, "room prover failed: %v\n", err)
+		}
+		os.Exit(1)
+	}
+}
diff --git a/prover/ring/spawn_room.go b/prover/ring/spawn_room.go
new file mode 100644
index 0000000000000000000000000000000000000000..ef95b39197f0b9643bc31793ab9ac6e0e081deef
--- /dev/null
+++ b/prover/ring/spawn_room.go
@@ -0,0 +1,113 @@
+package ring
+
+import (
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana/prover/server/prover/common"
+)
+
+const (
+	SpawnRoomAdvanceType common.CircuitType = "spawn-room-advance-v1"
+	SpawnRoomGenesisType common.CircuitType = "spawn-room-genesis-v1"
+)
+
+// SpawnRoomExtensions is deliberately not called by the upstream ring init.
+// Only cmd/spawn-room-prover opts into these separate experimental key families.
+// Existing ring keys, request shapes, registry and lockfile stay unchanged.
+func SpawnRoomExtensions() []common.ExtensionCircuit {
+	shape := transfer.Shape{Inputs: 24, Outputs: 2, Withdrawals: 4, Owners: 4}
+	return []common.ExtensionCircuit{
+		bindPolicy[SpawnRoomAdvanceParams](Key{Circuit: SpawnRoomAdvanceType}, transfer.NewSpawnRoomApplicationCircuit, shape),
+		bindPolicy[SpawnRoomGenesisParams](Key{Circuit: SpawnRoomGenesisType}, transfer.NewSpawnRoomGenesisCircuit, shape),
+	}
+}
+
+type SpawnRoomContextParams struct {
+	Network       []Field `json:"network"`
+	ApplicationID Field   `json:"applicationId"`
+	RingProgramID Field   `json:"ringProgramId"`
+	GrantRoot     Field   `json:"grantRoot"`
+	GrantEpoch    uint64  `json:"grantEpoch"`
+}
+
+type SpawnRoomGenesisContextParams struct {
+	Network       []Field `json:"network"`
+	ApplicationID Field   `json:"applicationId"`
+	RingProgramID Field   `json:"ringProgramId"`
+}
+
+type SpawnRoomBindingParams struct {
+	Network       []Field `json:"network"`
+	ApplicationID Field   `json:"applicationId"`
+	RingProgramID Field   `json:"ringProgramId"`
+	CreationNonce []Field `json:"creationNonce"`
+}
+
+type SpawnRoomMemoryParams struct {
+	Lesson         Bytes   `json:"lesson"`
+	Length         uint8   `json:"length"`
+	Scope          uint8   `json:"scope"`
+	Episode        []Field `json:"episode"`
+	OriginalResult []Field `json:"originalResult"`
+	Candidate      []Field `json:"candidate"`
+}
+
+type SpawnRoomPolicyParams struct {
+	ID uint64 `json:"id"`
+	// uint16 keeps encoding/json's wire an integer array, not a base64 byte string.
+	// The circuit independently bounds each element to 0..100.
+	Scores []uint16 `json:"scores"`
+}
+
+type SpawnRoomStateParams struct {
+	Binding                SpawnRoomBindingParams `json:"binding"`
+	SeedManifest           []Field                `json:"seedManifest"`
+	FixedMembers           []Field                `json:"fixedMembers"`
+	Writer                 Field                  `json:"writer"`
+	Revision               uint64                 `json:"revision"`
+	Memory                 SpawnRoomMemoryParams  `json:"memory"`
+	Policy                 SpawnRoomPolicyParams  `json:"policy"`
+	Predecessor            Field                  `json:"predecessor"`
+	Authorization          Field                  `json:"authorization"`
+	LastAuthorizationEpoch uint64                 `json:"lastAuthorizationEpoch"`
+}
+
+type SpawnRoomGrantParams struct {
+	RoomIdentity      Field                 `json:"roomIdentity"`
+	Actor             Field                 `json:"actor"`
+	Epoch             uint64                `json:"epoch"`
+	Predecessor       Field                 `json:"predecessor"`
+	Ordinal           uint64                `json:"ordinal"`
+	Memory            SpawnRoomMemoryParams `json:"memory"`
+	SelectedProcedure uint8                 `json:"selectedProcedure"`
+	Negative          uint8                 `json:"negative"`
+	Magnitude         uint8                 `json:"magnitude"`
+	Nonce             []Field               `json:"nonce"`
+}
+
+// Index is bounded by the 4-ary height13 path inside the constraint system.
+// Every row has exactly3 canonical scalar siblings; assign refuses other widths.
+type SpawnRoomGrantPathParams struct {
+	Index    uint64    `json:"index"`
+	Siblings [][]Field `json:"siblings"`
+}
+
+type SpawnRoomAdvanceWitnessParams struct {
+	Old       SpawnRoomStateParams     `json:"old"`
+	Next      SpawnRoomStateParams     `json:"next"`
+	Grant     SpawnRoomGrantParams     `json:"grant"`
+	GrantPath SpawnRoomGrantPathParams `json:"grantPath"`
+}
+
+type SpawnRoomAdvanceParams struct {
+	TransferParams
+	ApplicationStatementHash Field                         `json:"applicationStatementHash"`
+	Context                  SpawnRoomContextParams        `json:"context"`
+	Advance                  SpawnRoomAdvanceWitnessParams `json:"advance"`
+}
+
+type SpawnRoomGenesisParams struct {
+	TransferParams
+	GenesisStatementHash Field                         `json:"genesisStatementHash"`
+	Context              SpawnRoomGenesisContextParams `json:"context"`
+	State                SpawnRoomStateParams          `json:"state"`
+}
diff --git a/prover/ring/spawn_room_http_test.go b/prover/ring/spawn_room_http_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..a572d4c721fbf7d5c313c26cb800295dddf0ac2b
--- /dev/null
+++ b/prover/ring/spawn_room_http_test.go
@@ -0,0 +1,159 @@
+package ring
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/backend/groth16"
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana/prover/server/prover/common"
+)
+
+// Opt-in real HTTP proof integration. The test starts a loopback-only prover in
+// its own process namespace; no remote endpoint receives fixture witnesses.
+func TestSpawnRoomHTTPProver(t *testing.T) {
+	if os.Getenv("SPAWN_ROOM_HTTP_PROVER") != "1" {
+		t.Skip("explicit localnet proof integration")
+	}
+	artifactDir, err := filepath.Abs("../../target/spawn-room-keys")
+	if err != nil {
+		t.Fatal(err)
+	}
+	keyDir, err := filepath.Abs("../../target/spawn-prover-keys")
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary, err := filepath.Abs("../../target/spawn-room-prover")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address, metrics := spawnFreeAddress(t), spawnFreeAddress(t)
+	log, err := os.CreateTemp(t.TempDir(), "prover-*.log")
+	if err != nil {
+		t.Fatal(err)
+	}
+	cmd := exec.Command(binary, "start", "--prover-address", address, "--metrics-address", metrics, "--keys-dir", keyDir, "--preload-keys", "none", "--transfer-concurrency", "1")
+	cmd.Stdout, cmd.Stderr = log, log
+	if err := cmd.Start(); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = cmd.Process.Kill(); _ = cmd.Wait(); _ = log.Close() })
+	client := &http.Client{Timeout: 5 * time.Minute}
+	base := "http://" + address
+	ready := false
+	for i := 0; i < 100; i++ {
+		response, err := client.Get(base + "/health")
+		if err == nil {
+			ready = response.StatusCode == 200
+			_ = response.Body.Close()
+			if ready {
+				break
+			}
+		}
+		time.Sleep(50 * time.Millisecond)
+	}
+	if !ready {
+		t.Fatal("local prover did not become healthy")
+	}
+	for _, extension := range SpawnRoomExtensions() {
+		t.Run(string(extension.Type), func(t *testing.T) {
+			payload, err := os.ReadFile(filepath.Join(artifactDir, string(extension.Type)+".request.json"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			request := extension.Request()
+			if err := json.Unmarshal(payload, request); err != nil {
+				t.Fatal(err)
+			}
+			assignment, err := request.Assignment()
+			if err != nil {
+				t.Fatal(err)
+			}
+			public, err := frontend.NewWitness(assignment, ecc.BN254.ScalarField(), frontend.PublicOnly())
+			if err != nil {
+				t.Fatal(err)
+			}
+			response, err := client.Post(base+"/prove/"+strings.TrimSuffix(extension.KeyFile, ".key"), "application/json", bytes.NewReader(payload))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer response.Body.Close()
+			if response.StatusCode != http.StatusOK {
+				t.Fatalf("proof HTTP status %d", response.StatusCode)
+			}
+			var proof common.Proof
+			if err := json.NewDecoder(response.Body).Decode(&proof); err != nil {
+				t.Fatal(err)
+			}
+			keyFile, err := os.Open(filepath.Join(keyDir, extension.KeyFile))
+			if err != nil {
+				t.Fatal(err)
+			}
+			h := sha256.New()
+			if _, err := io.Copy(h, keyFile); err != nil {
+				t.Fatal(err)
+			}
+			if err := keyFile.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(h.Sum(nil), proof.ProvingKeySha256[:]) {
+				t.Fatal("proof response key digest mismatch")
+			}
+			vkFile, err := os.Open(filepath.Join(artifactDir, string(extension.Type)+".vk.bin"))
+			if err != nil {
+				t.Fatal(err)
+			}
+			vk := groth16.NewVerifyingKey(ecc.BN254)
+			if _, err := vk.ReadFrom(vkFile); err != nil {
+				t.Fatal(err)
+			}
+			if err := vkFile.Close(); err != nil {
+				t.Fatal(err)
+			}
+			if err := groth16.Verify(proof.Proof, vk, public); err != nil {
+				t.Fatalf("HTTP proof does not verify: %v", err)
+			}
+			t.Logf("verified actual HTTP proof with key %x", proof.ProvingKeySha256)
+			other := "spawn_room_genesis_v1"
+			if extension.Type == SpawnRoomGenesisType {
+				other = "spawn_room_advance_v1"
+			}
+			wrong, err := client.Post(base+"/prove/"+other, "application/json", bytes.NewReader(payload))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer wrong.Body.Close()
+			if wrong.StatusCode != http.StatusBadRequest {
+				t.Fatalf("wrong key path HTTP status %d", wrong.StatusCode)
+			}
+		})
+	}
+}
+
+func spawnFreeAddress(t testing.TB) string {
+	t.Helper()
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	address := listener.Addr().String()
+	if err := listener.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if !strings.HasPrefix(address, "127.0.0.1:") {
+		t.Fatal(fmt.Errorf("nonlocal listener %s", address))
+	}
+	return address
+}
diff --git a/prover/ring/spawn_room_test.go b/prover/ring/spawn_room_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..6226dd92c215b393c9cfea457f71b2b9805b6887
--- /dev/null
+++ b/prover/ring/spawn_room_test.go
@@ -0,0 +1,146 @@
+package ring
+
+import (
+	"bytes"
+	"encoding/json"
+	"math"
+	"math/big"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana/prover/server/prover/common"
+)
+
+func spawnRequestFixture(t testing.TB, extension common.ExtensionCircuit) []byte {
+	t.Helper()
+	c := extension.Circuit()
+	if err := assign(c, nil); err != nil {
+		t.Fatal(err)
+	}
+	switch c := c.(type) {
+	case *transfer.SpawnRoomApplicationCircuit:
+		c.PublicInputHash, c.ApplicationStatementHash = 17, 19
+		c.Context.Network = transfer.SpawnDigest{new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 128), big.NewInt(1)), 23}
+		c.Context.GrantEpoch = uint64(math.MaxUint64)
+		c.Advance.Old.Revision = uint64(math.MaxUint64)
+		return mustMarshal(t, requestOf[SpawnRoomAdvanceParams](t, extension.Type, c))
+	case *transfer.SpawnRoomGenesisCircuit:
+		c.PublicInputHash, c.GenesisStatementHash = 29, 31
+		return mustMarshal(t, requestOf[SpawnRoomGenesisParams](t, extension.Type, c))
+	default:
+		t.Fatalf("unexpected circuit %T", c)
+	}
+	return nil
+}
+
+func TestSpawnRequestsAreOptInAndKeepTwoPublicInputs(t *testing.T) {
+	for _, extension := range SpawnRoomExtensions() {
+		if _, registered := common.LookupExtension(extension.Type); registered {
+			t.Fatal("experimental key registered in upstream command")
+		}
+		if extension.KeyFile != (Key{Circuit: extension.Type}).KeyFile() {
+			t.Fatal("key filename drift")
+		}
+		request := extension.Request()
+		if err := json.Unmarshal(spawnRequestFixture(t, extension), request); err != nil {
+			t.Fatal(err)
+		}
+		assignment, err := request.Assignment()
+		if err != nil {
+			t.Fatal(err)
+		}
+		witness, err := frontend.NewWitness(assignment, ecc.BN254.ScalarField())
+		if err != nil {
+			t.Fatal(err)
+		}
+		public, err := witness.Public()
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(public.Vector().(fr.Vector)) != 2 {
+			t.Fatal("unexpected public witness shape")
+		}
+		if c, ok := assignment.(*transfer.SpawnRoomApplicationCircuit); ok {
+			if c.Context.GrantEpoch != uint64(math.MaxUint64) || c.Advance.Old.Revision != uint64(math.MaxUint64) {
+				t.Fatal("u64 precision lost")
+			}
+		}
+	}
+}
+
+func TestSpawnRequestsRefuseAmbiguousOrMisshapedWire(t *testing.T) {
+	extension := SpawnRoomExtensions()[0]
+	honest := spawnRequestFixture(t, extension)
+	for _, name := range []string{"missing application hash", "duplicate context", "unknown field", "trailing JSON", "wrong family", "short network", "short lesson", "short grant path", "short sibling row", "noncanonical field"} {
+		t.Run(name, func(t *testing.T) {
+			var body map[string]json.RawMessage
+			if err := json.Unmarshal(honest, &body); err != nil {
+				t.Fatal(err)
+			}
+			payload := honest
+			switch name {
+			case "missing application hash":
+				delete(body, "applicationStatementHash")
+			case "duplicate context":
+				payload = append(bytes.Clone(bytes.TrimSpace(honest[:len(honest)-1])), append([]byte(",\"context\":"), append(body["context"], '}')...)...)
+			case "unknown field":
+				body["uncheckedGrant"] = json.RawMessage(`true`)
+			case "trailing JSON":
+				payload = append(append([]byte{}, honest...), []byte(` {}`)...)
+			case "wrong family":
+				body["circuitType"] = json.RawMessage(`"spawn-room-genesis-v1"`)
+			case "noncanonical field":
+				body["applicationStatementHash"] = json.RawMessage(`"0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"`)
+			case "short network":
+				var context map[string]json.RawMessage
+				if err := json.Unmarshal(body["context"], &context); err != nil {
+					t.Fatal(err)
+				}
+				context["network"] = json.RawMessage(`[]`)
+				body["context"] = mustMarshal(t, context)
+			case "short lesson", "short grant path", "short sibling row":
+				var advance map[string]json.RawMessage
+				if err := json.Unmarshal(body["advance"], &advance); err != nil {
+					t.Fatal(err)
+				}
+				if name == "short lesson" {
+					var state, memory map[string]json.RawMessage
+					if err := json.Unmarshal(advance["old"], &state); err != nil {
+						t.Fatal(err)
+					}
+					if err := json.Unmarshal(state["memory"], &memory); err != nil {
+						t.Fatal(err)
+					}
+					memory["lesson"] = json.RawMessage(`"0x00"`)
+					state["memory"] = mustMarshal(t, memory)
+					advance["old"] = mustMarshal(t, state)
+				} else {
+					var path SpawnRoomGrantPathParams
+					if err := json.Unmarshal(advance["grantPath"], &path); err != nil {
+						t.Fatal(err)
+					}
+					if name == "short grant path" {
+						path.Siblings = path.Siblings[:12]
+					} else {
+						path.Siblings[0] = path.Siblings[0][:2]
+					}
+					advance["grantPath"] = mustMarshal(t, path)
+				}
+				body["advance"] = mustMarshal(t, advance)
+			}
+			if name != "duplicate context" && name != "trailing JSON" {
+				payload = mustMarshal(t, body)
+			}
+			request := extension.Request()
+			if err := json.Unmarshal(payload, request); err != nil {
+				return
+			}
+			if _, err := request.Assignment(); err == nil {
+				t.Fatal("accepted ambiguous or misshaped room witness")
+			}
+		})
+	}
+}
diff --git a/sdk-libs/ts/src/experimental/spawn-room/codec.ts b/sdk-libs/ts/src/experimental/spawn-room/codec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..150dff48e31a364429f0133d55e8092742bfbef7
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/codec.ts
@@ -0,0 +1,564 @@
+/**
+ * Experimental v1 application codec. Its bytes are private recipient data, not
+ * public instruction fields. Hashes exactly match prover/circuits/transfer/
+ * spawn_room_state.go; they do not use the earlier Backrooms v0 JSON codec.
+ */
+import type { Bytes32 } from "@heliuslabs/spr";
+import {
+  BN254_MODULUS_DEC,
+  bytesToBigInt,
+  equalBytes,
+  hashChain4,
+  isZero,
+  poseidon,
+} from "@heliuslabs/spr/internal";
+
+export const SPAWN_ROOM_STATE_BYTES = 516;
+export const SPAWN_ACCEPTANCE_GRANT_BYTES = 349;
+export const SPAWN_ROOM_LESSON_BYTES = 96;
+export const SPAWN_GRANT_TREE_HEIGHT = 13;
+const FIELD = BigInt(BN254_MODULUS_DEC);
+const U64_MAX = (1n << 64n) - 1n;
+const text = new TextEncoder();
+const ID_DOMAIN = 0x5350524944303031n;
+const STATE_DOMAIN = 0x5350525354303031n;
+const MEMORY_DOMAIN = 0x5350524d454d3031n;
+const GRANT_DOMAIN = 0x5350524752303031n;
+
+/** Raw digests retain all 256 bits. Scalar identities are separate bigint fields. */
+export interface SpawnRoomDomain {
+  readonly network: Uint8Array;
+  readonly applicationID: bigint;
+  readonly ringProgramID: bigint;
+}
+export interface SpawnRoomContext extends SpawnRoomDomain {
+  readonly grantRoot: bigint;
+  readonly grantEpoch: bigint;
+}
+export interface SpawnRoomBinding extends SpawnRoomDomain {
+  readonly creationNonce: Uint8Array;
+}
+export interface SpawnAcceptedMemory {
+  /** The used prefix only. The binary encoding supplies a checked zero suffix. */
+  readonly lesson: Uint8Array;
+  readonly scope: 0;
+  readonly episode: Uint8Array;
+  readonly originalResult: Uint8Array;
+  readonly candidate: Uint8Array;
+}
+export interface SpawnLearnedPolicy {
+  readonly id: bigint;
+  readonly scores: readonly [number, number];
+}
+export interface SpawnRoomState {
+  readonly binding: SpawnRoomBinding;
+  readonly seedManifest: Uint8Array;
+  readonly fixedMembers: Uint8Array;
+  readonly writer: bigint;
+  readonly revision: bigint;
+  readonly memory: SpawnAcceptedMemory;
+  readonly policy: SpawnLearnedPolicy;
+  readonly predecessor: bigint;
+  readonly authorization: bigint;
+  readonly lastAuthorizationEpoch: bigint;
+}
+export interface SpawnAcceptanceGrant {
+  readonly roomIdentity: bigint;
+  readonly actor: bigint;
+  readonly epoch: bigint;
+  readonly predecessor: bigint;
+  readonly ordinal: bigint;
+  readonly memory: SpawnAcceptedMemory;
+  readonly selectedProcedure: 0 | 1;
+  readonly negative: boolean;
+  readonly magnitude: number;
+  readonly nonce: Uint8Array;
+}
+export interface SpawnGrantPath {
+  readonly index: number;
+  /** Bottom-up, each row omits the child selected by that level's base-4 digit. */
+  readonly siblings: readonly (readonly [Bytes32, Bytes32, Bytes32])[];
+}
+
+function integer(value: number, maximum: number, name: string): void {
+  if (!Number.isInteger(value) || value < 0 || value > maximum)
+    throw new Error(`spawn_${name}_range`);
+}
+function u64(value: bigint): void {
+  if (typeof value !== "bigint" || value < 0n || value > U64_MAX)
+    throw new Error("spawn_u64_range");
+}
+function scalar(value: bigint): void {
+  if (typeof value !== "bigint" || value < 0n || value >= FIELD)
+    throw new Error("spawn_scalar_noncanonical");
+}
+function digest(value: Uint8Array): void {
+  if (!(value instanceof Uint8Array) || value.length !== 32) throw new Error("spawn_digest_length");
+}
+function writeInteger(target: Uint8Array, offset: number, length: number, value: bigint): void {
+  for (let i = length - 1; i >= 0; i--) {
+    target[offset + i] = Number(value & 255n);
+    value >>= 8n;
+  }
+}
+export function spawnScalarBytes(value: bigint): Bytes32 {
+  scalar(value);
+  const bytes = new Uint8Array(32);
+  writeInteger(bytes, 0, 32, value);
+  return bytes as Bytes32;
+}
+export function spawnDigestLimbs(value: Uint8Array): readonly [bigint, bigint] {
+  digest(value);
+  return [bytesToBigInt(value.subarray(0, 16)), bytesToBigInt(value.subarray(16))];
+}
+export function assertSpawnRoomDomain(domain: SpawnRoomDomain): void {
+  digest(domain.network);
+  scalar(domain.applicationID);
+  scalar(domain.ringProgramID);
+  if (domain.applicationID === 0n || domain.ringProgramID === 0n)
+    throw new Error("spawn_domain_zero");
+}
+export function assertSpawnRoomDomainMatches(
+  actual: SpawnRoomDomain,
+  expected: SpawnRoomDomain,
+): void {
+  assertSpawnRoomDomain(actual);
+  assertSpawnRoomDomain(expected);
+  if (
+    !equalBytes(actual.network, expected.network) ||
+    actual.applicationID !== expected.applicationID ||
+    actual.ringProgramID !== expected.ringProgramID
+  )
+    throw new Error("spawn_domain_mismatch");
+}
+function memoryValid(memory: SpawnAcceptedMemory, accepted = false): void {
+  if (
+    !(memory.lesson instanceof Uint8Array) ||
+    memory.lesson.length > SPAWN_ROOM_LESSON_BYTES ||
+    (accepted && memory.lesson.length === 0)
+  )
+    throw new Error("spawn_lesson_length");
+  if (memory.scope !== 0) throw new Error("spawn_memory_scope");
+  digest(memory.episode);
+  digest(memory.originalResult);
+  digest(memory.candidate);
+}
+function stateValid(state: SpawnRoomState): void {
+  assertSpawnRoomDomain(state.binding);
+  digest(state.binding.creationNonce);
+  digest(state.seedManifest);
+  digest(state.fixedMembers);
+  scalar(state.writer);
+  if (state.writer === 0n) throw new Error("spawn_writer_zero");
+  u64(state.revision);
+  u64(state.lastAuthorizationEpoch);
+  memoryValid(state.memory);
