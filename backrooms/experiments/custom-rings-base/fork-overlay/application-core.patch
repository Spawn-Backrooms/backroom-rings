+    throw new Error("spawn_instruction_frame_profile");
+  if (
+    proven.outputs.length !== 2 ||
+    output === undefined ||
+    output.isDummy() ||
+    output.amount !== 0n ||
+    output.ringProgramId !== proven.ringProgramId ||
+    (output.ringDataHash !== undefined && !isZero(output.ringDataHash)) ||
+    output.dataHash === undefined ||
