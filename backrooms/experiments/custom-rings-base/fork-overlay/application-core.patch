@@ -0,0 +1,107 @@
+package transfer_test
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/test"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest"
+	"github.com/helius-labs/zolana/prover/server/prover-test/spp/spptest"
+)
+
+func spawnApplicationHash(t testing.TB, c *transfer.SpawnRoomApplicationCircuit) *big.Int {
+	t.Helper()
+	x := c.Context
+	return spptest.MustHashChain4(t, ringtest.ToBigInts([]frontend.Variable{
+		0x53505241, x.Network[0], x.Network[1], x.ApplicationID, x.RingProgramID,
+		c.PublicInputHash, x.GrantRoot, x.GrantEpoch, 1, 10,
+	}))
+}
+
+func spawnCombined(t testing.TB) *transfer.SpawnRoomApplicationCircuit {
+	t.Helper()
+	w, app := spawnApplicationFixture(t)
+	b := w.Build(t)
+	c := &transfer.SpawnRoomApplicationCircuit{
+		SpawnRoomAdvanceCircuit: transfer.SpawnRoomAdvanceCircuit{TransferCircuit: *b.Circuit},
+		Context:                 app.Context, Advance: app.Advance,
+	}
+	c.ApplicationStatementHash = spawnApplicationHash(t, c)
+	return c
+}
+
+func TestSpawnRoomApplicationHonestAndBoundStatements(t *testing.T) {
+	for _, mutation := range []string{"honest", "changed application hash", "revoked grant root", "different network"} {
+		t.Run(mutation, func(t *testing.T) {
+			c := spawnCombined(t)
+			switch mutation {
+			case "changed application hash":
+				c.ApplicationStatementHash = new(big.Int).Add(ringtest.AsBigInt(c.ApplicationStatementHash), big.NewInt(1))
+			case "revoked grant root":
+				c.Context.GrantRoot = new(big.Int).Add(ringtest.AsBigInt(c.Context.GrantRoot), big.NewInt(1))
+				c.ApplicationStatementHash = spawnApplicationHash(t, c)
+			case "different network":
+				c.Context.Network[1] = 997
+				c.ApplicationStatementHash = spawnApplicationHash(t, c)
+			}
+			err := test.IsSolved(c, c, ecc.BN254.ScalarField())
+			if mutation == "honest" && err != nil {
+				t.Fatal(err)
+			}
+			if mutation != "honest" && err == nil {
+				t.Fatal("accepted unbound application authorization")
+			}
+		})
+	}
+}
+
+func TestSpawnRoomApplicationPublicWitnessHasOnlyTwoHashes(t *testing.T) {
+	c := spawnCombined(t)
+	witness, err := frontend.NewWitness(c, ecc.BN254.ScalarField())
+	if err != nil {
+		t.Fatal(err)
+	}
+	public, err := witness.Public()
+	if err != nil {
+		t.Fatal(err)
+	}
+	values := public.Vector().(fr.Vector)
+	if len(values) != 2 {
+		t.Fatalf("public fields=%d, want exactly two hashes", len(values))
+	}
+	for i, want := range []frontend.Variable{c.PublicInputHash, c.ApplicationStatementHash} {
+		if values[i].BigInt(new(big.Int)).Cmp(ringtest.AsBigInt(want)) != 0 {
+			t.Fatalf("wrong public input at %d", i)
+		}
+	}
+}
+
+type spawnStatementCircuit struct {
+	Hash     frontend.Variable `gnark:",public"`
+	Upstream frontend.Variable
+	Context  transfer.SpawnRoomContext
+}
+
+func (c *spawnStatementCircuit) Define(api frontend.API) error {
+	api.AssertIsEqual(c.Hash, transfer.SpawnRoomApplicationStatement(api, c.Upstream, c.Context))
+	return nil
+}
+
+func TestSpawnRoomApplicationStatementMatchesRustVector(t *testing.T) {
+	network := make([]byte, 32)
+	for i := range network {
+		network[i] = byte(0x80 + i)
+	}
+	want, _ := new(big.Int).SetString("1051ac91af8bdc159a00e1d171da46f66c77eb7053620913107b59bdbe6fff4d", 16)
+	c := &spawnStatementCircuit{Hash: want, Upstream: 23, Context: transfer.SpawnRoomContext{
+		Network:       transfer.SpawnDigest{new(big.Int).SetBytes(network[:16]), new(big.Int).SetBytes(network[16:])},
+		ApplicationID: 19, RingProgramID: 13, GrantRoot: 29, GrantEpoch: uint64(0x0102030405060708),
+	}}
+	if err := test.IsSolved(&spawnStatementCircuit{}, c, ecc.BN254.ScalarField()); err != nil {
+		t.Fatal(err)
+	}
+}
