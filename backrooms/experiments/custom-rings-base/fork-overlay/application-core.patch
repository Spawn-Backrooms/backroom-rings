+  "constraints": 594484,
+  "creationIdentity": "0x2a1ad3d82588214505c98bbb115b16cc4d47704f5f51f1c63f3ac1d6e838a938",
+  "network": "0x0000000000000000000000000000000b00000000000000000000000000000011",
+  "proof": {
+    "ar": [
+      "0x250a99b0867190223d63a20fce686d120d9eb54f7293e2ee28231b148e3baa97",
+      "0x30149aa61c574cb4ed0cfee8d49153bc8fa27cccc78c030bdf80f227d6f4c2da"
+    ],
+    "bs": [
+      [
+        "0x0cae69bdbaf3ab1159290120d891b8dbf6b3899e81ae18f15ad6d7ecb32ab1dd",
+        "0x1583ce198e8d20d961ae32c1f0b8d2cd132276908bc29c82aea461a2f92731b2"
