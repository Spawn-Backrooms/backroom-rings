+    ...base,
+    accounts: [
+      readonly(await spawnRoomConfigAddress(proven.ringProgramId)),
+      ...(base.accounts ?? []),
+    ],
+    data: Uint8Array.of(SpawnRoomInstructionTag.advance, ...base.data.subarray(1)),
+  };
+}
+export async function spawnRoomGenesisInstruction(
+  proven: ProvenRingTransfer,
