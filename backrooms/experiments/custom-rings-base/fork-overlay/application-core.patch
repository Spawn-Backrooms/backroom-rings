+import { SOL_MINT, type Bytes32 } from "@heliuslabs/spr";
+import { bytesToBigInt } from "@heliuslabs/spr/internal";
+import { ShieldedPublicKey } from "@heliuslabs/spr/keypair";
+import { AssetRegistry, Data, Utxo } from "@heliuslabs/spr/transaction";
+import { address } from "@solana/kit";
+
+import { ringIdField } from "../../src/crypto/derivation/ring-stream.js";
+import { sealOutputSlot } from "../../src/crypto/audit/ring-disclosure.js";
+import { RecordKind, UNPUBLISHED_RECORD_KEY } from "../../src/protocol/codec/audit-stream.js";
+import {
+  encodeSpawnRoomState,
+  hashSpawnRoomState,
+  spawnScalarBytes,
+  type SpawnRoomState,
+} from "../../src/experimental/spawn-room/codec.js";
+
+export function spawnPayloadFixture() {
+  const ring = address("11111111111111111111111111111112");
+  const owner = ShieldedPublicKey.fromEd25519(new Uint8Array(32).fill(5) as Bytes32);
+  const domain = {
+    network: new Uint8Array(32).fill(0xff),
+    applicationID: 19n,
+    ringProgramID: bytesToBigInt(ringIdField(ring)),
+  };
+  const empty = () => new Uint8Array(32);
+  const state: SpawnRoomState = {
+    binding: { ...domain, creationNonce: new Uint8Array(32).fill(4) },
+    seedManifest: new Uint8Array(32).fill(9),
+    fixedMembers: new Uint8Array(32).fill(10),
+    writer: bytesToBigInt(owner.ownerProofInputHash()),
+    revision: 0n,
+    memory: {
+      lesson: new Uint8Array(),
+      scope: 0,
+      episode: empty(),
+      originalResult: empty(),
+      candidate: empty(),
+    },
+    policy: { id: 1n, scores: [50, 50] },
+    predecessor: 0n,
+    authorization: 0n,
+    lastAuthorizationEpoch: 0n,
+  };
+  const treeId = 3;
+  const nullifierPublicKey = spawnScalarBytes(17n);
+  const blinding = spawnScalarBytes(11n);
+  const dataHash = hashSpawnRoomState(state);
+  const bytes = encodeSpawnRoomState(state);
+  const utxo = new Utxo({
+    owner,
+    asset: SOL_MINT,
+    amount: 0n,
+    blinding,
+    data: new Data([{ kind: "utxoData", bytes }]),
+    ringProgramId: ring,
+  });
+  const commitment = utxo.hash(nullifierPublicKey, treeId, dataHash);
+  const reader = {
+    owner: { signingPublicKey: owner, nullifierPublicKey },
+    ring,
+    treeId,
+    commitment,
+    assets: new AssetRegistry(),
+  };
+  const secret = new Uint8Array(32).fill(37) as Bytes32;
+  const record = {
+    kind: RecordKind.ring,
+    key: UNPUBLISHED_RECORD_KEY,
+    amount: 0n,
+    ownerKey: owner.confidentialViewTag(),
+    mint: SOL_MINT,
+    blinding,
+  };
+  const payload = { data: Uint8Array.of(...dataHash, ...bytes) };
+  const ciphertext = sealOutputSlot(secret, { record, payload });
+  return {
+    domain,
+    state,
+    treeId,
+    reader,
+    secret,
+    record,
+    payload,
+    ciphertext,
+    utxo,
+    commitment,
+    dataHash,
+    nullifierPublicKey,
+  };
+}
