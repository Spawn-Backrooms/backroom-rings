index 0000000000000000000000000000000000000000..fc28f41c4f2cceba4d48b94ec96a974a57552641
--- /dev/null
+++ b/tools/run-spawn-room-localnet.mjs
@@ -0,0 +1,451 @@
+#!/usr/bin/env node
+// All services and the journey are descendants of this process. In particular,
+// this also works in executors whose separate commands cannot share loopback.
+import { spawn, execFileSync } from 'node:child_process';
+import { createHash } from 'node:crypto';
+import { createReadStream, openSync, closeSync } from 'node:fs';
+import { access, chmod, mkdir, mkdtemp, readFile, readdir, realpath, stat, symlink, writeFile } from 'node:fs/promises';
+import { constants } from 'node:fs';
+import { createServer } from 'node:net';
+import { dirname, isAbsolute, join, resolve } from 'node:path';
+import { fileURLToPath, pathToFileURL } from 'node:url';
+import { setTimeout as delay } from 'node:timers/promises';
+import { LocalnetResourceMonitor } from './localnet-resource-monitor.mjs';
+
+const APP_ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const NATIVE_PIN = '02bca33729051798834ecbb4d94e968cdc0ef9b8';
+const ZOLANA_PIN = '0fe4f952182b39464d472c52c40b3febe6cbd9ec';
+const BACKROOMS_PIN = '08822c65254cd73c5f2dccbdf182ce1df2c7510a';
+const PROGRAM_ID = '2t8SPCrLAxKjhYjY1Yy1Dwx2ktRaKZ6fGf5khcY5zb5Y';
+const DEFAULT_PORTS = { rpc: 42899, photon: 42784, ringIndexer: 42786, ringRpc: 42785, prover: 45001, metrics: 51998 };
+const now = () => new Date().toISOString();
+const requireThat = (condition, message) => { if (!condition) throw new Error(message); };
+const json = async (path) => JSON.parse(await readFile(path, 'utf8'));
+const writeJson = (path, value) => writeFile(path, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 });
+const git = (cwd, ...args) => execFileSync('git', ['-C', cwd, ...args], { encoding: 'utf8' }).trim();
+
+async function hashFile(path) {
+  const hash = createHash('sha256');
+  for await (const part of createReadStream(path)) hash.update(part);
+  return { path, size: (await stat(path)).size, sha256: hash.digest('hex') };
+}
+
+async function sourceManifest(root) {
+  const files = execFileSync('git', ['-C', root, 'ls-files', '-z', '--cached', '--others', '--exclude-standard', '--', '.'], { encoding: 'utf8' })
+    .split('\0').filter(Boolean).filter((path) => !/(^|\/)(\.env[^/]*|[^/]*keypair\.json|[^/]*\.request\.json)$/.test(path));
+  const manifest = {};
+  for (const name of [...new Set(files)].sort()) {
+    try {
+      const path = join(root, name);
+      if (!(await stat(path)).isFile()) continue; // Gitlinks are pinned separately.
+      const { size, sha256 } = await hashFile(path);
+      manifest[name] = { size, sha256 };
+    } catch (error) {
+      if (error.code !== 'ENOENT') throw error;
+      manifest[name] = { deleted: true };
+    }
+  }
+  return { root, revision: git(root, 'rev-parse', 'HEAD'), sha256: createHash('sha256').update(JSON.stringify(manifest)).digest('hex'), files: manifest };
+}
+
+export function normalizedPorts(input = {}) {
+  requireThat(input && typeof input === 'object' && !Array.isArray(input), 'ports must be an object');
+  for (const name of Object.keys(input)) requireThat(name in DEFAULT_PORTS, `Unknown port: ${name}`);
+  const ports = { ...DEFAULT_PORTS, ...input };
+  const all = [...Object.values(ports), ports.rpc + 1, ports.rpc + 2];
+  requireThat(all.every((port) => Number.isInteger(port) && port >= 1024 && port <= 65535), 'Use unprivileged TCP ports in range');
+  requireThat(new Set(all).size === all.length, 'Localnet ports, including RPC auxiliary ports, must be distinct');
+  return ports;
+}
+
+export async function requireAvailablePorts(ports) {
+  // Keep every successful bind until the whole check finishes. Never kill a
+  // listener to make a requested port available.
+  const listeners = [];
+  try {
+    for (const port of ports) {
+      const server = createServer();
+      await new Promise((accept, reject) => {
+        server.once('error', reject);
+        server.listen({ host: '127.0.0.1', port, exclusive: true }, accept);
+      });
+      listeners.push(server);
+    }
+  } finally {
+    await Promise.all(listeners.map((server) => new Promise((done) => server.close(done))));
+  }
+}
+
+export async function waitForAvailablePorts(ports, timeoutMs = 15_000) {
+  const deadline = Date.now() + timeoutMs;
+  for (;;) {
+    try { await requireAvailablePorts(ports); return; }
+    catch (error) {
+      if (error.code !== 'EADDRINUSE' || Date.now() >= deadline) throw error;
+      await delay(100);
+    }
+  }
+}
+
+export function validateJourneyResult(vitest, evidence) {
+  requireThat(vitest.success === true && vitest.numPassedTests > 0 && vitest.numFailedTests === 0 &&
+    vitest.numPendingTests === 0 && vitest.numTodoTests === 0, 'Vitest must execute and pass the journey without skipped tests');
+  const assertions = vitest.testResults?.flatMap((suite) => suite.assertionResults ?? []) ?? [];
+  requireThat(assertions.length > 0 && assertions.every((test) => test.status === 'passed'), 'No complete passing journey assertions');
+  requireThat(evidence.schema === 'spawn-room-localnet-journey-v1' && evidence.status === 'passed', 'Journey did not produce a passing evidence receipt');
+  requireThat(Array.isArray(evidence.steps) && evidence.steps.length > 0 && evidence.steps.every((step) => step.status === 'passed'), 'Journey contains missing or unsuccessful steps');
+  for (const name of ['create', 'advance', 'recovery', 'reuse']) {
+    requireThat(evidence.steps.some((step) => step.name === name && step.status === 'passed'), `Journey did not verify ${name}`);
+  }
+}
+
+function childEnvironment() {
+  // Inherit the selected toolchain, not provider credentials or service config.
+  const allowed = ['PATH', 'HOME', 'LANG', 'LC_ALL', 'LD_LIBRARY_PATH', 'DYLD_LIBRARY_PATH',
+    'RUSTUP_HOME', 'CARGO_HOME', 'LIBCLANG_PATH', 'PROTOC', 'PROTOC_INCLUDE', 'PKG_CONFIG_PATH',
+    'GOPATH', 'GOCACHE', 'SSL_CERT_FILE', 'SSL_CERT_DIR'];
+  const env = Object.fromEntries(allowed.filter((key) => process.env[key] !== undefined).map((key) => [key, process.env[key]]));
+  return { ...env, GOENV: 'off', GOWORK: 'off', GOMAXPROCS: '1', GOMEMLIMIT: '3GiB', CARGO_BUILD_JOBS: '1',
+    CARGO_PROFILE_DEV_DEBUG: '0', CARGO_PROFILE_TEST_DEBUG: '0', JUST_NO_DOTENV: 'true',
+    AWS_EC2_METADATA_DISABLED: 'true', NO_PROXY: '127.0.0.1,localhost,::1', no_proxy: '127.0.0.1,localhost,::1',
+    ZOLANA_RING_SURFPOOL_FIXTURE: '1', RING_RPC_DEPLOYMENT: 'localnet' };
+}
+
+async function executable(value, fallback) {
+  const requested = value ?? fallback;
+  requireThat(typeof requested === 'string' && requested.length > 0, 'Missing executable path');
+  const candidates = requested.includes('/') ? [resolve(requested)] : (process.env.PATH ?? '').split(':').map((dir) => join(dir, requested));
+  for (const candidate of candidates) {
+    try { await access(candidate, constants.X_OK); return await realpath(candidate); } catch { /* next PATH entry */ }
+  }
+  throw new Error(`Executable unavailable: ${requested}. Build the pinned prerequisites first.`);
+}
+
+async function prepareKeys(config, nativeRepo, destination) {
+  const nativeDirectory = resolve(config.nativeKeysDirectory ?? join(nativeRepo, 'zolana/prover/server/proving-keys'));
+  const appDirectory = resolve(config.applicationKeysDirectory ?? join(APP_ROOT, 'target/spawn-room-keys'));
+  const locks = {
+    ...(await json(join(nativeRepo, 'prover/ring/proving-keys.lock'))).keys,
+    ...(await json(join(nativeRepo, 'zolana/prover/server/prover/provingkeys/proving-keys.lock'))).keys,
+  };
+  const sources = new Map();
+  for (const name of (await readdir(nativeDirectory)).filter((name) => name.endsWith('.key')).sort()) {
+    requireThat(locks[name], `Unrecognized native proving key: ${name}`);
+    sources.set(name, { source: join(nativeDirectory, name), expected: locks[name] });
+  }
+  for (const operation of ['advance', 'genesis']) {
+    const stem = `spawn-room-${operation}-v1`;
+    const proof = await json(join(APP_ROOT, 'test-vectors/proof', `${stem}.json`));
+    const name = `spawn_room_${operation}_v1.key`;
+    requireThat(/^[a-f0-9]{64}$/.test(proof.proof?.provingKeySha256 ?? ''), `Missing source key fingerprint for ${stem}`);
+    sources.set(name, { source: join(appDirectory, `${stem}.key`), expected: { sha256: proof.proof.provingKeySha256 } });
+  }
+  for (const name of ['custom_ring_apply_enrollments_1.key', 'custom_ring_apply_records_1.key',
+    'transfer_ring_2_2.key', 'transfer_eddsa_ring_1_2.key', 'transfer_eddsa_ring_2_2.key']) {
+    requireThat(sources.has(name), `Missing pinned prerequisite ${name}; fetch only the required keys before running`);
+  }
+  await mkdir(destination, { mode: 0o700 });
+  const keys = {};
+  for (const [name, { source, expected }] of sources) {
+    const artifact = await hashFile(await realpath(source));
+    requireThat(artifact.sha256 === expected.sha256 && (expected.size === undefined || artifact.size === expected.size), `Proving key integrity mismatch: ${name}`);
+    await symlink(artifact.path, join(destination, name));
+    keys[name] = artifact;
+  }
+  return keys;
+}
+
+export async function runLocalnet(config) {
+  requireThat(config?.disposableLocalnet === true, 'Set disposableLocalnet: true in the run config for this fresh local validator');
+  requireThat(process.platform !== 'win32', 'The pinned localnet tools require a Unix runtime');
+  process.umask(0o077);
+  const nativeRepo = await realpath(resolve(config.nativeRepo));
+  requireThat(git(nativeRepo, 'rev-parse', 'HEAD') === NATIVE_PIN, 'Native checkout does not match the reviewed source pin');
+  requireThat(git(join(nativeRepo, 'zolana'), 'rev-parse', 'HEAD') === ZOLANA_PIN, 'Native Zolana submodule pin mismatch');
+  requireThat(!git(nativeRepo, 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none'), 'Native checkout must remain clean');
