@@ -0,0 +1,53 @@
+package transfer
+
+import (
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana/prover/server/circuits/gadget"
+)
+
+const SpawnRoomApplicationDomain = 0x53505241 // SPRA
+
+// SpawnRoomApplicationCircuit is a distinct two-public-input circuit family.
+// It must never be registered under an upstream transfer key or a v0 room key.
+type SpawnRoomApplicationCircuit struct {
+	SpawnRoomAdvanceCircuit
+	ApplicationStatementHash frontend.Variable `gnark:",public"`
+	Context                  SpawnRoomContext
+	Advance                  SpawnRoomAdvanceWitness
+}
+
+func NewSpawnRoomApplicationCircuit(shape Shape) (*SpawnRoomApplicationCircuit, error) {
+	base, err := NewSpawnRoomAdvanceCircuit(shape)
+	if err != nil {
+		return nil, err
+	}
+	return &SpawnRoomApplicationCircuit{SpawnRoomAdvanceCircuit: *base}, nil
+}
+
+func (c *SpawnRoomApplicationCircuit) Define(api frontend.API) error {
+	if err := c.SpawnRoomAdvanceCircuit.Define(api); err != nil {
+		return err
+	}
+	// Use the exact note wires and statement already constrained by the ring.
+	// The second statement binds the authenticated live application context;
+	// there is no caller-supplied independent upstream-statement witness.
+	api.AssertIsEqual(c.Context.RingProgramID, c.RingProgramID)
+	c.Advance.Assert(api, c.Context, c.Inputs[0], c.Outputs[0].Output)
+	api.AssertIsEqual(c.ApplicationStatementHash,
+		SpawnRoomApplicationStatement(api, c.PublicInputHash, c.Context))
+	return nil
+}
+
+// SpawnRoomApplicationStatement mirrors SpawnRoomStatementV1 in the Rust
+// interface. Network bytes occupy two bounded 128-bit limbs, as constrained by
+// Advance.Assert. The closing 10 includes itself and fixes the transcript shape.
+// No room, writer or individual grant commitment is a public input.
+func SpawnRoomApplicationStatement(api frontend.API, upstream frontend.Variable, context SpawnRoomContext) frontend.Variable {
+	return gadget.HashChain4(api, []frontend.Variable{
+		SpawnRoomApplicationDomain,
+		context.Network[0], context.Network[1],
+		context.ApplicationID, context.RingProgramID,
+		upstream, context.GrantRoot, context.GrantEpoch,
+		SpawnRoomSchema, 10,
+	})
+}
diff --git a/prover/circuits/transfer/spawn_room_application_test.go b/prover/circuits/transfer/spawn_room_application_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..80d22158a8ef34cfd80e3d65567ed6e06aedce8d
--- /dev/null
