+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { expect, it } from "vitest";
+import {
+  NativeWorkerFailure,
+  runNativeWorker,
+  type JourneyConfig,
+  type NativeWorkerTrace,
+} from "./native-worker.js";
+
+it("starts an independent native process and refuses an absent persisted job instead of reporting recovery", async () => {
+  const workDirectory = await mkdtemp(join(tmpdir(), "spawn-native-worker-"));
+  try {
+    const config: JourneyConfig = {
+      rpcUrl: "http://127.0.0.1:1",
+      photonUrl: "http://127.0.0.1:1",
+      ringIndexerUrl: "http://127.0.0.1:1",
+      proverUrl: "http://127.0.0.1:1",
+      ringRpcUrl: "http://127.0.0.1:1",
+      ringOrigin: "http://localhost:3000",
+      ringProgramId: "2t8SPCrLAxKjhYjY1Yy1Dwx2ktRaKZ6fGf5khcY5zb5Y",
+      enrollmentWriter: "11111111111111111111111111111111",
+      defaultTreeAddress: "11111111111111111111111111111111",
+      upgradeAuthorityKeypairPath: join(workDirectory, "unused-upgrade.json"),
+      feePayerKeypairPath: join(workDirectory, "unused-payer.json"),
+      publisherKeypairPath: join(workDirectory, "unused-publisher.json"),
+      workDirectory,
+    };
+    const configPath = join(workDirectory, "config.json");
+    await writeFile(configPath, JSON.stringify(config), { mode: 0o600 });
+    const attempts: NativeWorkerFailure["attempt"][] = [];
+    for (let attempt = 0; attempt < 2; attempt++) {
+      try {
+        await runNativeWorker({
+          configPath,
+          config,
+          phase: "first",
+          nativeRoot: resolve(
+            process.env.SPAWN_REFERENCE_HOST_ROOT ?? "../backroom-rings/backrooms/reference-host",
+          ),
+        });
+        throw new Error("missing job was incorrectly accepted");
+      } catch (error) {
+        if (!(error instanceof NativeWorkerFailure)) throw error;
+        attempts.push(error.attempt);
+      }
+    }
+    expect(attempts[0]!.tracePath).not.toBe(attempts[1]!.tracePath);
+    expect(attempts[0]!.trace?.pid).not.toBe(attempts[1]!.trace?.pid);
+    for (const attempt of attempts) {
+      const trace = JSON.parse(await readFile(attempt.tracePath, "utf8")) as NativeWorkerTrace;
+      expect(trace.pid).not.toBe(process.pid);
+      expect(trace.coordinatorPid).toBe(process.pid);
+      expect(trace.status).toBe("failed");
+      expect(trace.recovered).toBeUndefined();
+      expect(trace.recordsClosed).toBe(true);
+      expect(trace.resources?.maxRssKiB).toBeGreaterThan(0);
+      const exit = JSON.parse(await readFile(attempt.exitPath, "utf8")) as {
+        code: number;
+        signal: string | null;
+        timedOut: boolean;
+      };
+      expect(exit).toMatchObject({ code: 1, signal: null, timedOut: false });
+    }
+  } finally {
+    await rm(workDirectory, { recursive: true, force: true });
+  }
+}, 60_000);
