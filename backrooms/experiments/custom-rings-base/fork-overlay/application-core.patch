+//! The two local-validator keys were produced by an experimental single-party setup.
+//! A plain application-profile build has no settlement keys.
+use custom_ring_interface::CustomRingError;
+use groth16_solana::groth16::Groth16Verifyingkey;
+
+#[cfg(feature = "spawn-room-v1-localnet-keys")]
+mod advance;
+#[cfg(feature = "spawn-room-v1-localnet-keys")]
+mod genesis;
+
+pub(super) fn genesis() -> Result<&'static Groth16Verifyingkey<'static>, CustomRingError> {
+    #[cfg(feature = "spawn-room-v1-localnet-keys")]
+    {
+        Ok(&genesis::VERIFYINGKEY)
+    }
+    #[cfg(not(feature = "spawn-room-v1-localnet-keys"))]
+    {
+        Err(CustomRingError::UnsupportedCircuit)
+    }
+}
+
+pub(super) fn advance() -> Result<&'static Groth16Verifyingkey<'static>, CustomRingError> {
+    #[cfg(feature = "spawn-room-v1-localnet-keys")]
+    {
+        Ok(&advance::VERIFYINGKEY)
+    }
+    #[cfg(not(feature = "spawn-room-v1-localnet-keys"))]
+    {
+        Err(CustomRingError::UnsupportedCircuit)
+    }
+}
