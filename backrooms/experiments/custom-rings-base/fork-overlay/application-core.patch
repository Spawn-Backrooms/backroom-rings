+    const client = await createCustomRingClient({
+      solanaRpcUrl: config.rpcUrl,
+      indexerUrl: config.ringIndexerUrl,
+      proverUrl: config.proverUrl,
+      tree: address(config.defaultTreeAddress),
+      proofDataSource: "prover",
+      commitment: "confirmed",
+      indexerConfig: { poll: { numRetries: 120, delayMs: 250n, maxDelayMs: 2_000n } },
+    });
+    const domain = await fetchSpawnRoomConfig(client, ringProgramId);
+    expect(domain.network).toEqual(
+      getBase58Encoder().encode(await client.solanaRpc.getGenesisHash().send()),
+    );
+    const seed = hexToBytes((await records.read("spawn-room-v1/writer-seed")).value) as Bytes32;
+    const keypair = ShieldedKeypair.fromKeypair(SigningKey.fromEd25519Bytes(seed));
+    const keys = ringWalletKeys(
+      LocalKeys.fromKeypair(keypair, client.proofService),
+      LocalRingKeys.fromKeypair(keypair),
+    );
