+    return capture ? readFile(logPath, 'utf8') : row;
+  }
+
+  async function service(name, binary, args) {
+    const logPath = join(logDirectory, `${name}.log`);
+    const fd = openSync(logPath, 'wx', 0o600);
+    const child = spawn(binary, args, { cwd: workDirectory, env, detached: true, stdio: ['ignore', fd, fd] });
+    measurement.registerGroup(child.pid, `service:${name}`);
+    closeSync(fd);
+    const row = { name, binary, args, pid: child.pid, logPath, startedAt: now(), status: 'running' };
+    child.once('error', (error) => { row.status = 'failed'; row.error = error.message; });
+    child.once('exit', (exitCode, signal) => { Object.assign(row, { exitCode, signal, exitedAt: now(), status: stopping ? 'stopped' : 'exited' }); });
+    services.push({ child, row }); receipt.services.push(row); await save();
+    return row;
+  }
+
+  async function ready(label, check, timeoutMs = 180_000) {
+    const started = Date.now();
+    while (Date.now() - started < timeoutMs) {
+      if (stoppedSignal) throw new Error(`Interrupted by ${stoppedSignal}`);
+      const failed = services.find(({ row }) => row.status !== 'running');
+      requireThat(!failed, `Owned service exited before ${label}: ${failed?.row.name}; inspect its log`);
+      try { if (await check()) return; } catch { /* readiness can lag startup */ }
+      await delay(250);
+    }
+    throw new Error(`Timed out waiting for ${label}`);
+  }
+  const rpc = async (url, method, params = []) => {
+    const response = await fetch(url, { method: 'POST', headers: { 'content-type': 'application/json' },
+      body: JSON.stringify({ jsonrpc: '2.0', id: 1, method, params }), signal: AbortSignal.timeout(5000) });
+    requireThat(response.ok, `${method}: HTTP ${response.status}`);
+    const body = await response.json(); requireThat(!body.error, `${method} returned an RPC error`); return body.result;
+  };
+  const httpOk = async (url) => (await fetch(url, { signal: AbortSignal.timeout(5000) })).ok;
+
+  try {
+    await requireAvailablePorts([...Object.values(ports), ports.rpc + 1, ports.rpc + 2]);
+    portPreflightPassed = true;
+    const requested = config.binaries ?? {};
+    binaries = {};
+    for (const [name, fallback] of Object.entries({
+      zolana: join(nativeRepo, 'zolana/target/debug/zolana'), xtask: join(nativeRepo, 'zolana/target/debug/xtask'),
+      photon: join(nativeRepo, 'target/debug/photon'), ringIndexer: join(nativeRepo, 'target/debug/ring-indexer'),
+      ringRpc: join(nativeRepo, 'target/debug/ring-rpc'), prover: join(APP_ROOT, 'target/spawn-room-prover'),
+      surfpool: 'surfpool', solana: 'solana', solanaKeygen: 'solana-keygen', npm: 'npm',
+    })) binaries[name] = await executable(requested[name], fallback);
+    const programSo = await realpath(resolve(config.programSo ?? join(APP_ROOT, 'target/deploy/custom_ring_program.so')));
+    const sppSo = await realpath(join(nativeRepo, 'zolana/target/deploy/shielded_pool_program.so'));
+    const registrySo = await realpath(join(nativeRepo, 'zolana/target/deploy/spr_user_registry.so'));
+    const storageSo = await realpath(join(nativeRepo, 'target/deploy/storage_program.so'));
+    referenceHostRoot = await realpath(resolve(config.referenceHostRoot ?? join(APP_ROOT, '../backroom-rings/backrooms/reference-host')));
+    requireThat(git(referenceHostRoot, 'rev-parse', 'HEAD') === BACKROOMS_PIN, 'Reference host checkout does not match the reviewed Backrooms pin');
+    requireThat(!git(referenceHostRoot, 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none'), 'Reference host checkout must remain clean');
+    receipt.backroomsRevision = BACKROOMS_PIN;
+    await access(join(APP_ROOT, 'node_modules/vitest/vitest.mjs'));
+    await access(join(referenceHostRoot, 'authority.ts'));
+    await access(join(referenceHostRoot, '../node_modules'));
+    receipt.sources = { before: { application: await sourceManifest(APP_ROOT), referenceHost: await sourceManifest(dirname(referenceHostRoot)) } };
+    receipt.referenceHostDependencies = {};
+    for (const name of ['package.json', 'package-lock.json']) {
+      receipt.referenceHostDependencies[name] = await hashFile(join(referenceHostRoot, '..', name));
+    }
+    receipt.serviceBindings = { default: '127.0.0.1', photon: '0.0.0.0 (fixed by pinned upstream source; use an isolated runtime)' };
+    receipt.artifacts = {};
+    for (const [name, path] of Object.entries({ appProgram: programSo, sppProgram: sppSo, userRegistryProgram: registrySo,
+      storageProgram: storageSo, ...binaries })) receipt.artifacts[name] = await hashFile(path);
+    receipt.keys = await prepareKeys(config, nativeRepo, join(workDirectory, 'proving-keys'));
+    Object.assign(env, { SURFPOOL_BIN: binaries.surfpool, ZOLANA_PHOTON_BIN: binaries.photon,
+      RING_RPC_BIN: binaries.ringRpc, SPAWN_REFERENCE_HOST_ROOT: referenceHostRoot });
+    await save();
+
+    const idsOutput = await command('program-ids', binaries.xtask, ['program-ids'], { capture: true, cwd: join(nativeRepo, 'zolana') });
+    const ids = {};
+    for (const line of idsOutput.trim().split('\n')) {
+      const match = /^([A-Z_]+)=([1-9A-HJ-NP-Za-km-z]{32,44})$/.exec(line);
+      if (match) ids[match[1]] = match[2];
+    }
+    for (const name of ['SHIELDED_POOL_PROGRAM_ID', 'USER_REGISTRY_PROGRAM_ID', 'DEFAULT_TREE_ADDRESS']) requireThat(ids[name], `xtask did not provide ${name}`);
+    const accounts = join(workDirectory, 'accounts');
+    await command('protocol-snapshot', binaries.xtask, ['generate-account-snapshots', '--deploy-dir', dirname(sppSo), '--accounts-dir', accounts], { cwd: join(nativeRepo, 'zolana') });
+    const actors = {};
+    for (const name of ['upgradeAuthority', 'feePayer', 'publisher']) {
+      const path = join(workDirectory, `${name}-keypair.json`);
+      await command(`keypair-${name}`, binaries.solanaKeygen, ['new', '--no-bip39-passphrase', '--silent', '--outfile', path]);
