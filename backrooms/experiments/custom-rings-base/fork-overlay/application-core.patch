+import { describe, expect, it } from "vitest";
+import { Data, Utxo } from "@heliuslabs/spr/transaction";
+import type { Bytes32 } from "@heliuslabs/spr";
+import { sealOutputSlot } from "../../src/crypto/audit/ring-disclosure.js";
+import { ZERO_RECORD_KEY } from "../../src/protocol/codec/audit-stream.js";
+import {
+  createSpawnRoomApplicationData,
+  openSpawnRoomOutput,
+  verifySpawnRoomNote,
+} from "../../src/experimental/spawn-room/payload.js";
+import { spawnPayloadFixture } from "./spawn-room-fixture.js";
+
+describe("experimental Spawn encrypted recipient state", () => {
+  it("uses the real encrypted output slot and reconstructs the exact note and app commitments", () => {
+    const f = spawnPayloadFixture();
+    const application = createSpawnRoomApplicationData(f.state);
+    const opened = openSpawnRoomOutput(f.reader, f.secret, f.ciphertext, f.domain);
+    expect(opened?.state).toEqual(f.state);
+    expect(opened?.commitment).toEqual(f.commitment);
+    expect(opened?.note.utxo.data.utxoData()).toEqual(application.bytes);
+    expect(opened?.note.dataHash).toEqual(application.hash);
+    expect(f.ciphertext).not.toEqual(f.payload.data);
+  });
+
+  it("rejects substituted application bytes even when the upstream note opening still matches", () => {
+    const f = spawnPayloadFixture();
+    const data = f.payload.data.slice();
+    data[32 + 136] = data[32 + 136]! ^ 1;
+    const changed = sealOutputSlot(f.secret, { record: f.record, payload: { data } });
+    expect(openSpawnRoomOutput(f.reader, f.secret, changed, f.domain)).toBeUndefined();
+    expect(
+      openSpawnRoomOutput(f.reader, new Uint8Array(32).fill(3) as Bytes32, f.ciphertext, f.domain),
+    ).toBeUndefined();
+    expect(
+      openSpawnRoomOutput(f.reader, f.secret, f.ciphertext, { ...f.domain, applicationID: 20n }),
+    ).toBeUndefined();
+  });
+
+  it("refuses wrong note profile, owner and plaintext state substitutions", () => {
+    const f = spawnPayloadFixture();
+    const opened = openSpawnRoomOutput(f.reader, f.secret, f.ciphertext, f.domain)!;
+    const amount = new Utxo({ ...f.utxo, amount: 1n });
+    expect(() =>
+      verifySpawnRoomNote(
+        { ...opened.note, utxo: amount },
+        f.treeId,
+        f.domain,
+        amount.hash(f.nullifierPublicKey, f.treeId, f.dataHash),
+      ),
+    ).toThrow();
+    const bytes = createSpawnRoomApplicationData({ ...f.state, writer: 1n }).bytes;
+    const different = new Utxo({ ...f.utxo, data: new Data([{ kind: "utxoData", bytes }]) });
+    expect(() =>
+      verifySpawnRoomNote({ ...opened.note, utxo: different }, f.treeId, f.domain, f.commitment),
+    ).toThrow();
+    const publicKeyBody = sealOutputSlot(f.secret, {
+      record: { ...f.record, key: ZERO_RECORD_KEY },
+      payload: f.payload,
+    });
+    expect(openSpawnRoomOutput(f.reader, f.secret, publicKeyBody, f.domain)).toBeUndefined();
+  });
+});
