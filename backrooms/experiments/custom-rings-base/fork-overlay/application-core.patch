+++ b/programs/custom-ring/src/instructions/spawn_room/mod.rs
@@ -0,0 +1,284 @@
+//! Dedicated application entrypoints. Only CreateRoom and AdvanceRoom can settle notes.
+mod keys;
+
+use super::{
+    instruction_runtime::{check_system_program, parse, Pda, PdaAllocation},
+    loader::UpgradeAuthorityCheck,
+    transfer::process_room_transfer,
+};
+use custom_ring_interface::{
+    key_catalog::RingCircuit,
+    spawn_room::{SpawnRoomGenesisStatementV1, SpawnRoomProof, SpawnRoomStatementV1},
+    spawn_room_profile::{self as profile, InitializeConfig, SpawnRoomConfig, UpdateGrantRoot},
+    CheckedAuthorization, CustomRingError, CustomRingProof, InitializeIxData, InstructionTag,
+    ParsedTransact, RingKind, RingMode, RingPolicy,
+};
+use pinocchio::{error::ProgramError, AccountView, Address, ProgramResult};
+use spr_account_checks::AccountIterator;
+use spr_hasher::primitives::{is_canonical_bn254_scalar_be, solana_owner_identity};
+
+pub(crate) fn dispatch(
+    program: &Address,
+    accounts: &mut [AccountView],
+    tag: u8,
+    data: &[u8],
+) -> ProgramResult {
+    match tag {
+        profile::INITIALIZE_CONFIG => initialize(program, accounts, data),
+        profile::UPDATE_GRANT_ROOT => update(program, accounts, data),
+        profile::CREATE_ROOM => create(program, accounts, data),
+        profile::ADVANCE_ROOM => {
+            let (config, settlement) = accounts
+                .split_first_mut()
+                .ok_or(ProgramError::NotEnoughAccountKeys)?;
+            let config = load_config(program, config)?;
+            process_room_transfer(program, settlement, data, Operation::Advance(config))
+        }
+        other => {
+            let tag = InstructionTag::try_from(other)?;
+            match tag {
+                InstructionTag::Initialize => {
+                    let ix: InitializeIxData = parse(data)?;
+                    if ix.kind != RingKind::AnonymousPolicy {
+                        return Err(ProgramError::InvalidInstructionData);
+                    }
+                }
+                InstructionTag::EnrollBatch
+                | InstructionTag::UpdatePolicy
+                | InstructionTag::SetPaused
+                | InstructionTag::SetCoSigner
+                | InstructionTag::ClearCoSigner
+                | InstructionTag::UpdateAuthority => {}
+                _ => return Err(ProgramError::InvalidInstructionData),
+            }
+            crate::generic_instruction(program, accounts, tag, data)
+        }
+    }
+}
+
+fn load_config(program: &Address, account: &AccountView) -> Result<SpawnRoomConfig, ProgramError> {
+    if !account.owned_by(program)
+        || (Pda {
+            program_id: program,
+            seeds: &[profile::CONFIG_SEED],
+        })
+        .canonical(account.address())
+        .is_none()
+    {
+        return Err(ProgramError::InvalidAccountData);
+    }
+    let bytes = account.try_borrow()?;
+    let config = bytemuck::try_pod_read_unaligned::<SpawnRoomConfig>(&bytes)
+        .map_err(|_| ProgramError::InvalidAccountData)?;
+    config.validate()?;
+    Ok(config)
+}
+
+fn allocate<const N: usize>(
+    pda: Pda<'_, N>,
+    payer: &AccountView,
+    account: &mut AccountView,
+    bytes: &[u8],
+) -> ProgramResult {
+    let bump = pda
+        .canonical(account.address())
+        .ok_or(ProgramError::InvalidSeeds)?;
+    if account.data_len() != 0 {
+        return Err(ProgramError::AccountAlreadyInitialized);
+    }
+    pda.allocate(PdaAllocation {
+        payer,
+        account,
+        space: bytes.len(),
+        bump,
+    })?;
+    account.try_borrow_mut()?.copy_from_slice(bytes);
+    Ok(())
+}
+
+fn initialize(program: &Address, accounts: &mut [AccountView], data: &[u8]) -> ProgramResult {
+    let ix: InitializeConfig = parse(data)?;
+    let [payer, authority, publisher, config, system, executable, program_data] = accounts else {
+        return Err(ProgramError::InvalidArgument);
+    };
+    if !payer.is_writable() || !config.is_writable() {
+        return Err(ProgramError::InvalidAccountData);
+    }
+    if !payer.is_signer() || !authority.is_signer() || !publisher.is_signer() {
+        return Err(ProgramError::MissingRequiredSignature);
+    }
+    check_system_program(system)?;
+    UpgradeAuthorityCheck {
+        program_id: program,
+        authority,
+        program: executable,
+        program_data,
+    }
+    .verify()?;
+    let state = SpawnRoomConfig::new(ix, *publisher.address())?;
+    allocate(
+        Pda {
+            program_id: program,
+            seeds: &[profile::CONFIG_SEED],
+        },
+        payer,
+        config,
+        bytemuck::bytes_of(&state),
+    )
+}
+
+fn update(program: &Address, accounts: &mut [AccountView], data: &[u8]) -> ProgramResult {
+    let ix: UpdateGrantRoot = parse(data)?;
+    let [publisher, account] = accounts else {
+        return Err(ProgramError::InvalidArgument);
+    };
+    if !publisher.is_signer() {
+        return Err(ProgramError::MissingRequiredSignature);
+    }
+    if !account.is_writable() {
+        return Err(ProgramError::InvalidAccountData);
+    }
+    let mut state = load_config(program, account)?;
+    state.update(publisher.address(), ix)?;
+    account
+        .try_borrow_mut()?
+        .copy_from_slice(bytemuck::bytes_of(&state));
+    Ok(())
+}
+
+// CREATE_ROOM = visible canonical identity || ordinary anonymous-public transfer frame.
+// Accounts: config, writer signer, permanent marker, marker-rent payer, system program,
+// then the unmodified upstream transfer account window.
+fn create(program: &Address, accounts: &mut [AccountView], data: &[u8]) -> ProgramResult {
+    let (identity, frame) = data
+        .split_first_chunk::<32>()
+        .ok_or(ProgramError::InvalidInstructionData)?;
+    if *identity == [0; 32] || !is_canonical_bn254_scalar_be(identity) {
+        return Err(ProgramError::InvalidInstructionData);
+    }
+    let mut iter = AccountIterator::new(accounts);
+    let config = load_config(program, iter.next_account("room config")?)?;
+    let writer = *iter.next_signer("initial room writer")?.address();
+    let marker = iter.next_mut("permanent creation marker")?;
+    let payer = iter.next_signer_mut("marker rent payer")?;
+    check_system_program(iter.next_account("system program")?)?;
+    let pda = Pda {
+        program_id: program,
+        seeds: &[profile::GENESIS_SEED, identity],
+    };
+    if pda.canonical(marker.address()).is_none() {
+        return Err(ProgramError::InvalidSeeds);
+    }
+    if marker.data_len() != 0 {
+        return Err(ProgramError::AccountAlreadyInitialized);
+    }
+    process_room_transfer(
+        program,
+        iter.remaining_unchecked_mut()?,
+        frame,
+        Operation::Genesis {
+            config,
+            identity: *identity,
+            writer,
+        },
+    )?;
+    // A failure to create the marker rolls back the preceding SPP call in this instruction.
+    allocate(pda, payer, marker, &profile::GENESIS_DISCRIMINATOR)
+}
+
+pub(super) enum Operation {
+    Advance(SpawnRoomConfig),
+    Genesis {
+        config: SpawnRoomConfig,
+        identity: [u8; 32],
+        writer: Address,
+    },
+}
+
+impl Operation {
+    pub(super) fn check_frame(
+        &self,
+        tx: &ParsedTransact<'_>,
+        spp: &[AccountView],
+        ring: &RingPolicy,
+    ) -> ProgramResult {
+        let f = tx.data();
+        if ring.mode()? != RingMode::Anonymous
+            || ring.policy_hash == [0; 32]
+            || f.policy.is_none()
+            || f.entry
+            || f.vouched
+            || !f.interface_transfers.is_empty()
+            || f.outputs.iter().any(|output| output.is_exit())
+            || f.extensions.data_hash.is_some()
+            || f.extensions.ring_data_hash.is_some()
+            || !f.extensions.messages.is_empty()
+            || f.extensions.cache.is_some()
+            || f.transfer_circuit(0)?
+                != (RingCircuit::Transfer {
+                    outputs: 2,
+                    inputs: 24,
+                    withdrawals: 4,
+                    owners: 4,
+                    entry: false,
+                    wide: false,
+                })
+        {
+            return Err(ProgramError::InvalidInstructionData);
+        }
+        // No settlement legs or cache accounts are present. Check the actual SPP
+        // owner window, including its raw length. The upstream statement hashed
+        // these same signer addresses through solana_owner_identity.
+        let owners = f.owner_signers(spp, 0)?;
+        match (self, tx.authorization(), owners) {
+            (Self::Advance(_), CheckedAuthorization::AnonymousHidden(proof), [])
+                if !f.no_spend && proof.default_owner_tag.is_none() =>
+            {
+                Ok(())
+            }
+            (Self::Genesis { writer, .. }, CheckedAuthorization::AnonymousPublic, [owner])
+                if f.no_spend && owner.address() == writer =>
+            {
+                Ok(())
+            }
+            _ => Err(ProgramError::InvalidInstructionData),
+        }
+    }
+
+    pub(super) fn verify(
+        &self,
+        ring_program_id: [u8; 32],
+        upstream_statement: [u8; 32],
+        proof: &CustomRingProof,
+    ) -> ProgramResult {
+        match self {
+            Self::Advance(cfg) => SpawnRoomProof {
+                statement: &SpawnRoomStatementV1 {
+                    network: cfg.network,
+                    application_id: cfg.application_id,
+                    ring_program_id,
+                    upstream_statement,
+                    grant_root: cfg.grant_root,
+                    grant_epoch: cfg.epoch(),
+                },
+                proof,
+                key: keys::advance()?,
+            }
+            .verify(),
+            Self::Genesis {
+                config,
+                identity,
+                writer,
+            } => SpawnRoomGenesisStatementV1 {
+                network: config.network,
+                application_id: config.application_id,
+                ring_program_id,
+                upstream_statement,
+                creation_identity: *identity,
+                writer_owner_hash: solana_owner_identity(writer.as_array())
+                    .map_err(CustomRingError::from)?,
+            }
+            .verify(proof, keys::genesis()?),
+        }
+    }
+}
