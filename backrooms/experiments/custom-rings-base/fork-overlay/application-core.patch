+    expect(retainedWallet).toBeDefined();
+    const wallet = AnonymousWallet.fromJson(retainedWallet.value);
+    const observedSignature: Signature = signature(job.observed.signature);
+    let savedWireTransaction: string | undefined;
+    let receiptAbsentOnEntry = false;
+    if (job.resumeInterruptedCommit) {
+      const submission = (await records.read("spawn-room-v1/submission/first"))?.value;
+      expect(submission?.operationId).toBe(job.previousOperationId);
+      expect(submission?.signature).toBe(job.observed.signature);
+      expect(
+        getSignatureFromTransaction(
+          getTransactionDecoder().decode(getBase64Encoder().encode(submission.wireTransaction)),
+        ),
+      ).toBe(observedSignature);
+      savedWireTransaction = submission.wireTransaction as string;
+      receiptAbsentOnEntry =
+        (await records.read(`receipt/${job.previousOperationId}`)) === undefined;
+    }
+    const observedSlot = await poll(async () => {
+      const observed = (
+        await client.solanaRpc
