diff --git a/sdk-libs/ts/src/experimental/spawn-room/native-adapter.ts b/sdk-libs/ts/src/experimental/spawn-room/native-adapter.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2e24afad8ab2dac8e47e999aec09cc13693420ab
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/native-adapter.ts
@@ -0,0 +1,492 @@
+/**
+ * Adapts the existing native EpisodeAuthority and PrivateRecordStore contracts.
+ * This module neither decides which original is acceptable nor publishes a root.
+ * Persisted grants remain pending until the configured publisher admits their
+ * exact leaf into the live epoch's authenticated root.
+ */
+import { bytesToBigInt, equalBytes } from "@heliuslabs/spr/internal";
+import { bytesToHex, hexToBytes } from "@noble/hashes/utils.js";
+import {
+  assertSpawnRoomDomainMatches,
+  decodeSpawnAcceptanceGrant,
+  decodeSpawnRoomState,
+  deriveSpawnRoomAdvance,
+  encodeSpawnAcceptanceGrant,
+  encodeSpawnRoomState,
+  hashSpawnAcceptanceGrant,
+  spawnLessonBytes,
+  spawnRoomIdentity,
+  spawnScalarBytes,
+  type SpawnAcceptanceGrant,
+  type SpawnRoomDomain,
+  type SpawnRoomState,
+} from "./codec.js";
+import { verifySpawnRoomNote, type OpenedSpawnRoom } from "./payload.js";
+
+// Structural copies of backrooms/client/contracts.ts, allowing the existing
+// native implementation to be supplied without making it an SDK dependency.
+export interface NativeCheckpoint {
+  roomId: string;
+  uniqueAddress: string;
+  stateCommitment: string;
+  revision: string;
+}
+export interface NativeEpisodeBinding {
+  roomId: string;
+  episodeId: string;
+  episodeCommitment: string;
+  predecessor: NativeCheckpoint;
+  ordinal: string;
+  minimumConfirmedSlot: string;
+  residentIds: readonly [string, string];
+}
+export interface NativeProposal {
+  lesson: string;
+  selectedProcedure: 0 | 1;
+  feedback: { negative: boolean; magnitude: number };
+}
+export interface NativeOriginalResult {
+  episodeId: string;
+  originalResultCommitment: string;
+  candidateCommitment: string;
+  investigator: string;
+  critic: string;
+  proposal: NativeProposal;
+}
+export interface NativeAcceptanceAuthorization extends NativeProposal {
+  acceptanceNonce: string;
+  episodeId: string;
+  operationId: string;
+  roomId: string;
+  expectedPredecessor: string;
+  ordinal: string;
+  episodeCommitment: string;
+  originalResultCommitment: string;
+  candidateCommitment: string;
+  minimumConfirmedSlot: string;
+}
+export interface NativeEpisodeAuthority {
+  resolveEpisode(binding: NativeEpisodeBinding): Promise<NativeEpisodeBinding>;
+  getOriginalResult(episodeId: string): Promise<NativeOriginalResult | undefined>;
+  captureOriginalResult(
+    binding: NativeEpisodeBinding,
+    result: NativeOriginalResult,
+  ): Promise<NativeOriginalResult>;
+  authorizeAcceptance(
+    binding: NativeEpisodeBinding,
+    result: NativeOriginalResult,
+  ): Promise<NativeAcceptanceAuthorization>;
+}
+export interface NativePrivateRecordStore {
+  read<T>(key: string): Promise<{ value: T; version: number } | undefined>;
+  create<T>(key: string, value: T): Promise<boolean>;
+  replace<T>(key: string, expectedVersion: number, value: T): Promise<boolean>;
+}
+/** Values produced by the existing seeded resident runtime, including its key-bound membership digest. */
+export interface NativeResidentBinding {
+  readonly seedCommitment: string;
+  readonly membershipCommitment: string;
+  readonly residentIds: readonly [string, string];
+}
+export interface RetainedSpawnAcceptance {
+  readonly binding: NativeEpisodeBinding;
+  /** The complete native JSON object is retained, including provider/CID extensions. */
+  readonly original: NativeOriginalResult;
+  readonly authorization: NativeAcceptanceAuthorization;
+  readonly oldState: SpawnRoomState;
+  readonly nextState: SpawnRoomState;
+  readonly predecessor: bigint;
+  readonly grant: SpawnAcceptanceGrant;
+  readonly grantLeaf: Uint8Array;
+}
+interface StoredAcceptance {
+  schema: "spawn-room-acceptance-v1";
+  binding: NativeEpisodeBinding;
+  original: NativeOriginalResult;
+  authorization: NativeAcceptanceAuthorization;
+  oldState: string;
+  nextState: string;
+  predecessor: string;
+  grant: string;
+  grantLeaf: string;
+}
+export interface SpawnConfirmedObservation {
+  /** Must come from the caller's completed upstream recovery snapshot. */
+  recoveryStatus: "Complete";
+  slot: bigint;
+  contextSlot: bigint;
+  signature: string;
+}
+
+/** The existing native runtime's view contract; artifactVersion names the new chain format. */
+export interface SpawnNativeRoomView {
+  protocolVersion: "backrooms.v0";
+  operationId: string;
+  status: "recovered";
+  checkpoint: NativeCheckpoint;
+  memory: {
+    lesson: string;
+    episodeCommitment: string;
+    originalResultCommitment: string;
+    candidateCommitment: string;
+    predecessorCommitment: string;
+    authorizationCommitment: string;
+  };
+  policy: { policyId: "1"; scores: [number, number] };
+  slot: string;
+  contextSlot: string;
+  signature: string;
+  seedManifestCommitment: string;
+  fixedMembersCommitment: string;
+  writerIdentity: string;
+  artifactVersion: string;
+}
+
+/** Translate a verified private note for the unmodified native resident runner. */
+export function spawnRoomNativeView(input: {
+  room: OpenedSpawnRoom;
+  uniqueAddress: string;
+  operationId: string;
+  observed: SpawnConfirmedObservation;
+}): SpawnNativeRoomView {
+  const room = verifySpawnRoomNote(
+    input.room.note,
+    input.room.treeId,
+    input.room.state.binding,
+    input.room.commitment,
+  );
+  const state = room.state;
+  digest(input.uniqueAddress);
+  decimal(input.observed.slot.toString());
+  decimal(input.observed.contextSlot.toString());
+  if (
+    input.observed.recoveryStatus !== "Complete" ||
+    input.observed.contextSlot < input.observed.slot ||
+    input.observed.signature.length === 0
+  )
+    throw new Error("spawn_native_incomplete_recovery");
+  return {
+    protocolVersion: "backrooms.v0",
+    operationId: input.operationId,
+    status: "recovered",
+    checkpoint: {
+      roomId: bytesToHex(spawnRoomIdentity(state)),
+      uniqueAddress: input.uniqueAddress,
+      stateCommitment: bytesToHex(room.commitment),
+      revision: state.revision.toString(),
+    },
+    memory: {
+      lesson: new TextDecoder("utf-8", { fatal: true, ignoreBOM: true }).decode(
+        state.memory.lesson,
+      ),
+      episodeCommitment: bytesToHex(state.memory.episode),
+      originalResultCommitment: bytesToHex(state.memory.originalResult),
+      candidateCommitment: bytesToHex(state.memory.candidate),
+      predecessorCommitment: bytesToHex(spawnScalarBytes(state.predecessor)),
+      authorizationCommitment: bytesToHex(spawnScalarBytes(state.authorization)),
+    },
+    policy: { policyId: "1", scores: [...state.policy.scores] },
+    slot: input.observed.slot.toString(),
+    contextSlot: input.observed.contextSlot.toString(),
+    signature: input.observed.signature,
+    seedManifestCommitment: bytesToHex(state.seedManifest),
+    fixedMembersCommitment: bytesToHex(state.fixedMembers),
+    writerIdentity: bytesToHex(spawnScalarBytes(state.writer)),
+    artifactVersion: "spawn-room.v1",
+  };
+}
+
+function canonical(value: unknown): string {
+  if (value === null || typeof value === "string" || typeof value === "boolean")
+    return JSON.stringify(value);
+  if (typeof value === "number" && Number.isSafeInteger(value)) return String(value);
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  if (typeof value !== "object" || Object.getPrototypeOf(value) !== Object.prototype)
+    throw new Error("spawn_native_noncanonical_json");
+  const object = value as Record<string, unknown>;
+  return `{${Object.keys(object)
+    .sort()
+    .map((key) => `${JSON.stringify(key)}:${canonical(object[key])}`)
+    .join(",")}}`;
+}
+function same(left: unknown, right: unknown, error: string): void {
+  if (canonical(left) !== canonical(right)) throw new Error(error);
+}
+function snapshot<T>(value: T): T {
+  return JSON.parse(canonical(value)) as T;
+}
+function digest(value: string): Uint8Array {
+  if (typeof value !== "string" || !/^[0-9a-f]{64}$/u.test(value))
+    throw new Error("spawn_native_digest");
+  return hexToBytes(value);
+}
+function decimal(value: string): bigint {
+  if (
+    typeof value !== "string" ||
+    !/^(0|[1-9][0-9]{0,19})$/u.test(value) ||
+    BigInt(value) > (1n << 64n) - 1n
+  )
+    throw new Error("spawn_native_u64");
+  return BigInt(value);
+}
+function operationKey(operationId: string): string {
+  if (!/^[A-Za-z0-9._:/-]{1,200}$/u.test(operationId)) throw new Error("spawn_native_operation_id");
+  return `spawn-room-v1/acceptance/${operationId}`;
+}
+function checkBinding(
+  binding: NativeEpisodeBinding,
+  old: SpawnRoomState,
+  predecessor: bigint,
+): void {
+  const roomId = bytesToHex(spawnRoomIdentity(old));
+  if (
+    binding.roomId !== roomId ||
+    binding.predecessor.roomId !== roomId ||
+    binding.predecessor.stateCommitment !== bytesToHex(spawnScalarBytes(predecessor)) ||
+    decimal(binding.predecessor.revision) !== old.revision ||
+    decimal(binding.ordinal) !== old.revision + 1n
+  )
+    throw new Error("spawn_native_checkpoint_mismatch");
+  digest(binding.episodeCommitment);
+  digest(binding.predecessor.uniqueAddress);
+  decimal(binding.minimumConfirmedSlot);
+  if (binding.residentIds.length !== 2 || new Set(binding.residentIds).size !== 2)
+    throw new Error("spawn_native_residents");
+}
+function nativeGrant(
+  binding: NativeEpisodeBinding,
+  original: NativeOriginalResult,
+  authorization: NativeAcceptanceAuthorization,
+  old: SpawnRoomState,
+  predecessor: bigint,
+  epoch: bigint,
+): SpawnAcceptanceGrant {
+  checkBinding(binding, old, predecessor);
+  if (
+    original.episodeId !== binding.episodeId ||
+    authorization.episodeId !== binding.episodeId ||
+    authorization.roomId !== binding.roomId ||
+    authorization.expectedPredecessor !== binding.predecessor.stateCommitment ||
+    authorization.ordinal !== binding.ordinal ||
+    authorization.episodeCommitment !== binding.episodeCommitment ||
+    authorization.originalResultCommitment !== original.originalResultCommitment ||
+    authorization.candidateCommitment !== original.candidateCommitment ||
+    authorization.minimumConfirmedSlot !== binding.minimumConfirmedSlot
+  )
+    throw new Error("spawn_native_authorization_mismatch");
+  same(
+    {
+      lesson: authorization.lesson,
+      selectedProcedure: authorization.selectedProcedure,
+      feedback: authorization.feedback,
+    },
+    original.proposal,
+    "spawn_native_proposal_mismatch",
+  );
+  operationKey(authorization.operationId);
+  const grant: SpawnAcceptanceGrant = {
+    roomIdentity: bytesToBigInt(spawnRoomIdentity(old)),
+    actor: old.writer,
+    epoch,
+    predecessor,
+    ordinal: decimal(binding.ordinal),
+    memory: {
+      lesson: spawnLessonBytes(authorization.lesson),
+      scope: 0,
+      episode: digest(binding.episodeCommitment),
+      originalResult: digest(original.originalResultCommitment),
+      candidate: digest(original.candidateCommitment),
+    },
+    selectedProcedure: authorization.selectedProcedure,
+    negative: authorization.feedback.negative,
+    magnitude: authorization.feedback.magnitude,
+    nonce: digest(authorization.acceptanceNonce),
+  };
+  // Validates all byte, scalar and feedback bounds before retaining anything.
+  encodeSpawnAcceptanceGrant(grant);
+  return grant;
+}
+
+/** Supply the native host's authenticated encrypted store, not a plaintext cache. */
+export class SpawnRoomNativeAdapter {
+  readonly #domain: SpawnRoomDomain;
+  readonly #residents: NativeResidentBinding;
+  constructor(
+    readonly authority: NativeEpisodeAuthority,
+    readonly records: NativePrivateRecordStore,
+    domain: SpawnRoomDomain,
+    residents: NativeResidentBinding,
+  ) {
+    this.#domain = { ...domain, network: domain.network.slice() };
+    digest(residents.seedCommitment);
+    digest(residents.membershipCommitment);
+    if (residents.residentIds.length !== 2 || new Set(residents.residentIds).size !== 2)
+      throw new Error("spawn_native_residents");
+    this.#residents = snapshot({
+      seedCommitment: residents.seedCommitment,
+      membershipCommitment: residents.membershipCommitment,
+      residentIds: [...residents.residentIds] as [string, string],
+    });
+  }
+
+  #bindResidents(state: SpawnRoomState, binding: NativeEpisodeBinding): void {
+    if (
+      bytesToHex(state.seedManifest) !== this.#residents.seedCommitment ||
+      bytesToHex(state.fixedMembers) !== this.#residents.membershipCommitment
+    )
+      throw new Error("spawn_native_resident_manifest_mismatch");
+    same(binding.residentIds, this.#residents.residentIds, "spawn_native_resident_order_mismatch");
+  }
+
+  async prepare(input: {
+    binding: NativeEpisodeBinding;
+    room: OpenedSpawnRoom;
+    grantEpoch: bigint;
+  }): Promise<RetainedSpawnAcceptance> {
+    const room = verifySpawnRoomNote(
+      input.room.note,
+      input.room.treeId,
+      this.#domain,
+      input.room.commitment,
+    );
+    const predecessor = bytesToBigInt(room.commitment);
+    const requested = snapshot(input.binding);
+    checkBinding(requested, room.state, predecessor);
+    this.#bindResidents(room.state, requested);
+    const binding = await this.authority.resolveEpisode(requested);
+    same(binding, requested, "spawn_native_episode_changed");
+    const original = await this.authority.getOriginalResult(binding.episodeId);
+    if (original === undefined) throw new Error("spawn_native_original_not_captured");
+    const authorization = await this.authority.authorizeAcceptance(binding, original);
+    const grant = nativeGrant(
+      binding,
+      original,
+      authorization,
+      room.state,
+      predecessor,
+      input.grantEpoch,
+    );
+    const context = { ...this.#domain, grantEpoch: input.grantEpoch, grantRoot: 0n };
+    const nextState = deriveSpawnRoomAdvance(context, room.state, predecessor, grant);
+    const stored: StoredAcceptance = {
+      schema: "spawn-room-acceptance-v1",
+      binding: snapshot(binding),
+      original: snapshot(original),
+      authorization: snapshot(authorization),
+      oldState: bytesToHex(encodeSpawnRoomState(room.state)),
+      nextState: bytesToHex(encodeSpawnRoomState(nextState)),
+      predecessor: bytesToHex(room.commitment),
+      grant: bytesToHex(encodeSpawnAcceptanceGrant(grant)),
+      grantLeaf: bytesToHex(hashSpawnAcceptanceGrant(this.#domain, grant)),
+    };
+    const key = operationKey(authorization.operationId);
+    await this.records.create(key, stored);
+    const retained = await this.records.read<StoredAcceptance>(key);
+    if (retained === undefined) throw new Error("spawn_native_acceptance_missing");
+    // A retry at a later epoch must not silently resurrect a revoked leaf.
+    same(retained.value, stored, "spawn_native_acceptance_changed_requires_readmission");
+    return this.#open(retained.value);
+  }
+
+  async read(operationId: string): Promise<RetainedSpawnAcceptance | undefined> {
+    const retained = await this.records.read<StoredAcceptance>(operationKey(operationId));
+    if (retained === undefined) return undefined;
+    if (retained.value.authorization.operationId !== operationId)
+      throw new Error("spawn_native_operation_mismatch");
+    return this.#open(retained.value);
+  }
+
+  #open(stored: StoredAcceptance): RetainedSpawnAcceptance {
+    if (stored.schema !== "spawn-room-acceptance-v1") throw new Error("spawn_native_record_schema");
+    const oldState = decodeSpawnRoomState(hexToBytes(stored.oldState));
+    const nextState = decodeSpawnRoomState(hexToBytes(stored.nextState));
+    assertSpawnRoomDomainMatches(oldState.binding, this.#domain);
+    this.#bindResidents(oldState, stored.binding);
+    const predecessor = bytesToBigInt(digest(stored.predecessor));
+    const grant = decodeSpawnAcceptanceGrant(hexToBytes(stored.grant));
+    const expectedGrant = nativeGrant(
+      stored.binding,
+      stored.original,
+      stored.authorization,
+      oldState,
+      predecessor,
+      grant.epoch,
+    );
+    if (!equalBytes(encodeSpawnAcceptanceGrant(grant), encodeSpawnAcceptanceGrant(expectedGrant)))
+      throw new Error("spawn_native_grant_mismatch");
+    const expected = deriveSpawnRoomAdvance(
+      { ...this.#domain, grantEpoch: grant.epoch, grantRoot: 0n },
+      oldState,
+      predecessor,
+      grant,
+    );
+    if (!equalBytes(encodeSpawnRoomState(expected), encodeSpawnRoomState(nextState)))
+      throw new Error("spawn_native_next_state_mismatch");
+    const grantLeaf = hashSpawnAcceptanceGrant(this.#domain, grant);
+    if (bytesToHex(grantLeaf) !== stored.grantLeaf)
+      throw new Error("spawn_native_grant_leaf_mismatch");
+    return {
+      binding: snapshot(stored.binding),
+      original: snapshot(stored.original),
+      authorization: snapshot(stored.authorization),
+      oldState,
+      nextState,
+      predecessor,
+      grant,
+      grantLeaf,
+    };
+  }
+
+  /**
+   * Only call after the chain observer has confirmed the supplied commitment and
+   * completed its frozen recovery coverage. The existing native authority reads
+   * this receipt before reserving the next episode; it keeps the same nonce and
+   * exact checkpoint comparison used by the reference host.
+   */
+  async retainConfirmed(
+    operationId: string,
+    opened: OpenedSpawnRoom,
+    observed: SpawnConfirmedObservation,
+  ): Promise<NativeCheckpoint> {
+    const retained = await this.read(operationId);
+    if (retained === undefined) throw new Error("spawn_native_acceptance_missing");
+    const room = verifySpawnRoomNote(opened.note, opened.treeId, this.#domain, opened.commitment);
+    if (!equalBytes(encodeSpawnRoomState(room.state), encodeSpawnRoomState(retained.nextState)))
+      throw new Error("spawn_native_recovered_state_mismatch");
+    if (
+      observed.recoveryStatus !== "Complete" ||
+      observed.slot < decimal(retained.binding.minimumConfirmedSlot) ||
+      observed.contextSlot < observed.slot ||
+      observed.signature.length === 0
+    )
+      throw new Error("spawn_native_incomplete_recovery");
+    decimal(observed.slot.toString());
+    decimal(observed.contextSlot.toString());
+    const checkpoint: NativeCheckpoint = {
+      roomId: retained.binding.roomId,
+      uniqueAddress: retained.binding.predecessor.uniqueAddress,
+      stateCommitment: bytesToHex(room.commitment),
+      revision: room.state.revision.toString(),
+    };
+    const receipt = {
+      authorization: retained.authorization,
+      room: spawnRoomNativeView({
+        room,
+        uniqueAddress: checkpoint.uniqueAddress,
+        operationId,
+        observed,
+      }),
+    };
+    const key = `receipt/${operationId}`;
+    await this.records.create(key, receipt);
+    const prior = await this.records.read<typeof receipt>(key);
+    if (prior === undefined) throw new Error("spawn_native_receipt_missing");
+    // A later recovery may observe a later contextSlot; the confirmed transaction
+    // and state must remain exactly the same.
+    same(prior.value.authorization, receipt.authorization, "spawn_native_receipt_authorization");
+    const { contextSlot: _oldContext, ...oldReceipt } = prior.value.room;
+    const { contextSlot: _newContext, ...newReceipt } = receipt.room;
+    same(oldReceipt, newReceipt, "spawn_native_receipt_conflict");
+    return checkpoint;
+  }
+}
diff --git a/sdk-libs/ts/src/experimental/spawn-room/payload.ts b/sdk-libs/ts/src/experimental/spawn-room/payload.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3a5a32dfc67245704db48ada23b58d35a1d0c3f5
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/payload.ts
@@ -0,0 +1,101 @@
+/** Application validation after the existing anonymous recipient cipher opens. */
+import type { Bytes32 } from "@heliuslabs/spr";
+import {
+  bytesToBigInt,
+  equalBytes,
+  isCanonicalField,
+  isZero,
+  ZERO_NULLIFIER_PK,
+} from "@heliuslabs/spr/internal";
+import type { TreeId } from "@heliuslabs/spr/transaction";
+import type { ApplicationData } from "../../operations/payments/anonymous.js";
+import { openOutputSlot } from "../../crypto/audit/ring-disclosure.js";
+import {
+  openRecipientNote,
+  type OpenedRingNote,
+  type RingOutputReader,
+} from "../../crypto/derivation/blinding.js";
+import { ringIdField } from "../../crypto/derivation/ring-stream.js";
+import {
+  assertSpawnRoomDomainMatches,
+  decodeSpawnRoomState,
+  encodeSpawnRoomState,
+  hashSpawnRoomState,
+  type SpawnRoomDomain,
+  type SpawnRoomState,
+} from "./codec.js";
+
+export interface OpenedSpawnRoom {
+  readonly state: SpawnRoomState;
+  readonly stateHash: Bytes32;
+  readonly note: OpenedRingNote;
+  readonly treeId: TreeId;
+  readonly commitment: Bytes32;
+}
+
+/** Pass directly as AnonymousPayment.data.application; the SDK seals it for the recipient. */
+export function createSpawnRoomApplicationData(state: SpawnRoomState): ApplicationData {
+  const bytes = encodeSpawnRoomState(state);
+  return Object.freeze({ hash: hashSpawnRoomState(decodeSpawnRoomState(bytes)), bytes });
+}
+
+/**
+ * A successful opening proves these bytes match this note commitment. It does
+ * not establish chain inclusion, finality, or unspent status: retain the SDK's
+ * frozen recovery coverage and nullifier checks before selecting the note.
+ */
+export function verifySpawnRoomNote(
+  note: OpenedRingNote,
+  treeId: TreeId,
+  domain: SpawnRoomDomain,
+  publishedCommitment: Bytes32,
+): OpenedSpawnRoom {
+  if (!isCanonicalField(publishedCommitment) || !equalBytes(note.utxoHash, publishedCommitment))
+    throw new Error("spawn_note_commitment");
+  if (
+    note.utxo.amount !== 0n ||
+    note.utxo.ringProgramId === undefined ||
+    (note.ringDataHash !== undefined && !isZero(note.ringDataHash))
+  )
+    throw new Error("spawn_note_profile");
+  if (
+    !isCanonicalField(note.nullifierPublicKey) ||
+    isZero(note.nullifierPublicKey) ||
+    equalBytes(note.nullifierPublicKey, ZERO_NULLIFIER_PK)
+  )
+    throw new Error("spawn_note_nullifier_key");
+  if (note.dataHash === undefined || !isCanonicalField(note.dataHash) || isZero(note.dataHash))
+    throw new Error("spawn_state_hash_missing");
+  const bytes = note.utxo.data.utxoData();
+  if (bytes === undefined) throw new Error("spawn_state_bytes_missing");
+  const state = decodeSpawnRoomState(bytes);
+  assertSpawnRoomDomainMatches(state.binding, domain);
+  if (
+    bytesToBigInt(ringIdField(note.utxo.ringProgramId)) !== domain.ringProgramID ||
+    state.writer !== bytesToBigInt(note.utxo.owner.ownerProofInputHash())
+  )
+    throw new Error("spawn_note_owner_or_ring");
+  const stateHash = hashSpawnRoomState(state);
+  if (!equalBytes(stateHash, note.dataHash)) throw new Error("spawn_state_hash_mismatch");
+  const rebuilt = note.utxo.hash(note.nullifierPublicKey, treeId, stateHash, note.ringDataHash);
+  if (!equalBytes(rebuilt, publishedCommitment)) throw new Error("spawn_note_commitment");
+  return Object.freeze({ state, stateHash, note, treeId, commitment: rebuilt });
+}
+
+/** Uses CRING/rcp and the same commitment-based opening as ordinary anonymous notes. */
+export function openSpawnRoomOutput(
+  reader: RingOutputReader,
+  slotSecret: Bytes32,
+  ciphertext: Uint8Array,
+  domain: SpawnRoomDomain,
+): OpenedSpawnRoom | undefined {
+  try {
+    const note = openRecipientNote(reader, openOutputSlot(slotSecret, ciphertext));
+    return note === undefined
+      ? undefined
+      : verifySpawnRoomNote(note, reader.treeId, domain, reader.commitment);
+  } catch {
+    // A scan encounters other recipients and malformed bodies; neither is a room.
+    return undefined;
+  }
+}
diff --git a/sdk-libs/ts/src/experimental/spawn-room/prover.ts b/sdk-libs/ts/src/experimental/spawn-room/prover.ts
new file mode 100644
index 0000000000000000000000000000000000000000..75648d7cb7cdc1b19feb965d56f43ce0603fe310
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/prover.ts
@@ -0,0 +1,278 @@
+/** Separate experimental circuit families; ordinary ring and SPP keys stay unchanged. */
+import type { RequestContext } from "@heliuslabs/spr";
+import {
+  bytesToBigInt,
+  equalBytes,
+  isZero,
+  parseCheckedProof,
+  ProverClient,
+  type ExpectedProvingKey,
+} from "@heliuslabs/spr/internal";
+import { bytesToHex } from "@noble/hashes/utils.js";
+import type { RingProver } from "../../rpc/ports.js";
+import { customRingProof } from "../../rpc/prover/proof.js";
+import {
+  ringProofCircuit,
+  ringProofRequestBody,
+  type RingProofRequest,
+  type TransferProofRequest,
+} from "../../rpc/prover/ring.js";
+import { extended } from "../../operations/workflow/extended.js";
+import {
+  assertSpawnRoomDomainMatches,
+  assertSpawnRoomGenesis,
+  deriveSpawnRoomAdvance,
+  encodeSpawnRoomState,
+  hashSpawnApplicationStatement,
+  hashSpawnGenesisStatement,
+  hashSpawnRoomState,
+  hashSpawnAcceptanceGrant,
+  spawnDigestLimbs,
+  spawnGrantRoot,
+  spawnScalarBytes,
+  type SpawnAcceptanceGrant,
+  type SpawnAcceptedMemory,
+  type SpawnGrantPath,
+  type SpawnRoomContext,
+  type SpawnRoomDomain,
+  type SpawnRoomState,
+} from "./codec.js";
+import { SPAWN_ROOM_LOCALNET_KEYS } from "./localnet-keys.js";
+
+export type SpawnRoomProofSelection =
+  | { readonly kind: "genesis"; readonly domain: SpawnRoomDomain; readonly state: SpawnRoomState }
+  | {
+      readonly kind: "advance";
+      readonly context: SpawnRoomContext;
+      readonly old: SpawnRoomState;
+      readonly next: SpawnRoomState;
+      readonly grant: SpawnAcceptanceGrant;
+      readonly grantPath: SpawnGrantPath;
+    };
+
+const field = (value: bigint): string => `0x${bytesToHex(spawnScalarBytes(value))}`;
+const limbs = (value: Uint8Array): readonly string[] => spawnDigestLimbs(value).map(field);
+function memory(value: SpawnAcceptedMemory) {
+  const padded = new Uint8Array(96);
+  padded.set(value.lesson);
+  return {
+    lesson: `0x${bytesToHex(padded)}`,
+    length: value.lesson.length,
+    scope: value.scope,
+    episode: limbs(value.episode),
+    originalResult: limbs(value.originalResult),
+    candidate: limbs(value.candidate),
+  };
+}
+function domain(value: SpawnRoomDomain) {
+  return {
+    network: limbs(value.network),
+    applicationId: field(value.applicationID),
+    ringProgramId: field(value.ringProgramID),
+  };
+}
+/** JSON uint64s remain bigint until the exact-number serializer below. */
+export function spawnStateParams(value: SpawnRoomState) {
+  encodeSpawnRoomState(value);
+  return {
+    binding: { ...domain(value.binding), creationNonce: limbs(value.binding.creationNonce) },
+    seedManifest: limbs(value.seedManifest),
+    fixedMembers: limbs(value.fixedMembers),
+    writer: field(value.writer),
+    revision: value.revision,
+    memory: memory(value.memory),
+    policy: { id: value.policy.id, scores: [...value.policy.scores] },
+    predecessor: field(value.predecessor),
+    authorization: field(value.authorization),
+    lastAuthorizationEpoch: value.lastAuthorizationEpoch,
+  };
+}
+function grant(value: SpawnAcceptanceGrant) {
+  return {
+    roomIdentity: field(value.roomIdentity),
+    actor: field(value.actor),
+    epoch: value.epoch,
+    predecessor: field(value.predecessor),
+    ordinal: value.ordinal,
+    memory: memory(value.memory),
+    selectedProcedure: value.selectedProcedure,
+    negative: Number(value.negative),
+    magnitude: value.magnitude,
+    nonce: limbs(value.nonce),
+  };
+}
+
+/** Exact Go uint64 JSON numbers, including 2^64-1. Never convert through Number. */
+export function stringifySpawnProofRequest(value: unknown): string {
+  const json = JSON as typeof JSON & { rawJSON(text: string): unknown };
+  if (typeof json.rawJSON !== "function") throw new Error("spawn_node24_json_required");
+  return JSON.stringify(value, (_key, item: unknown) => {
+    if (typeof item === "bigint") {
+      if (item < 0n || item >= 1n << 64n) throw new Error("spawn_json_u64_range");
+      return json.rawJSON(item.toString());
+    }
+    if (typeof item === "number" && !Number.isSafeInteger(item))
+      throw new Error("spawn_json_unsafe_number");
+    return item;
+  });
+}
+
+function profile(request: TransferProofRequest, selection: SpawnRoomProofSelection): void {
+  const state = selection.kind === "genesis" ? selection.state : selection.next;
+  const shape = ringProofCircuit(request);
+  if (
+    shape.family !== "transfer" ||
+    shape.class !== 24 ||
+    shape.outputs !== 2 ||
+    shape.owners !== 4 ||
+    shape.withdrawals !== 4 ||
+    shape.entry ||
+    shape.wide ||
+    request.inProof ||
+    request.delegate ||
+    request.layout.entry ||
+    request.layout.vouched ||
+    request.withdrawalCount !== 0 ||
+    request.publicAmounts.some((value) => !isZero(value)) ||
+    request.publicGross.some((value) => !isZero(value)) ||
+    isZero(request.policyHash) ||
+    isZero(request.trackingRoot)
+  )
+    throw new Error("spawn_proof_frame_profile");
+  if (
+    request.hidden !== (selection.kind === "advance") ||
+    request.signerCount !== (selection.kind === "genesis" ? 1 : 0)
+  )
+    throw new Error("spawn_proof_owner_profile");
+  if (
+    request.inputs
+      .slice(selection.kind === "genesis" ? 0 : 1)
+      .some((slot) => bytesToBigInt(slot.domain) !== 1n) ||
+    request.outputs.slice(1).some((slot) => bytesToBigInt(slot.output.domain) !== 1n)
+  )
+    throw new Error("spawn_proof_dummy_profile");
+  const output = request.outputs[0]!.output;
+  if (
+    bytesToBigInt(output.domain) !== 3n ||
+    !isZero(output.amount) ||
+    !isZero(output.ringDataHash) ||
+    bytesToBigInt(output.ownerPkHash) !== state.writer ||
+    bytesToBigInt(output.ringProgramId) !== state.binding.ringProgramID ||
+    !equalBytes(output.dataHash, hashSpawnRoomState(state))
+  )
+    throw new Error("spawn_proof_output_state");
+  if (selection.kind === "genesis") {
+    if (bytesToBigInt(request.signers[0]!) !== state.writer)
+      throw new Error("spawn_proof_genesis_writer");
+  } else {
+    const input = request.inputs[0]!;
+    if (
+      bytesToBigInt(input.domain) !== 3n ||
+      !isZero(input.amount) ||
+      !isZero(input.ringDataHash) ||
+      !equalBytes(input.dataHash, hashSpawnRoomState(selection.old)) ||
+      !equalBytes(input.ownerPkHash, output.ownerPkHash) ||
+      !equalBytes(input.nullifierPk, output.nullifierPk) ||
+      !equalBytes(input.asset, output.asset)
+    )
+      throw new Error("spawn_proof_input_state");
+  }
+}
+
+export function spawnRoomProofRequestBody(
+  request: TransferProofRequest,
+  selection: SpawnRoomProofSelection,
+): Readonly<Record<string, unknown>> {
+  profile(request, selection);
+  const upstream = ringProofRequestBody(request);
+  if (selection.kind === "genesis") {
+    assertSpawnRoomGenesis(selection.state);
+    assertSpawnRoomDomainMatches(selection.state.binding, selection.domain);
+    return {
+      ...upstream,
+      circuitType: "spawn-room-genesis-v1",
+      genesisStatementHash: `0x${bytesToHex(hashSpawnGenesisStatement(selection.domain, bytesToBigInt(request.publicInputHash), selection.state))}`,
+      context: domain(selection.domain),
+      state: spawnStateParams(selection.state),
+    };
+  }
+  const { context, old, next, grant: authorization, grantPath } = selection;
+  const expected = deriveSpawnRoomAdvance(context, old, authorization.predecessor, authorization);
+  if (!equalBytes(encodeSpawnRoomState(expected), encodeSpawnRoomState(next)))
+    throw new Error("spawn_proof_next_state");
+  if (
+    bytesToBigInt(spawnGrantRoot(hashSpawnAcceptanceGrant(context, authorization), grantPath)) !==
+    context.grantRoot
+  )
+    throw new Error("spawn_proof_grant_membership");
+  return {
+    ...upstream,
+    circuitType: "spawn-room-advance-v1",
+    applicationStatementHash: `0x${bytesToHex(hashSpawnApplicationStatement(context, bytesToBigInt(request.publicInputHash)))}`,
+    context: {
+      ...domain(context),
+      grantRoot: field(context.grantRoot),
+      grantEpoch: context.grantEpoch,
+    },
+    advance: {
+      old: spawnStateParams(old),
+      next: spawnStateParams(next),
+      grant: grant(authorization),
+      grantPath: {
+        index: grantPath.index,
+        siblings: grantPath.siblings.map((row) => row.map((value) => field(bytesToBigInt(value)))),
+      },
+    },
+  };
+}
+
+export class SpawnRoomLocalnetProver {
+  readonly #prover: ProverClient;
+  constructor(input: {
+    url: string | URL;
+    localnetTestKeys: true;
+    fetch?: typeof globalThis.fetch;
+  }) {
+    const url = new URL(input.url);
+    if (
+      input.localnetTestKeys !== true ||
+      !["127.0.0.1", "localhost", "[::1]"].includes(url.hostname) ||
+      url.username !== "" ||
+      url.password !== ""
+    )
+      throw new Error("spawn_prover_localnet_only");
+    this.#prover = new ProverClient({
+      url,
+      ...(input.fetch === undefined ? {} : { fetch: input.fetch }),
+    });
+  }
+  async prove(
+    request: TransferProofRequest,
+    selection: SpawnRoomProofSelection,
+    context?: RequestContext,
+  ): Promise<Uint8Array> {
+    const name =
+      selection.kind === "genesis" ? "spawn_room_genesis_v1.key" : "spawn_room_advance_v1.key";
+    const pin = SPAWN_ROOM_LOCALNET_KEYS[name];
+    if (pin === undefined) throw new Error("spawn_localnet_key_pin_missing");
+    const key: ExpectedProvingKey = { name, sha256: pin.sha256 };
+    const body = stringifySpawnProofRequest(spawnRoomProofRequestBody(request, selection));
+    return customRingProof(
+      parseCheckedProof(await this.#prover.send(body, "queued", key, context), key),
+    );
+  }
+}
+
+/** Existing SPP proof/signing/indexer methods stay bound to their original client. */
+export function withSpawnRoomProof<T extends RingProver>(
+  client: T,
+  prover: SpawnRoomLocalnetProver,
+  selection: SpawnRoomProofSelection,
+): T {
+  return extended(client, {
+    proveRing: (request: RingProofRequest, context?: RequestContext): Promise<Uint8Array> =>
+      request.kind === "transfer"
+        ? prover.prove(request, selection, context)
+        : client.proveRing(request, context),
+  });
+}
diff --git a/sdk-libs/ts/src/experimental/spawn-room/recovery.ts b/sdk-libs/ts/src/experimental/spawn-room/recovery.ts
new file mode 100644
index 0000000000000000000000000000000000000000..713d9e7050288d5ac8d380550da731d15f561161
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/recovery.ts
@@ -0,0 +1,73 @@
+/** Confirmed-note lookup through the pinned indexer's ring-aware history query. */
+import type { Address, Bytes32, RequestContext, Signature } from "@heliuslabs/spr";
+import type { IndexerReader, IndexerRpcConfig } from "@heliuslabs/spr/client";
+import { equalBytes } from "@heliuslabs/spr/internal";
+import type { IndexedShieldedTransaction } from "@heliuslabs/spr/transaction";
+import { scanLimits } from "../../rpc/history.js";
+
+const { pageSize, maxPages } = scanLimits({});
+
+export class SpawnRoomIndexIncomplete extends Error {
+  readonly retryable = true;
+
+  constructor(code: "spawn_observed_note_incomplete_index" | "spawn_observed_note_page_limit") {
+    super(code);
+  }
+}
+
+/**
+ * Pinned Photon omits ring metadata from its by-signature SELECT. The by-ring
+ * history query hydrates it. Read only the independently confirmed slot and
+ * require the exact signature, program and full note commitment in that row.
+ * The caller still verifies ledger status and opens the authenticated note.
+ */
+export async function findSpawnRoomIndexedNote(
+  input: Readonly<{
+    client: Pick<IndexerReader, "getShieldedTransactionsByTags">;
+    ringProgramId: Address;
+    signature: Signature;
+    slot: bigint;
+    commitment: Bytes32;
+    config: IndexerRpcConfig & { readonly requireSlot: bigint };
+  }>,
+  context?: RequestContext,
+): Promise<IndexedShieldedTransaction> {
+  if (input.slot < 0n || input.config.requireSlot < input.slot)
+    throw new Error("spawn_observed_note_slot");
+  let paginationToken: string | undefined;
+  const seen = new Set<string>();
+  for (let pageNumber = 0; pageNumber < maxPages; pageNumber++) {
+    context?.signal?.throwIfAborted();
+    const page = await input.client.getShieldedTransactionsByTags(
+      {
+        tags: [],
+        ringProgramId: input.ringProgramId,
+        filters: { slot: { gte: input.slot, lte: input.slot } },
+        limit: pageSize,
+        ...(paginationToken === undefined ? {} : { paginationToken }),
+      },
+      input.config,
+      context,
+    );
+    if (page.context.slot < input.config.requireSlot)
+      throw new SpawnRoomIndexIncomplete("spawn_observed_note_incomplete_index");
+    for (const group of page.data) {
+      if (group.slot !== input.slot || group.signature !== input.signature) continue;
+      for (const transaction of group.events)
+        if (
+          transaction.txSignature === input.signature &&
+          transaction.slot === input.slot &&
+          transaction.ringProgramId === input.ringProgramId &&
+          transaction.outputSlots.some((output) =>
+            equalBytes(output.outputContext.hash, input.commitment),
+          )
+        )
+          return transaction;
+    }
+    if (page.paginationToken === null) throw new Error("spawn_observed_note_not_in_transaction");
+    if (seen.has(page.paginationToken)) throw new Error("spawn_observed_note_repeated_page");
+    seen.add(page.paginationToken);
+    paginationToken = page.paginationToken;
+  }
+  throw new SpawnRoomIndexIncomplete("spawn_observed_note_page_limit");
+}
diff --git a/sdk-libs/ts/src/experimental/spawn-room/staging.ts b/sdk-libs/ts/src/experimental/spawn-room/staging.ts
new file mode 100644
index 0000000000000000000000000000000000000000..cf94df6c2c48b9cde0145d0cc4dda4863456e5ed
--- /dev/null
+++ b/sdk-libs/ts/src/experimental/spawn-room/staging.ts
@@ -0,0 +1,144 @@
+/** Exact one-note staging, isolated from ordinary payment/change behavior. */
+import type { Address, Bytes32 } from "@heliuslabs/spr";
+import type { WalletKeys } from "@heliuslabs/spr/client";
+import { bytesToBigInt, encodeBase58, equalBytes } from "@heliuslabs/spr/internal";
+import {
+  ConfidentialTransfer,
+  createProofOutput,
+  SOL_MINT,
+  type AssetRegistry,
+  type ProofInputUtxo,
+  type TreeId,
+} from "@heliuslabs/spr/transaction";
+import { RingAddress } from "../../crypto/keys/ring-address.js";
+import { ringIdField } from "../../crypto/derivation/ring-stream.js";
+import type { AnonymousSpendSigner } from "../../operations/payments/anonymous.js";
+import {
+  CustomRingTransfer,
+  type AnonymousTransfer,
+  type PublicOwnerTransfer,
+} from "../../operations/payments/transfer-rails.js";
+import { assertSpawnRoomGenesis, hashSpawnRoomState, type SpawnRoomState } from "./codec.js";
+import { createSpawnRoomApplicationData } from "./payload.js";
+
+interface SpawnStaging {
+  readonly ringProgramId: Address;
+  readonly keys: WalletKeys;
+  readonly listSalt: Bytes32;
+  readonly payer: Address;
+  readonly outputTreeId: TreeId;
+  readonly assets: AssetRegistry;
+  readonly state: SpawnRoomState;
+}
+
+/**
+ * RingOutputRail normally promotes unused ring-tagged padding into sender change.
+ * This exact profile has one application note and zero change. Ordinary dummy
+ * outputs need no ring binding, so build only their padding with the upstream
+ * createProofOutput primitive and leave all live outputs and blindings intact.
+ */
+function exactPadding(transfer: ConfidentialTransfer, ring: Address, genesis: boolean): void {
+  const prepare = transfer.prepare.bind(transfer);
+  transfer.prepare = () => {
+    const prepared = prepare();
+    const output = prepared.outputs[0];
+    if (
+      prepared.outputs.length !== 1 ||
+      prepared.senderOutputCount !== 0 ||
+      prepared.interfaceTransfers.length !== 0 ||
+      prepared.shape.outputs !== 2 ||
+      output?.amount !== 0n ||
+      output.ringProgramId !== ring ||
+      output.ownerAddress === undefined ||
+      !equalBytes(output.ownerAddress.toBytes(), prepared.owner.toBytes())
+    )
+      throw new Error("spawn_staging_output_profile");
+    if (
+      genesis
+        ? prepared.inputs.some((input) => !input.isDummy())
+        : prepared.inputs.length !== 1 ||
+          prepared.inputs[0]!.isDummy() ||
+          prepared.inputs[0]!.utxo.amount !== 0n ||
+          prepared.inputs[0]!.utxo.ringProgramId !== ring
+    )
+      throw new Error("spawn_staging_input_profile");
+    return Object.freeze({
+      ...prepared,
+      proofOutputs: () =>
+        Object.freeze(
+          prepared
+            .proofOutputs()
+            .map((slot) =>
+              slot.isDummy()
+                ? createProofOutput({
+                    asset: slot.asset,
+                    amount: 0n,
+                    blinding: slot.blinding,
+                    ...(slot.compact === undefined ? {} : { compact: slot.compact }),
+                  })
+                : slot,
+            ),
+        ),
+    });
+  };
+}
+
+function prepare(
+  input: SpawnStaging,
+  transfer: ConfidentialTransfer,
+  genesis: boolean,
+): CustomRingTransfer {
+  const owner = input.keys.address();
+  if (
+    input.state.writer !== bytesToBigInt(owner.signingPublicKey.ownerProofInputHash()) ||
+    input.state.binding.ringProgramID !== bytesToBigInt(ringIdField(input.ringProgramId))
+  )
+    throw new Error("spawn_staging_owner_or_ring");
+  hashSpawnRoomState(input.state);
+  transfer.withOutputTreeId(input.outputTreeId).withShape({ inputs: 2, outputs: 2 });
+  exactPadding(transfer, input.ringProgramId, genesis);
+  return CustomRingTransfer.new({
+    ringProgramId: input.ringProgramId,
+    keys: input.keys,
+    transfer,
+    assets: input.assets,
+  });
+}
+function payment(input: SpawnStaging, asset: Address) {
+  return {
+    to: new RingAddress({
+      recipient: input.keys.address(),
+      ringProgramId: input.ringProgramId,
+      listSalt: input.listSalt,
+    }),
+    asset,
+    amount: 0n,
+    reply: null,
+    data: { application: createSpawnRoomApplicationData(input.state) },
+  } as const;
+}
+
+/** One true dummy input, no deposit leg, one visibly signing creator. */
+export function stageSpawnRoomGenesis(input: SpawnStaging): PublicOwnerTransfer {
+  assertSpawnRoomGenesis(input.state);
+  const owner = input.keys.address();
+  return prepare(
+    input,
+    ConfidentialTransfer.newDeposit(owner, input.outputTreeId, input.payer),
+    true,
+  )
+    .spendPublic(encodeBase58(owner.signingPublicKey.ed25519()))
+    .withPayment(payment(input, SOL_MINT));
+}
+
+/** One live zero-value input; the existing anonymous SPP signer authorizes it. */
+export function stageSpawnRoomAdvance(
+  input: SpawnStaging & { input: ProofInputUtxo; signer: AnonymousSpendSigner },
+): AnonymousTransfer {
+  const owner = input.keys.address();
+  if (input.payer === encodeBase58(owner.signingPublicKey.ed25519()))
+    throw new Error("spawn_hidden_writer_is_payer");
+  return prepare(input, new ConfidentialTransfer(owner, [input.input], input.payer), false)
+    .withAnonymousSigner(input.signer)
+    .withPayment(payment(input, input.input.utxo.asset));
+}
diff --git a/sdk-libs/ts/test/experimental/spawn-room-codec.test.ts b/sdk-libs/ts/test/experimental/spawn-room-codec.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e4a36f144b6fdabcb2da527feb4689cea7b4dadb
--- /dev/null
+++ b/sdk-libs/ts/test/experimental/spawn-room-codec.test.ts
@@ -0,0 +1,206 @@
+import { beforeAll, describe, expect, it } from "vitest";
+import { initializePoseidon } from "@heliuslabs/spr";
+import { BN254_MODULUS_DEC, bytesToBigInt, poseidon } from "@heliuslabs/spr/internal";
+import { bytesToHex } from "@noble/hashes/utils.js";
+
+import {
+  decodeSpawnAcceptanceGrant,
+  decodeSpawnRoomState,
+  deriveSpawnRoomAdvance,
+  encodeSpawnAcceptanceGrant,
+  encodeSpawnRoomState,
+  hashSpawnAcceptanceGrant,
+  hashSpawnRoomState,
+  spawnGrantRoot,
+  spawnRoomIdentity,
+  spawnScalarBytes,
+  type SpawnAcceptanceGrant,
+  type SpawnRoomContext,
+  type SpawnRoomState,
+} from "../../src/experimental/spawn-room/codec.js";
+
+const limbs = (hi: bigint, lo: bigint): Uint8Array => {
+  const result = new Uint8Array(32);
+  for (let i = 15; i >= 0; i--) {
+    result[i] = Number(hi & 255n);
+    result[16 + i] = Number(lo & 255n);
+    hi >>= 8n;
+    lo >>= 8n;
+  }
+  return result;
+};
+const memory = (lesson: string, n: bigint) => ({
+  lesson: new TextEncoder().encode(lesson),
+  scope: 0 as const,
+  episode: limbs(n, n + 1n),
+  originalResult: limbs(n + 2n, n + 3n),
+  candidate: limbs(n + 4n, n + 5n),
+});
+const hex = (value: string): string => value.padStart(64, "0");
+
+/** Independent fixed vector also pinned in Go TestSpawnRoomStateCommitmentVector. */
+export function spawnCodecFixture() {
+  const context: SpawnRoomContext = {
+    network: limbs((1n << 128n) - 1n, 17n),
+    applicationID: 19n,
+    ringProgramID: 13n,
+    grantEpoch: 3n,
+    grantRoot: BigInt("0x0f8cc20607a23f72c265a41beafa6d2bd6b6a4b08576178bb67428d8d02b7137"),
+  };
+  const old: SpawnRoomState = {
+    binding: {
+      network: context.network,
+      applicationID: 19n,
+      ringProgramID: 13n,
+      creationNonce: limbs(23n, 29n),
+    },
+    seedManifest: limbs(31n, 37n),
+    fixedMembers: limbs(41n, 43n),
+    writer: 7n,
+    revision: 4n,
+    memory: memory("older lesson", 47n),
+    policy: { id: 1n, scores: [50, 50] },
+    predecessor: 79n,
+    authorization: 83n,
+    lastAuthorizationEpoch: 2n,
+  };
+  const predecessor = BigInt("0x06110d28d75875638ee363ebcdf97744e212548624e61580ad629af4a3d82bff");
+  const grant: SpawnAcceptanceGrant = {
+    roomIdentity: BigInt("0x0004dcf13babfaf817fabe56ad5c79da37f1e9c69e5f3ff8c4b5e3535c2453aa"),
+    actor: 7n,
+    epoch: 3n,
+    predecessor,
+    ordinal: 5n,
+    memory: memory("Use a bounded retry.", 53n),
+    selectedProcedure: 0,
+    negative: false,
+    magnitude: 7,
+    nonce: limbs(89n, 97n),
+  };
+  return { context, old, grant, predecessor };
+}
+
+describe("experimental Spawn room canonical codec", () => {
+  beforeAll(initializePoseidon);
+
+  it("reproduces the independent Go identity/state/grant/new-state vectors", () => {
+    const { context, old, grant, predecessor } = spawnCodecFixture();
+    expect(bytesToHex(spawnRoomIdentity(old))).toBe(
+      hex("0004dcf13babfaf817fabe56ad5c79da37f1e9c69e5f3ff8c4b5e3535c2453aa"),
+    );
+    expect(bytesToHex(hashSpawnRoomState(old))).toBe(
+      hex("2e4305dcc6f85eb7b3785632ff5a58b9a36c586e4ba03e6f329d6ab8bc7b9e2e"),
+    );
+    expect(bytesToHex(hashSpawnAcceptanceGrant(context, grant))).toBe(
+      hex("1d41673a7393fb1daf7ab1405ae78183dfab22864d679265536e624c3d9c931c"),
+    );
+    const next = deriveSpawnRoomAdvance(context, old, predecessor, grant);
+    expect(next.policy.scores).toEqual([57, 50]);
+    expect(bytesToHex(hashSpawnRoomState(next))).toBe(
+      hex("0a0077d99d38d457ec84647a8617f98e4e4f53637865e39a671bdb876a00fba6"),
+    );
+    let empty = spawnScalarBytes(0n);
+    const siblings = Array.from({ length: 13 }, () => {
+      const layer = [empty, empty, empty] as const;
+      empty = poseidon([empty, empty, empty, empty]);
+      return layer;
+    });
+    expect(
+      bytesToBigInt(
+        spawnGrantRoot(hashSpawnAcceptanceGrant(context, grant), { index: 37, siblings }),
+      ),
+    ).toBe(context.grantRoot);
+  });
+
+  it("pins the exact byte layout and retains every digest bit, including values above q", () => {
+    const { old, grant } = spawnCodecFixture();
+    const state = {
+      ...old,
+      seedManifest: new Uint8Array(32).fill(255),
+      revision: (1n << 64n) - 1n,
+    };
+    const encoded = encodeSpawnRoomState(state);
+    expect(encoded.length).toBe(516);
+    expect(new TextDecoder().decode(encoded.subarray(0, 8))).toBe("SPRST001");
+    expect(encoded.slice(136, 168)).toEqual(state.seedManifest);
+    expect(encoded.slice(232, 240)).toEqual(new Uint8Array(8).fill(255));
+    expect(encoded[240]).toBe(12);
+    expect(encoded[241]).toBe(0);
+    expect(encoded.slice(242, 254)).toEqual(new TextEncoder().encode("older lesson"));
+    expect(decodeSpawnRoomState(encoded)).toEqual(state);
+    const encodedGrant = encodeSpawnAcceptanceGrant(grant);
+    expect(encodedGrant.length).toBe(349);
+    expect(new TextDecoder().decode(encodedGrant.subarray(0, 8))).toBe("SPRGR001");
+    expect(decodeSpawnAcceptanceGrant(encodedGrant)).toEqual(grant);
+    const highDigest = { ...old, seedManifest: limbs(0n, 1n) };
+    // Add q as a raw 256-bit digest: field reduction would make these collide.
+    const aliasDigest = {
+      ...old,
+      seedManifest: limbs(
+        (BigInt(BN254_MODULUS_DEC) + 1n) >> 128n,
+        (BigInt(BN254_MODULUS_DEC) + 1n) & ((1n << 128n) - 1n),
+      ),
+    };
+    expect(hashSpawnRoomState(highDigest)).not.toEqual(hashSpawnRoomState(aliasDigest));
+  });
+
+  it("rejects scalar aliases, trailing data, nonzero lesson padding and overlong lessons", () => {
+    const { old, grant } = spawnCodecFixture();
+    const encoded = encodeSpawnRoomState(old);
+    const q = BigInt(BN254_MODULUS_DEC);
+    const alias = limbs(q >> 128n, q & ((1n << 128n) - 1n));
+    const badScalar = encoded.slice();
+    badScalar.set(alias, 40);
+    expect(() => decodeSpawnRoomState(badScalar)).toThrow(/scalar/);
+    expect(() => decodeSpawnRoomState(Uint8Array.of(...encoded, 0))).toThrow(/length/);
+    const padding = encoded.slice();
+    padding[337] = 1;
+    expect(() => decodeSpawnRoomState(padding)).toThrow(/padding/);
+    expect(() =>
+      encodeSpawnRoomState({ ...old, memory: { ...old.memory, lesson: new Uint8Array(97) } }),
+    ).toThrow(/lesson/);
+    expect(() =>
+      encodeSpawnAcceptanceGrant({
+        ...grant,
+        memory: { ...grant.memory, lesson: new Uint8Array() },
+      }),
+    ).toThrow(/lesson/);
+    expect(() => encodeSpawnAcceptanceGrant({ ...grant, nonce: new Uint8Array(32) })).toThrow(
+      /nonce/,
+    );
+    expect(() => encodeSpawnRoomState({ ...old, writer: q + old.writer })).toThrow(/scalar/);
+    expect(() => encodeSpawnRoomState({ ...old, revision: 1n << 64n })).toThrow(/u64/);
+  });
+
+  it("binds an advance to its exact original, ordinal, owner and current epoch", () => {
+    const { context, old, grant, predecessor } = spawnCodecFixture();
+    for (const changed of [
+      { ...grant, actor: 8n },
+      { ...grant, roomIdentity: 4n },
+      { ...grant, predecessor: predecessor + 1n },
+      { ...grant, ordinal: 6n },
+      { ...grant, epoch: 2n },
+    ])
+      expect(() => deriveSpawnRoomAdvance(context, old, predecessor, changed)).toThrow();
+    expect(() =>
+      deriveSpawnRoomAdvance({ ...context, grantEpoch: 1n }, old, predecessor, {
+        ...grant,
+        epoch: 1n,
+      }),
+    ).toThrow(/epoch/);
+    const next = deriveSpawnRoomAdvance(
+      context,
+      { ...old, policy: { id: 1n, scores: [97, 3] } },
+      predecessor,
+      grant,
+    );
+    expect(next.policy.scores).toEqual([100, 3]);
+    const negative = deriveSpawnRoomAdvance(context, old, predecessor, {
+      ...grant,
+      selectedProcedure: 1,
+      negative: true,
+    });
+    expect(negative.policy.scores).toEqual([50, 43]);
+    expect(negative.memory.originalResult).toEqual(grant.memory.originalResult);
+  });
+});
