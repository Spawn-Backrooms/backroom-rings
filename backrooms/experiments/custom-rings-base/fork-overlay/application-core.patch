+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createServer, connect } from 'node:net';
+import { normalizedPorts, requireAvailablePorts, waitForAvailablePorts, validateJourneyResult } from './run-spawn-room-localnet.mjs';
+import { LocalnetResourceMonitor } from './localnet-resource-monitor.mjs';
+
+const report = () => ({ success: true, numPassedTests: 1, numFailedTests: 0, numPendingTests: 0, numTodoTests: 0,
+  testResults: [{ assertionResults: [{ status: 'passed' }] }] });
+const evidence = () => ({ schema: 'spawn-room-localnet-journey-v1', status: 'passed',
+  steps: ['create', 'advance', 'recovery', 'reuse'].map((name) => ({ name, status: 'passed' })) });
+
+test('no tests, skipped tests and incomplete chain journeys cannot become a passed run', () => {
+  assert.doesNotThrow(() => validateJourneyResult(report(), evidence()));
+  assert.throws(() => validateJourneyResult({ ...report(), numPassedTests: 0 }, evidence()));
+  assert.throws(() => validateJourneyResult({ ...report(), numPendingTests: 1 }, evidence()));
+  assert.throws(() => validateJourneyResult({ ...report(), testResults: [] }, evidence()));
+  assert.throws(() => validateJourneyResult(report(), { ...evidence(), steps: evidence().steps.slice(0, 3) }));
+  assert.throws(() => validateJourneyResult(report(), { ...evidence(), status: 'failed' }));
+  assert.throws(() => validateJourneyResult(report(), { ...evidence(), steps: [...evidence().steps, { name: 'negative-cases', status: 'failed' }] }));
+});
+
+test('port preflight refuses an occupied socket and leaves its owner running', async () => {
+  const server = createServer((socket) => socket.end('owned-by-test'));
+  await new Promise((accept) => server.listen(0, '127.0.0.1', accept));
+  try {
+    const port = server.address().port;
+    await assert.rejects(requireAvailablePorts([port]), { code: 'EADDRINUSE' });
+    const result = await new Promise((accept, reject) => {
+      const socket = connect(port, '127.0.0.1');
+      let data = '';
+      socket.on('data', (chunk) => { data += chunk; });
+      socket.on('end', () => accept(data));
+      socket.on('error', reject);
+    });
+    assert.equal(result, 'owned-by-test');
+  } finally { await new Promise((done) => server.close(done)); }
+});
+
+test('RPC auxiliary ports are part of the collision and range checks', () => {
+  assert.throws(() => normalizedPorts({ photon: 42900 }), /distinct/);
+  assert.throws(() => normalizedPorts({ rpc: 65535 }), /range/);
+  assert.throws(() => normalizedPorts({ rpc: '42899' }), /range/);
+});
+
+test('shutdown waits for the owned listener to close after a stop acknowledgement', async () => {
+  const server = createServer();
+  await new Promise((accept) => server.listen(0, '127.0.0.1', accept));
+  const port = server.address().port;
+  const closing = setTimeout(() => server.close(), 150);
+  try { await waitForAvailablePorts([port], 2000); }
+  finally {
+    clearTimeout(closing);
+    if (server.listening) await new Promise((done) => server.close(done));
+  }
+  assert.equal(server.listening, false);
+});
+
+test('Linux resource evidence reports an observed process RSS rather than a configured heap limit', { skip: process.platform !== 'linux' }, async () => {
+  const monitor = new LocalnetResourceMonitor();
+  const result = await monitor.stop();
+  assert.equal(result.supported, true);
+  assert.ok(result.samples > 0);
+  const self = result.processes.find((row) => row.pid === process.pid);
+  assert.ok(self.observedOsHighWaterRssKiB > 0);
+  assert.ok(self.sampledPeakRssKiB > 0);
+  assert.ok(result.sampledPeakConcurrentRssKiB >= self.sampledPeakRssKiB);
+});
