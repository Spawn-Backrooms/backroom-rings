+      programAddress: program,
+      seeds: [encoder.encode("spawn-room-config-v1")],
+    })
+  )[0];
+}
+export async function spawnRoomGenesisAddress(
+  program: Address,
+  identity: Bytes32,
+): Promise<Address> {
+  if (!equalBytes(spawnScalarBytes(bytesToBigInt(identity)), identity) || isZero(identity))
+    throw new Error("spawn_genesis_identity");
+  return (
+    await getProgramDerivedAddress({
+      programAddress: program,
+      seeds: [encoder.encode("spawn-room-genesis-v1"), identity],
+    })
+  )[0];
+}
+export interface SpawnRoomConfig extends SpawnRoomContext {
+  readonly publisher: Address;
+}
+export function decodeSpawnRoomConfig(bytes: Uint8Array, program: Address): SpawnRoomConfig {
+  if (bytes.length !== 144 || !equalBytes(bytes.subarray(0, 8), encoder.encode("SPRCFG01")))
+    throw new Error("spawn_config_schema");
+  const network = bytes.slice(8, 40);
+  const applicationID = bytesToBigInt(bytes.subarray(40, 72));
+  const publisherBytes = bytes.slice(72, 104);
+  const grantRoot = bytesToBigInt(bytes.subarray(104, 136));
+  spawnScalarBytes(applicationID);
+  spawnScalarBytes(grantRoot);
+  if (isZero(publisherBytes)) throw new Error("spawn_config_publisher_zero");
+  const result = {
+    network,
+    applicationID,
+    publisher: encodeBase58(publisherBytes),
+    grantRoot,
+    grantEpoch: new DataView(bytes.buffer, bytes.byteOffset + 136, 8).getBigUint64(0, true),
+    ringProgramID: bytesToBigInt(ringIdField(program)),
+  };
