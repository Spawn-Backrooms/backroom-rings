+import { describe, expect, it } from "vitest";
+import type { GetShieldedTransactionsByTagsResponse, IndexerReader } from "@heliuslabs/spr/client";
+import type { IndexedShieldedTransaction } from "@heliuslabs/spr/transaction";
+import { findSpawnRoomIndexedNote } from "../../src/experimental/spawn-room/recovery.js";
+import { encodeRingBodyOutput } from "../../src/protocol/transaction/output.js";
+import { scanLimits } from "../../src/rpc/history.js";
+import { randomAddress, TREE } from "../helpers/ring-pipeline.js";
+import { signature } from "../helpers/ring-scan.js";
+import { spawnPayloadFixture } from "./spawn-room-fixture.js";
+
+function indexedFixture() {
+  const f = spawnPayloadFixture();
+  const transaction: IndexedShieldedTransaction = {
+    txSignature: signature(17n),
+    slot: 23n,
+    eventIndex: 0,
+    ringProgramId: f.reader.ring,
+    outputSlots: [
+      {
+        viewTag: new Uint8Array(32) as typeof f.commitment,
+        outputContext: { hash: f.commitment, tree: TREE, treeId: f.treeId, leafIndex: 0n },
+        payload: encodeRingBodyOutput(f.ciphertext, new Uint8Array()),
+      },
+    ],
+    nullifiers: [],
+    messages: [],
+    proofless: false,
+  };
+  const page = (row: IndexedShieldedTransaction): GetShieldedTransactionsByTagsResponse => ({
+    context: { slot: 29n, blockTime: 0n },
+    data: [{ signature: row.txSignature, slot: row.slot, events: [row] }],
+    paginationToken: null,
+  });
+  const input = {
+    ringProgramId: f.reader.ring,
+    signature: transaction.txSignature,
+    slot: transaction.slot,
+    commitment: f.commitment,
+    config: {
+      requireSlot: 29n,
+      poll: { numRetries: 0, delayMs: 1n, maxDelayMs: 1n },
+    },
+  };
+  return { f, transaction, page, input };
+}
+
+describe("Spawn confirmed note history binding", () => {
+  it("reads the ring-aware endpoint, follows pages and matches exact slot/signature/note", async () => {
+    const f = indexedFixture();
+    let calls = 0;
+    const client: Pick<IndexerReader, "getShieldedTransactionsByTags"> = {
+      getShieldedTransactionsByTags: async (request, config) => {
+        expect(request.ringProgramId).toBe(f.input.ringProgramId);
+        expect(request.tags).toEqual([]);
+        expect(request.filters).toEqual({ slot: { gte: 23n, lte: 23n } });
+        expect(config?.requireSlot).toBe(29n);
+        calls += 1;
+        if (calls === 1) {
+          expect(request.paginationToken).toBeUndefined();
+          return {
+            ...f.page({ ...f.transaction, txSignature: signature(18n) }),
+            paginationToken: "next-page",
+          };
+        }
+        expect(request.paginationToken).toBe("next-page");
+        return f.page(f.transaction);
+      },
+    };
+    await expect(findSpawnRoomIndexedNote({ ...f.input, client })).resolves.toBe(f.transaction);
+    expect(calls).toBe(2);
+  });
+
+  it.each(["ring", "signature", "slot", "commitment", "absent ring"] as const)(
+    "refuses a %s mismatch without falling back to an application-state digest",
+    async (kind) => {
+      const f = indexedFixture();
+      const { ringProgramId: _ring, ...withoutRing } = f.transaction;
+      const transaction =
+        kind === "ring"
+          ? { ...f.transaction, ringProgramId: randomAddress() }
+          : kind === "signature"
+            ? { ...f.transaction, txSignature: signature(18n) }
+            : kind === "slot"
+              ? { ...f.transaction, slot: 24n }
+              : kind === "commitment"
+                ? {
+                    ...f.transaction,
+                    outputSlots: f.transaction.outputSlots.map((output) => ({
+                      ...output,
+                      outputContext: { ...output.outputContext, hash: f.f.dataHash },
+                    })),
+                  }
+                : withoutRing;
+      await expect(
+        findSpawnRoomIndexedNote({
+          ...f.input,
+          client: { getShieldedTransactionsByTags: async () => f.page(transaction) },
+        }),
+      ).rejects.toThrow("spawn_observed_note_not_in_transaction");
+    },
+  );
+
+  it("refuses incomplete indexer coverage even if a matching row is present", async () => {
+    const f = indexedFixture();
+    await expect(
+      findSpawnRoomIndexedNote({
+        ...f.input,
+        client: {
+          getShieldedTransactionsByTags: async () => ({
+            ...f.page(f.transaction),
+            context: { slot: 22n, blockTime: 0n },
+          }),
+        },
+      }),
+    ).rejects.toThrow("spawn_observed_note_incomplete_index");
+  });
+
+  it("reports an incomplete, retryable lookup when it reaches the history page limit", async () => {
+    const f = indexedFixture();
+    const { maxPages } = scanLimits({});
+    let pageNumber = 0;
+    await expect(
+      findSpawnRoomIndexedNote({
+        ...f.input,
+        client: {
+          getShieldedTransactionsByTags: async () => ({
+            context: { slot: 29n, blockTime: 0n },
+            data: [],
+            paginationToken: `page-${++pageNumber}`,
+          }),
+        },
+      }),
+    ).rejects.toMatchObject({ message: "spawn_observed_note_page_limit", retryable: true });
+    expect(pageNumber).toBe(maxPages);
+  });
+
+  it("refuses a repeated page token instead of hanging or assuming coverage", async () => {
+    const f = indexedFixture();
+    await expect(
+      findSpawnRoomIndexedNote({
+        ...f.input,
+        client: {
+          getShieldedTransactionsByTags: async () => ({
+            context: { slot: 29n, blockTime: 0n },
+            data: [],
+            paginationToken: "repeated",
+          }),
+        },
+      }),
+    ).rejects.toThrow("spawn_observed_note_repeated_page");
+  });
+});
