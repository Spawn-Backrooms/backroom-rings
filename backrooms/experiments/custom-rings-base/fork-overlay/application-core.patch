diff --git a/program-libs/interface/src/proof/spawn_room.rs b/program-libs/interface/src/proof/spawn_room.rs
new file mode 100644
index 0000000000000000000000000000000000000000..941af4c470e57d9566726e193666ae9d94041560
--- /dev/null
+++ b/program-libs/interface/src/proof/spawn_room.rs
@@ -0,0 +1,283 @@
+//! Public transcript and verifier for the version-one hidden room advance.
+//! The caller derives the upstream statement from the validated transfer and
+//! reads deployment and grant values from authenticated application configuration.
+
+use spr_hasher::{
+    hash_chain::create_hash_chain_4_from_slice, primitives::right_align, HasherError,
+};
+
+const APPLICATION_DOMAIN: u32 = u32::from_be_bytes(*b"SPRA");
+const CIRCUIT_VERSION: u8 = 1;
+const ELEMENT_COUNT: usize = 10;
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SpawnRoomStatementV1 {
+    /// Raw 32-byte network identifier, preserved as two big-endian 128-bit limbs.
+    pub network: [u8; 32],
+    /// Canonical BN254 scalar identifying the application.
+    pub application_id: [u8; 32],
+    /// The same canonical ring identity field used by the upstream transfer.
+    pub ring_program_id: [u8; 32],
+    pub upstream_statement: [u8; 32],
+    pub grant_root: [u8; 32],
+    pub grant_epoch: u64,
+}
+
+impl SpawnRoomStatementV1 {
+    /// HashChain4 preimage in circuit order, including its exact element count.
+    pub fn elements(&self) -> [[u8; 32]; ELEMENT_COUNT] {
+        let (network, _) = self.network.as_chunks::<16>();
+        [
+            crate::domain::field(APPLICATION_DOMAIN),
+            right_align(&network[0]),
+            right_align(&network[1]),
+            self.application_id,
+            self.ring_program_id,
+            self.upstream_statement,
+            self.grant_root,
+            right_align(&self.grant_epoch.to_be_bytes()),
+            right_align(&[CIRCUIT_VERSION]),
+            right_align(&[ELEMENT_COUNT as u8]),
+        ]
+    }
+
+    pub fn hash(&self) -> Result<[u8; 32], HasherError> {
+        create_hash_chain_4_from_slice(&self.elements())
+    }
+
+    /// Public witness order of the combined circuit, with the original transfer first.
+    pub fn public_inputs(&self) -> Result<[[u8; 32]; 2], HasherError> {
+        Ok([self.upstream_statement, self.hash()?])
+    }
+}
+
+/// Visible genesis binds the marker seed and the signer of the initial note.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct SpawnRoomGenesisStatementV1 {
+    pub network: [u8; 32],
+    pub application_id: [u8; 32],
+    pub ring_program_id: [u8; 32],
+    pub upstream_statement: [u8; 32],
+    pub creation_identity: [u8; 32],
+    pub writer_owner_hash: [u8; 32],
+}
+
+impl SpawnRoomGenesisStatementV1 {
+    pub fn public_inputs(&self) -> Result<[[u8; 32]; 2], HasherError> {
+        let (network, _) = self.network.as_chunks::<16>();
+        let hash = create_hash_chain_4_from_slice(&[
+            crate::domain::field(u32::from_be_bytes(*b"SPRG")),
+            right_align(&network[0]),
+            right_align(&network[1]),
+            self.application_id,
+            self.ring_program_id,
+            self.upstream_statement,
+            self.creation_identity,
+            self.writer_owner_hash,
+            right_align(&[CIRCUIT_VERSION]),
+            right_align(&[ELEMENT_COUNT as u8]),
+        ])?;
+        Ok([self.upstream_statement, hash])
+    }
+
+    #[cfg(feature = "verifying-keys")]
+    pub fn verify(
+        &self,
+        proof: &crate::CustomRingProof,
+        key: &groth16_solana::groth16::Groth16Verifyingkey<'_>,
+    ) -> Result<(), solana_program_error::ProgramError> {
+        verify_public_inputs(
+            proof,
+            key,
+            &self.public_inputs().map_err(crate::CustomRingError::from)?,
+        )
+    }
+}
+
+/// The program must supply the pinned combined-circuit key for this operation.
+#[cfg(feature = "verifying-keys")]
+#[must_use]
+pub struct SpawnRoomProof<'a> {
+    pub proof: &'a crate::CustomRingProof,
+    pub statement: &'a SpawnRoomStatementV1,
+    pub key: &'a groth16_solana::groth16::Groth16Verifyingkey<'a>,
+}
+
+#[cfg(feature = "verifying-keys")]
+impl SpawnRoomProof<'_> {
+    #[inline(never)]
+    pub fn verify(self) -> Result<(), solana_program_error::ProgramError> {
+        verify_public_inputs(
+            self.proof,
+            self.key,
+            &self
+                .statement
+                .public_inputs()
+                .map_err(crate::CustomRingError::from)?,
+        )
+    }
+}
+
+#[cfg(feature = "verifying-keys")]
+#[inline(never)]
+fn verify_public_inputs(
+    proof: &crate::CustomRingProof,
+    key: &groth16_solana::groth16::Groth16Verifyingkey<'_>,
+    public_inputs: &[[u8; 32]; 2],
+) -> Result<(), solana_program_error::ProgramError> {
+    use crate::CustomRingError;
+    use groth16_solana::{
+        decompression::{decompress_g1, decompress_g2},
+        groth16::Groth16Verifier,
+    };
+    if key.nr_pubinputs != public_inputs.len() {
+        return Err(CustomRingError::UnsupportedCircuit.into());
+    }
+    let points = &proof.groth16;
+    let undecodable = |_| CustomRingError::InvalidRingProofPoint;
+    Groth16Verifier::new_with_commitment(
+        &decompress_g1(&points.proof_a).map_err(undecodable)?,
+        &decompress_g2(&points.proof_b).map_err(undecodable)?,
+        &decompress_g1(&points.proof_c).map_err(undecodable)?,
+        &decompress_g1(&proof.commitment).map_err(undecodable)?,
+        &decompress_g1(&proof.commitment_pok).map_err(undecodable)?,
+        public_inputs,
+        key,
+    )
+    .map_err(|_| CustomRingError::UnsupportedCircuit)?
+    .verify()
+    .map_err(|_| CustomRingError::ProofVerificationFailed)?;
+    Ok(())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn field_u64(n: u64) -> [u8; 32] {
+        let mut bytes = [0; 32];
+        bytes[24..].copy_from_slice(&n.to_be_bytes());
+        bytes
+    }
+
+    fn statement() -> SpawnRoomStatementV1 {
+        SpawnRoomStatementV1 {
+            network: core::array::from_fn(|i| 0x80 + i as u8),
+            application_id: field_u64(19),
+            ring_program_id: field_u64(13),
+            upstream_statement: field_u64(23),
+            grant_root: field_u64(29),
+            grant_epoch: 0x0102_0304_0506_0708,
+        }
+    }
+
+    #[test]
+    fn statement_matches_go_hash_and_public_witness_order() {
+        let s = statement();
+        let mut high = [0; 32];
+        high[16..].copy_from_slice(&s.network[..16]);
+        let mut low = [0; 32];
+        low[16..].copy_from_slice(&s.network[16..]);
+        let expected = [
+            field_u64(0x5350_5241),
+            high,
+            low,
+            field_u64(19),
+            field_u64(13),
+            field_u64(23),
+            field_u64(29),
+            field_u64(0x0102_0304_0506_0708),
+            field_u64(1),
+            field_u64(10),
+        ];
+        assert_eq!(s.elements(), expected);
+        // Generated independently by the pinned Go prover/transcript.HashChain4.
+        let mut digest = [0; 32];
+        hex::decode_to_slice(
+            "1051ac91af8bdc159a00e1d171da46f66c77eb7053620913107b59bdbe6fff4d",
+            &mut digest,
+        )
+        .unwrap();
+        assert_eq!(s.public_inputs().unwrap(), [field_u64(23), digest]);
+    }
+
+    #[test]
+    fn genesis_matches_go_and_binds_visible_writer_and_creation_identity() {
+        let a = statement();
+        let mut g = SpawnRoomGenesisStatementV1 {
+            network: a.network,
+            application_id: a.application_id,
+            ring_program_id: a.ring_program_id,
+            upstream_statement: a.upstream_statement,
+            creation_identity: field_u64(29),
+            writer_owner_hash: field_u64(31),
+        };
+        let inputs = g.public_inputs().unwrap();
+        assert_eq!(inputs[0], field_u64(23));
+        assert_eq!(
+            hex::encode(inputs[1]),
+            "23dc64c39ef7e4941011350b6318a23971a39dd8e2323c47353d0c14dcc3239d"
+        );
+        core::mem::swap(&mut g.creation_identity, &mut g.writer_owner_hash);
+        assert_ne!(g.public_inputs().unwrap(), inputs);
+    }
+
+    #[test]
+    fn rejects_noncanonical_statement_fields() {
+        let mut s = statement();
+        s.grant_root = [0xff; 32];
+        assert!(s.public_inputs().is_err());
+    }
+
+    #[cfg(feature = "verifying-keys")]
+    #[test]
+    fn rejects_a_one_input_ring_key_and_undecodable_proof_points() {
+        use crate::{key_catalog::RingCircuit, verifying_key, CustomRingError, CustomRingProof};
+        use bytemuck::Zeroable;
+
+        let key = verifying_key(RingCircuit::RegisterKey).unwrap();
+        let s = statement();
+        let proof = CustomRingProof::zeroed();
+        assert_eq!(
+            SpawnRoomProof {
+                statement: &s,
+                proof: &proof,
+                key
+            }
+            .verify(),
+            Err(CustomRingError::UnsupportedCircuit.into())
+        );
+
+        // Shape-only fixture for error paths before pairings. It cannot establish a valid proof.
+        let ic = [key.vk_ic[0]; 4];
+        let shaped = groth16_solana::groth16::Groth16Verifyingkey {
+            nr_pubinputs: 2,
+            vk_ic: &ic,
+            ..*key
+        };
+        let no_commitment = groth16_solana::groth16::Groth16Verifyingkey {
+            vk_commitment: None,
+            ..shaped
+        };
+        assert_eq!(
+            SpawnRoomProof {
+                statement: &s,
+                proof: &proof,
+                key: &no_commitment
+            }
+            .verify(),
+            Err(CustomRingError::UnsupportedCircuit.into())
+        );
+        let mut malformed = proof;
+        malformed.commitment_pok = [0x10; 32];
+        assert_eq!(
+            SpawnRoomProof {
+                statement: &s,
+                proof: &malformed,
+                key: &shaped
+            }
+            .verify(),
+            Err(CustomRingError::InvalidRingProofPoint.into())
+        );
+    }
+}
