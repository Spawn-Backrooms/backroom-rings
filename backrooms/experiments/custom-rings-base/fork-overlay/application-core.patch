+
+const configPath = process.env.SPAWN_JOURNEY_CONFIG;
+const requestedPhase = process.env.SPAWN_NATIVE_WORKER_PHASE;
+const coordinatorPid = Number(process.env.SPAWN_NATIVE_COORDINATOR_PID);
+if (
+  configPath === undefined ||
+  !["first", "recovery", "revocation"].includes(requestedPhase ?? "") ||
+  !Number.isSafeInteger(coordinatorPid) ||
+  coordinatorPid <= 0 ||
+  coordinatorPid === process.pid
+)
+  throw new Error("native worker requires a distinct coordinator and explicit local job");
+const phase = requestedPhase as NativeWorkerPhase;
+const config = JSON.parse(await readFile(configPath, "utf8")) as JourneyConfig;
+const tracePath = process.env.SPAWN_NATIVE_WORKER_TRACE_PATH;
+if (tracePath === undefined || !resolve(tracePath).startsWith(`${resolve(config.workDirectory)}/`))
+  throw new Error("native worker requires an owned attempt trace path");
+const stopAfterReceipt = process.env.SPAWN_NATIVE_WORKER_STOP_AFTER_RECEIPT === "1";
