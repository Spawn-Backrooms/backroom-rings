+      ringProgramID: bytesToBigInt(ringIdField(fixture.ringProgramId)),
+      creationNonce: new Uint8Array(32).fill(4),
+    },
+    seedManifest: new Uint8Array(32).fill(5),
+    fixedMembers: new Uint8Array(32).fill(6),
+    writer: bytesToBigInt(keypair.signingPublicKey().ownerProofInputHash()),
+  });
+  const base = {
+    ringProgramId: fixture.ringProgramId,
+    keys,
+    listSalt: small(1),
+    payer: payer.address,
+    outputTreeId: 0,
+    assets: new AssetRegistry(),
+    state,
+  };
+  return { fixture, signing, keypair, base, payer, writer };
+}
+
+async function measuredTransaction(
+  name: string,
+  instruction: Instruction,
+  signers: readonly KeyPairSigner[],
+) {
+  const signed = await signTransactionWithSigners(
+    signers,
+    compileUnsignedTransaction({
+      feePayer: signers[0]!.address,
+      lifetime: { blockhash: blockhash(signers[0]!.address), lastValidBlockHeight: 100n },
+      computeUnitLimit: 1_400_000,
+      priorityFeeLamports: 1n,
+      instructions: [instruction],
+    }),
+  );
+  const message = getCompiledTransactionMessageDecoder().decode(signed.messageBytes);
+  const size = getTransactionEncoder().encode(signed).length;
+  expect(message.version).toBe(1);
+  expect(size).toBeLessThanOrEqual(TRANSACTION_SIZE_LIMIT);
+  expect(message.header.numSignerAccounts).toBe(signers.length);
+  expect(Object.values(signed.signatures).every((signature) => signature?.length === 64)).toBe(
+    true,
+  );
+  const directory = process.env.SPAWN_ROOM_FIXTURE_DIRECTORY;
+  if (directory !== undefined)
+    await writeFile(
+      join(directory, `${name}.transaction-size.json`),
+      JSON.stringify({
+        version: message.version,
+        serializedBytes: size,
+        instructionBytes: instruction.data?.length,
+        maximumBytes: TRANSACTION_SIZE_LIMIT,
+        signerCount: message.header.numSignerAccounts,
+        accounts: message.staticAccounts.length,
+        proofs: "fixed-size fixture proofs; actual SDK encrypted payload and audit stream",
+      }),
+      { mode: 0o600 },
+    );
+  return message;
+}
+
+async function retainPrivateFixture(name: string, body: Readonly<Record<string, unknown>>) {
+  const directory = process.env.SPAWN_ROOM_FIXTURE_DIRECTORY;
+  if (directory === undefined) return;
+  await mkdir(directory, { recursive: true, mode: 0o700 });
+  await writeFile(join(directory, `${name}.request.json`), stringifySpawnProofRequest(body), {
+    mode: 0o600,
+  });
+}
