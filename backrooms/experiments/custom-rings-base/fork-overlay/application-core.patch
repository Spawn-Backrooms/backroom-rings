+      expect(committed.meta?.err).toBeNull();
+      expect(BigInt(committed.slot)).toBe(observedSlot);
+      expect(getBase64Encoder().encode(committed.transaction[0])).toEqual(
+        getBase64Encoder().encode(savedWireTransaction),
+      );
+    }
+    const recovered = await poll(
+      async (): Promise<{ room: OpenedSpawnRoom; contextSlot: bigint } | undefined> => {
+        const contextSlot = BigInt(
+          await client.solanaRpc.getSlot({ commitment: "confirmed" }).send(),
+        );
+        if (contextSlot < observedSlot) return undefined;
+        await syncRingWallet({ client, wallet, keys, config: { requireSlot: contextSlot } });
+        if (wallet.recoveryCoverage().status !== "Complete") return undefined;
+        const note = wallet
+          .notes()
+          .find(
+            (entry) =>
+              !entry.spent && bytesToHex(entry.outputContext.hash) === job.expectedCommitment,
+          );
+        if (note?.dataHash === undefined) return undefined;
+        const room = verifySpawnRoomNote(
+          {
+            utxo: note.utxo,
+            utxoHash: note.outputContext.hash,
+            nullifierPublicKey: keypair.shieldedAddress().nullifierPublicKey,
+            dataHash: note.dataHash,
+            ...(note.ringDataHash === undefined ? {} : { ringDataHash: note.ringDataHash }),
+            registered: true,
+          },
+          note.outputContext.treeId,
+          domain,
+          note.outputContext.hash,
+        );
+        expect(room.state.revision.toString()).toBe(job.expectedRevision);
+        return { room, contextSlot };
+      },
+      `actual note revision ${job.expectedRevision}`,
+    );
+    // Independently bind the recovered note to the recorded successful transaction.
+    await findSpawnRoomIndexedNote(
+      {
+        client,
+        ringProgramId,
+        signature: observedSignature,
+        slot: observedSlot,
+        commitment: recovered.room.commitment,
+        config: { ...client.indexerConfig, requireSlot: recovered.contextSlot },
+      },
+      { signal: AbortSignal.timeout(30_000) },
+    );
+    const marker = await spawnRoomGenesisAddress(
+      ringProgramId,
+      spawnRoomIdentity(recovered.room.state),
+    );
+    const markerAccount = await client.getAccount(marker);
+    expect(markerAccount?.owner).toBe(ringProgramId);
+    expect(markerAccount?.data).toEqual(new TextEncoder().encode("SPRGEN01"));
+    const authority = new ReferenceAuthority(records);
+    const adapter = new SpawnRoomNativeAdapter(authority, records, domain, residents);
+    const view = spawnRoomNativeView({
+      room: recovered.room,
+      uniqueAddress: bytesToHex(addressBytes(marker, "marker")),
+      operationId: job.previousOperationId ?? "genesis",
+      observed: {
+        recoveryStatus: "Complete",
+        signature: observedSignature,
+        slot: observedSlot,
+        contextSlot: recovered.contextSlot,
+      },
+    });
+    trace.recovered = {
+      commitment: bytesToHex(recovered.room.commitment),
+      revision: recovered.room.state.revision.toString(),
+      contextSlot: recovered.contextSlot.toString(),
+      coverage: "Complete",
+    };
+    let expectedLesson = "";
+    if (phase !== "first") {
+      expect(job.previousOperationId).toBeDefined();
+      expect(job.previousProcessId).toBeGreaterThan(0);
+      const previous = await adapter.read(job.previousOperationId!);
+      expect(previous).toBeDefined();
+      if (previous === undefined) throw new Error("accepted original and grant missing");
+      expect(encodeSpawnRoomState(previous.nextState)).toEqual(
+        encodeSpawnRoomState(recovered.room.state),
+      );
+      expect(await authority.getOriginalResult(previous.binding.episodeId)).toEqual(
+        previous.original,
+      );
+      if (job.resumeInterruptedCommit) {
+        await adapter.retainConfirmed(previous.authorization.operationId, recovered.room, {
+          recoveryStatus: "Complete",
+          signature: observedSignature,
+          slot: observedSlot,
+          contextSlot: recovered.contextSlot,
+        });
+        trace.interruptedCommit = {
+          receiptAbsentOnEntry,
+          savedSignature: observedSignature,
+          observedSlot: observedSlot.toString(),
+          savedFrameMatchesLedger: true,
+          receiptRetained: true,
+        };
+      }
+      const receipt = (await records.read(`receipt/${previous.authorization.operationId}`))?.value;
+      expect(receipt?.authorization).toEqual(previous.authorization);
+      expect(receipt?.room.checkpoint).toEqual(view.checkpoint);
+      expect(receipt?.room.protocolVersion).toBe("backrooms.v0");
+      expect(residents.inferenceCalls).toBe(0);
+      trace.prior = {
+        processId: job.previousProcessId!,
+        originalResultCommitment: previous.original.originalResultCommitment,
+        grantLeaf: bytesToHex(previous.grantLeaf),
+        acceptanceNonceHash: bytesToHex(sha256(hexToBytes(previous.authorization.acceptanceNonce))),
+        inferenceCallsBeforeTask: residents.inferenceCalls,
+      };
+      expectedLesson = previous.original.proposal.lesson;
+      if (job.resumeInterruptedCommit && stopAfterReceipt)
+        throw new Error("spawn_worker_after_receipt_interruption");
+    }
+    const binding: NativeEpisodeBinding = job.binding ?? {
+      roomId: view.checkpoint.roomId,
+      episodeId: job.nextEpisode!.episodeId,
+      episodeCommitment: job.nextEpisode!.episodeCommitment,
+      predecessor: view.checkpoint,
+      ordinal: (recovered.room.state.revision + 1n).toString(),
+      minimumConfirmedSlot: observedSlot.toString(),
+      residentIds: job.residentIds,
+    };
+    expect(binding.predecessor).toEqual(view.checkpoint);
+    await authority.resolveEpisode(binding);
+    const priorOriginal = await authority.getOriginalResult(binding.episodeId);
+    const original =
+      priorOriginal ??
+      (await authority.captureOriginalResult(binding, await residents.run(binding, view)));
+    trace.originalReused = priorOriginal !== undefined;
+    const investigator = JSON.parse(original.investigator) as {
+      selectedProcedure: number;
+      value: number;
+      lessonUsed: string;
+    };
+    expect(investigator).toMatchObject({
+      selectedProcedure: phase === "first" ? 0 : 1,
+      value: phase === "first" ? 9 : 5,
+      lessonUsed: expectedLesson,
+    });
+    const retainedAuthorization = (await records.read(`authorization/${binding.episodeId}`))?.value;
+    const priorAcceptance =
+      retainedAuthorization === undefined
+        ? undefined
+        : await adapter.read(retainedAuthorization.operationId);
+    const pending =
+      priorAcceptance ??
+      (await adapter.prepare({
+        binding,
+        room: recovered.room,
+        grantEpoch: (await fetchSpawnRoomConfig(client, ringProgramId)).grantEpoch + 1n,
+      }));
+    expect(pending.binding).toEqual(binding);
+    expect(pending.original).toEqual(original);
+    expect(encodeSpawnRoomState(pending.oldState)).toEqual(
+      encodeSpawnRoomState(recovered.room.state),
+    );
+    const result: NativeWorkerResult = {
+      operationId: pending.authorization.operationId,
+    };
+    const resultKey = `spawn-room-v1/process-result/${phase}`;
+    await records.create(resultKey, result);
+    expect((await records.read(resultKey))?.value).toEqual(result);
+    expect(
+      await records.replace("spawn-room-v1/wallet", retainedWallet.version, wallet.toJson()),
+    ).toBe(true);
+    trace.operationId = result.operationId;
+    trace.task = { ...investigator, inferenceCalls: residents.inferenceCalls };
+    trace.originalResultCommitment = original.originalResultCommitment;
+    trace.grantLeaf = bytesToHex(pending.grantLeaf);
+    trace.acceptanceNonceHash = bytesToHex(
+      sha256(hexToBytes(pending.authorization.acceptanceNonce)),
+    );
+  } catch (error) {
+    failure = error;
+  }
+  try {
+    if (residents !== undefined) {
+      await residents.stop();
+      trace.nativeRuntimeStopped = true;
+    }
+  } catch (error) {
+    failure ??= error;
+  }
+  try {
+    if (records !== undefined) {
+      records.close();
+      trace.recordsClosed = true;
+    }
+  } catch (error) {
+    failure ??= error;
+  }
+  trace.status = failure === undefined ? "passed" : "failed";
+  trace.completedAt = new Date().toISOString();
+  trace.resources = {
+    maxRssKiB: process.resourceUsage().maxRSS,
+    elapsedWallMs: Math.round(process.uptime() * 1_000),
+    taskElapsedWallMs: Math.round(performance.now() - started),
+    platform: process.platform,
+    scope:
+      "maxRSS and elapsedWallMs cover this native worker OS process through receipt finalization; taskElapsedWallMs covers the test body including cleanup; excludes launcher, coordinator, and services",
+  };
+  if (failure !== undefined)
+    trace.error = failure instanceof Error ? failure.message : String(failure);
+  await saveTrace();
+  if (failure !== undefined) throw failure;
+}, 540_000);
diff --git a/sdk-tests/spawn-room/native-worker.ts b/sdk-tests/spawn-room/native-worker.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c27100bab4322cacdd4cc64aa9e023c4c40b3905
--- /dev/null
+++ b/sdk-tests/spawn-room/native-worker.ts
@@ -0,0 +1,266 @@
+/** Separate OS processes execute native episodes; the test process coordinates proofs. */
+import { spawn } from "node:child_process";
+import { mkdtemp, open, readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import type { NativeEpisodeBinding } from "../../sdk-libs/ts/src/experimental/spawn-room/native-adapter.js";
+
+export interface JourneyConfig {
+  rpcUrl: string;
+  photonUrl: string;
+  ringIndexerUrl: string;
+  proverUrl: string;
+  ringRpcUrl: string;
+  ringOrigin: string;
+  ringProgramId: string;
+  enrollmentWriter: string;
+  defaultTreeAddress: string;
+  upgradeAuthorityKeypairPath: string;
+  feePayerKeypairPath: string;
+  publisherKeypairPath: string;
+  workDirectory: string;
+}
+export type NativeWorkerPhase = "first" | "recovery" | "revocation";
+export interface NativeWorkerJob {
+  schema: "spawn-room-native-job-v1";
+  phase: NativeWorkerPhase;
+  coordinatorPid: number;
+  residentIds: NativeEpisodeBinding["residentIds"];
+  binding?: NativeEpisodeBinding;
+  nextEpisode?: { episodeId: string; episodeCommitment: string };
+  expectedCommitment: string;
+  expectedRevision: string;
+  observed: { signature: string; slot?: string };
+  previousOperationId?: string;
+  previousProcessId?: number;
+  resumeInterruptedCommit?: boolean;
+}
+export interface NativeWorkerResult {
+  operationId: string;
+}
+export interface NativeWorkerTrace {
+  schema: "spawn-room-native-process-v1";
+  phase: NativeWorkerPhase;
+  status: "running" | "passed" | "failed";
+  pid: number;
+  ppid: number;
+  coordinatorPid: number;
+  startedAt: string;
+  completedAt?: string;
+  operationId?: string;
+  nativeRuntimeStopped: boolean;
+  recordsClosed: boolean;
+  recovered?: {
+    commitment: string;
+    revision: string;
+    contextSlot: string;
+    coverage: "Complete";
+  };
+  prior?: {
+    processId: number;
+    originalResultCommitment: string;
+    grantLeaf: string;
+    acceptanceNonceHash: string;
+    inferenceCallsBeforeTask: number;
+  };
+  interruptedCommit?: {
+    receiptAbsentOnEntry: boolean;
+    savedSignature: string;
+    observedSlot: string;
+    savedFrameMatchesLedger: true;
+    receiptRetained: true;
+  };
+  task?: { selectedProcedure: number; value: number; lessonUsed: string; inferenceCalls: number };
+  originalResultCommitment?: string;
+  originalReused?: boolean;
+  grantLeaf?: string;
+  acceptanceNonceHash?: string;
+  resources?: {
+    maxRssKiB: number;
+    elapsedWallMs: number;
+    taskElapsedWallMs: number;
+    platform: string;
+    scope: string;
+  };
+  error?: string;
+}
+export interface NativeWorkerRun {
+  trace: NativeWorkerTrace;
+  launcherPid: number;
+  exitCode: 0;
+  exitSignal: null;
+  exitedAt: string;
+  tracePath: string;
+  exitPath: string;
+  logPath: string;
+}
+export class NativeWorkerFailure extends Error {
+  constructor(
+    phase: NativeWorkerPhase,
+    readonly attempt: {
+      trace?: NativeWorkerTrace;
+      launcherPid?: number;
+      exitCode: number | null;
+      exitSignal: NodeJS.Signals | null;
+      timedOut: boolean;
+      exitedAt: string;
+      tracePath: string;
+      exitPath: string;
+      logPath: string;
+    },
+  ) {
+    super(`native ${phase} worker failed; inspect ${attempt.logPath}`);
+  }
+}
+
+/** Only job identity crosses IPC; private inputs and results stay encrypted on disk. */
+export async function runNativeWorker(input: {
+  configPath: string;
+  config: JourneyConfig;
+  nativeRoot: string;
+  phase: NativeWorkerPhase;
+  stopAfterReceipt?: boolean;
+}): Promise<NativeWorkerRun> {
+  const started = performance.now();
+  const attemptDirectory = await mkdtemp(
+    join(input.config.workDirectory, `native-process-${input.phase}-`),
+  );
+  const tracePath = join(attemptDirectory, "trace.json");
+  const exitPath = join(attemptDirectory, "exit.json");
+  const logPath = join(attemptDirectory, "worker.log");
+  const resultsPath = join(attemptDirectory, "vitest.json");
+  const log = await open(logPath, "wx", 0o600);
+  const environment = { ...process.env };
+  // The nested runner must not inherit the coordinator's Vitest worker identity.
+  for (const key of Object.keys(environment))
+    if (key.startsWith("VITEST") || key.startsWith("VITE_")) delete environment[key];
+  const child = spawn(
+    process.execPath,
+    [
+      fileURLToPath(new URL("../../node_modules/vitest/vitest.mjs", import.meta.url)),
+      "run",
+      "--config",
+      fileURLToPath(new URL("./vitest.config.ts", import.meta.url)),
+      fileURLToPath(new URL("./native-worker.test.ts", import.meta.url)),
+      "--maxWorkers=1",
+      "--pool=forks",
+      "--reporter=json",
+      "--outputFile",
+      resultsPath,
+    ],
+    {
+      cwd: fileURLToPath(new URL("../../", import.meta.url)),
+      env: {
+        ...environment,
+        SPAWN_JOURNEY_CONFIG: input.configPath,
+        SPAWN_REFERENCE_HOST_ROOT: input.nativeRoot,
+        SPAWN_NATIVE_WORKER_PHASE: input.phase,
+        SPAWN_NATIVE_COORDINATOR_PID: process.pid.toString(),
+        SPAWN_NATIVE_WORKER_TRACE_PATH: tracePath,
+        SPAWN_NATIVE_WORKER_STOP_AFTER_RECEIPT: input.stopAfterReceipt ? "1" : "0",
+      },
+      stdio: ["ignore", log.fd, log.fd],
+    },
+  );
+  let timedOut = false;
+  const timeout = setTimeout(() => {
+    timedOut = true;
+    child.kill("SIGTERM");
+  }, 600_000);
+  const stop = () => child.kill("SIGTERM");
+  process.once("SIGTERM", stop);
+  process.once("SIGINT", stop);
+  let exit: { code: number | null; signal: NodeJS.Signals | null };
+  try {
+    exit = await new Promise((accept, reject) => {
+      child.once("error", reject);
+      child.once("close", (code, signal) => accept({ code, signal }));
+    });
+  } finally {
+    clearTimeout(timeout);
+    process.removeListener("SIGTERM", stop);
+    process.removeListener("SIGINT", stop);
+    await log.close();
+  }
+  const exitedAt = new Date().toISOString();
+  await writeFile(
+    exitPath,
+    JSON.stringify({
+      schema: "spawn-room-native-process-exit-v1",
+      phase: input.phase,
+      coordinatorPid: process.pid,
+      launcherPid: child.pid,
+      code: exit.code,
+      signal: exit.signal,
+      timedOut,
+      exitedAt,
+      elapsedWallMs: Math.round(performance.now() - started),
+      durationScope: "native worker Vitest launch through observed process exit",
+      tracePath,
+      logPath,
+    }),
+    { mode: 0o600 },
+  );
+  if (timedOut || exit.code !== 0 || exit.signal !== null) {
+    let trace: NativeWorkerTrace | undefined;
+    try {
+      trace = JSON.parse(await readFile(tracePath, "utf8")) as NativeWorkerTrace;
+    } catch {
+      // A worker that dies before writing a trace has no recoverable evidence.
+    }
+    throw new NativeWorkerFailure(input.phase, {
+      ...(trace === undefined ? {} : { trace }),
+      ...(child.pid === undefined ? {} : { launcherPid: child.pid }),
+      exitCode: exit.code,
+      exitSignal: exit.signal,
+      timedOut,
+      exitedAt,
+      tracePath,
+      exitPath,
+      logPath,
+    });
+  }
+  const results = JSON.parse(await readFile(resultsPath, "utf8")) as {
+    success: boolean;
+    numPassedTests: number;
+    numFailedTests: number;
+    numPendingTests: number;
+    numTodoTests: number;
+  };
+  if (
+    !results.success ||
+    results.numPassedTests !== 1 ||
+    results.numFailedTests !== 0 ||
+    results.numPendingTests !== 0 ||
+    results.numTodoTests !== 0
+  )
+    throw new Error(`native ${input.phase} worker did not execute its assertion`);
+  const trace = JSON.parse(await readFile(tracePath, "utf8")) as NativeWorkerTrace;
+  if (
+    trace.schema !== "spawn-room-native-process-v1" ||
+    trace.phase !== input.phase ||
+    trace.status !== "passed" ||
+    !Number.isSafeInteger(trace.pid) ||
+    trace.pid === process.pid ||
+    trace.coordinatorPid !== process.pid ||
+    !trace.nativeRuntimeStopped ||
+    !trace.recordsClosed ||
+    trace.operationId === undefined ||
+    trace.completedAt === undefined ||
+    trace.resources === undefined ||
+    trace.resources.maxRssKiB <= 0 ||
+    trace.resources.elapsedWallMs <= 0 ||
+    child.pid === undefined
+  )
+    throw new Error(`invalid native ${input.phase} process trace`);
+  return {
+    trace,
+    launcherPid: child.pid,
+    exitCode: 0,
+    exitSignal: null,
+    exitedAt,
+    tracePath,
+    exitPath,
+    logPath,
+  };
+}
