+);
+const { FlueResidents } = await import(pathToFileURL(join(nativeRoot, "residents.ts")).href);
+
+async function poll<T>(read: () => Promise<T | undefined>, description: string): Promise<T> {
+  const until = Date.now() + 240_000;
+  for (;;) {
+    const found = await read();
+    if (found !== undefined) return found;
+    if (Date.now() > until) throw new Error(`worker timed out waiting for ${description}`);
+    await new Promise((accept) => setTimeout(accept, 500));
+  }
+}
