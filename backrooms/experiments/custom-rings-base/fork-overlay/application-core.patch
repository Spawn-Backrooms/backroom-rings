+package transfer_test
+
+import (
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/test"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringaudit"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringtransfer"
+)
+
+// This uses the actual upstream audit, policy, tracking and transaction builders.
+// It solves the full ring constraint system, not a proof or a validator transaction.
+func spawnZeroValueWorld(t testing.TB) ringtransfer.Anonymous {
+	t.Helper()
+	shape := transfer.Shape{Inputs: 24, Outputs: 2, Withdrawals: 4, Owners: 4}
+	a := ringaudit.NewAudit(t, shape.Stream())
+	w := ringtransfer.Hidden(shape)
+	w.Omitted = 1
+	w.Inputs = []ringaudit.Input{{
+		Utxo: ringaudit.SpentUtxo(t, ringtransfer.Sender(t), ringtransfer.SenderNullifierPk(t), a.RingProgramID, 0, 51),
+		OwnerKey: ringtransfer.SenderKey(), Mint: ringaudit.FixtureMint,
+	}}
+	w.Outputs = map[int]func(*ringaudit.Slot){0: func(slot *ringaudit.Slot) {
+		slot.Utxo.Amount = 0
+		slot.Utxo.OwnerPkHash = ringtransfer.Sender(t)
+		slot.Utxo.NullifierPk = ringtransfer.SenderNullifierPk(t)
+		slot.OwnerKey = ringtransfer.SenderKey()
+	}}
+	return w
+}
+
+func TestSpawnRoomFullHiddenZeroValueWitness(t *testing.T) {
+	b := spawnZeroValueWorld(t).Build(t)
+	c := &transfer.SpawnRoomAdvanceCircuit{TransferCircuit: *b.Circuit}
+	if err := test.IsSolved(c, c, ecc.BN254.ScalarField()); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestSpawnRoomFullRejectsOtherwiseValidPublicOwnerRail(t *testing.T) {
+	w := spawnZeroValueWorld(t)
+	w.Rail = ringtransfer.PublicOwners
+	b := w.Build(t)
+	if err := test.IsSolved(b.Circuit, b.Circuit, ecc.BN254.ScalarField()); err != nil {
+		t.Fatalf("invalid upstream control witness: %v", err)
+	}
+	c := &transfer.SpawnRoomAdvanceCircuit{TransferCircuit: *b.Circuit}
+	if err := test.IsSolved(c, c, ecc.BN254.ScalarField()); err == nil {
+		t.Fatal("accepted public-owner rail")
+	}
+}
+
+func TestSpawnRoomFullRejectsOtherwiseValidOwnerChange(t *testing.T) {
+	w := spawnZeroValueWorld(t)
+	w.Outputs[0] = func(slot *ringaudit.Slot) { slot.Utxo.Amount = 0 }
+	b := w.Build(t)
+	if err := test.IsSolved(b.Circuit, b.Circuit, ecc.BN254.ScalarField()); err != nil {
+		t.Fatalf("invalid upstream control witness: %v", err)
+	}
+	c := &transfer.SpawnRoomAdvanceCircuit{TransferCircuit: *b.Circuit}
+	if err := test.IsSolved(c, c, ecc.BN254.ScalarField()); err == nil {
+		t.Fatal("accepted a different successor owner")
+	}
+}
diff --git a/prover/circuits/transfer/spawn_room_genesis.go b/prover/circuits/transfer/spawn_room_genesis.go
new file mode 100644
index 0000000000000000000000000000000000000000..1c2bf588d70a8d82f9588a67796c7876cc4a1609
--- /dev/null
+++ b/prover/circuits/transfer/spawn_room_genesis.go
@@ -0,0 +1,110 @@
+package transfer
+
+import (
+	"errors"
+
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/shared"
+	"github.com/helius-labs/zolana/prover/server/circuits/gadget"
+	transaction "github.com/helius-labs/zolana/prover/server/circuits/spp_transaction/shared"
+)
+
+const SpawnRoomGenesisDomain = 0x53505247 // SPRG
+
+type SpawnRoomGenesisContext struct {
+	Network                      SpawnDigest
+	ApplicationID, RingProgramID frontend.Variable
+}
+
+// SpawnRoomGenesisCircuit is a distinct visible creation operation. The program
+// must atomically create a permanent marker for State.Identity and settle this
+// exact frame. Subsequent hidden advances do not read or publish that marker.
+type SpawnRoomGenesisCircuit struct {
+	TransferCircuit
+	GenesisStatementHash frontend.Variable `gnark:",public"`
+	Context              SpawnRoomGenesisContext
+	State                SpawnRoomState
+}
+
+func NewSpawnRoomGenesisCircuit(shape Shape) (*SpawnRoomGenesisCircuit, error) {
+	if shape.Entry {
+		return nil, errors.New("room genesis cannot use entry keys")
+	}
+	base, err := NewTransferCircuit(shape)
+	if err != nil {
+		return nil, err
+	}
+	return &SpawnRoomGenesisCircuit{TransferCircuit: *base}, nil
+}
+
+func (c *SpawnRoomGenesisCircuit) Define(api frontend.API) error {
+	if c.Shape.Entry {
+		return errors.New("room genesis cannot use entry keys")
+	}
+	if err := c.TransferCircuit.Define(api); err != nil {
+		return err
+	}
+	api.AssertIsEqual(c.Hidden, 0)
+	api.AssertIsEqual(c.InProof, 0)
+	api.AssertIsEqual(c.Delegate, 0)
+	api.AssertIsEqual(c.SignerCount, 1)
+	api.AssertIsEqual(c.Signers[0], c.State.Writer)
+	api.AssertIsEqual(c.Shape.Stream().AssertLayout(api, c.Layout), 0)
+	api.AssertIsEqual(api.IsZero(c.PolicyHash), 0)
+	api.AssertIsEqual(api.IsZero(c.TrackingRoot), 0)
+	api.AssertIsEqual(c.WithdrawalCount, 0)
+	for i := range c.PublicAmounts {
+		api.AssertIsEqual(c.PublicAmounts[i], 0)
+		api.AssertIsEqual(c.PublicGross[i], 0)
+	}
+	emptyAddresses := make([]frontend.Variable, len(c.Inputs))
+	for i := range c.Inputs {
+		api.AssertIsEqual(c.Inputs[i].Domain, transaction.DummyDomain)
+		emptyAddresses[i] = 0
+	}
+	api.AssertIsEqual(c.AddressChain, gadget.NonZeroHashChain(api, emptyAddresses))
+	for _, output := range c.Outputs[1:] {
+		api.AssertIsEqual(output.Output.Domain, transaction.DummyDomain)
+	}
+	output := c.Outputs[0].Output.OpenSlot(api)
+	api.AssertIsEqual(output.Utxo, 1)
+	api.AssertIsEqual(output.Ring, 1)
+	api.AssertIsEqual(output.Amount, 0)
+	api.AssertIsEqual(output.RingDataHash, 0)
+	api.AssertIsEqual(output.RingProgramID, c.RingProgramID)
+	api.AssertIsEqual(api.IsZero(output.NullifierPk), 0)
+	api.AssertIsEqual(api.IsZero(api.Sub(output.NullifierPk, shared.ZeroNullifierPk)), 0)
+	api.AssertIsEqual(output.OwnerPkHash, c.State.Writer)
+	api.AssertIsEqual(c.Context.RingProgramID, c.RingProgramID)
+	api.AssertIsEqual(api.IsZero(c.Context.ApplicationID), 0)
+	api.AssertIsEqual(api.IsZero(c.Context.RingProgramID), 0)
+	c.State.Binding.Network.assertEqual(api, c.Context.Network)
+	api.AssertIsEqual(c.State.Binding.ApplicationID, c.Context.ApplicationID)
+	api.AssertIsEqual(c.State.Binding.RingProgramID, c.Context.RingProgramID)
+	for _, digest := range []SpawnDigest{c.State.Binding.CreationNonce, c.State.SeedManifest, c.State.FixedMembers} {
+		api.AssertIsEqual(api.Mul(api.IsZero(digest[0]), api.IsZero(digest[1])), 0)
+	}
+	api.AssertIsEqual(c.State.Revision, 0)
+	api.AssertIsEqual(c.State.Predecessor, 0)
+	api.AssertIsEqual(c.State.Authorization, 0)
+	api.AssertIsEqual(c.State.LastAuthorizationEpoch, 0)
+	api.AssertIsEqual(c.State.Memory.Length, 0)
+	for _, digest := range []SpawnDigest{c.State.Memory.Episode, c.State.Memory.OriginalResult, c.State.Memory.Candidate} {
+		for _, limb := range digest {
+			api.AssertIsEqual(limb, 0)
+		}
+	}
+	for _, score := range c.State.Policy.Scores {
+		api.AssertIsEqual(score, 50)
+	}
+	api.AssertIsEqual(output.DataHash, c.State.Hash(api))
+	api.AssertIsEqual(c.GenesisStatementHash, SpawnRoomGenesisStatement(api, c.PublicInputHash, c.Context, c.State.Identity(api), c.State.Writer))
+	return nil
+}
+
+func SpawnRoomGenesisStatement(api frontend.API, upstream frontend.Variable, context SpawnRoomGenesisContext, identity, writer frontend.Variable) frontend.Variable {
+	return gadget.HashChain4(api, []frontend.Variable{
+		SpawnRoomGenesisDomain, context.Network[0], context.Network[1], context.ApplicationID, context.RingProgramID,
+		upstream, identity, writer, SpawnRoomSchema, 10,
+	})
+}
