+      '--metrics-address', `127.0.0.1:${ports.metrics}`, '--keys-dir', join(workDirectory, 'proving-keys'),
+      '--indexer-url', urls.ringIndexer, '--indexer-concurrency', '1', '--transfer-concurrency', '1', '--batch-max', '1',
+      '--server-only', '--auto-download=false']);
+    await ready('app prover', () => httpOk(`${urls.prover}/health`));
+    const kms = await service('localnet-kms', process.execPath, [join(APP_ROOT, 'tools/localnet-kms.mjs'), '0']);
