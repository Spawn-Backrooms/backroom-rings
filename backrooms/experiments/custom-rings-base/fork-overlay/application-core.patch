+  return {
+    programAddress: input.program,
+    accounts: [signer(input.publisher), writable(await spawnRoomConfigAddress(input.program))],
+    data: Uint8Array.of(
+      SpawnRoomInstructionTag.updateGrantRoot,
+      ...epochBytes(input.expectedEpoch),
+      ...spawnScalarBytes(input.newRoot),
+    ),
+  };
+}
+
+function frameProfile(proven: ProvenRingTransfer, state: SpawnRoomState, genesis: boolean): void {
+  const frame = proven.data;
+  const output = proven.outputs[0];
+  if (
+    frame.rail !== "anonymous" ||
+    frame.publicOwners !== genesis ||
+    frame.noSpend !== genesis ||
+    frame.entry ||
+    frame.vouched ||
+    frame.interfaceTransfers.length !== 0 ||
+    frame.extensions.dataHash !== undefined ||
+    frame.extensions.ringDataHash !== undefined ||
+    (frame.extensions.messages?.length ?? 0) !== 0 ||
+    frame.extensions.cache !== undefined ||
+    proven.accounts.delegate !== undefined ||
+    proven.accounts.withdrawal !== undefined ||
+    (proven.accounts.deposits?.length ?? 0) !== 0 ||
+    proven.accounts.cache !== undefined
