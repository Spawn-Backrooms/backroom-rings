+
+fn pda(program: &Address, seeds: &[&[u8]]) -> Address {
+    Address::find_program_address(seeds, program).0
+}
+
+fn config(publisher: Address) -> SpawnRoomConfig {
+    SpawnRoomConfig::new(
+        InitializeConfig {
+            network: [7; 32],
+            application_id: [1; 32],
+            grant_root: [2; 32],
+        },
+        publisher,
+    )
+    .unwrap()
+}
+
+#[test]
+fn generic_settlement_and_delegate_tags_are_refused_at_the_entrypoint() {
+    let p = Address::new_from_array([7; 32]);
+    for tag in [
+        tag::TRANSFER,
+        tag::AUTHORITY_TRANSFER,
+        tag::MERGE,
+        tag::SET_DELEGATE,
+        255,
+    ] {
+        assert!(process_instruction(&p, &mut [], &[tag]).is_err());
+    }
+    for tag in [
+        tag::TRANSFER,
+        tag::AUTHORITY_TRANSFER,
+        tag::MERGE,
+        tag::SET_DELEGATE,
+    ] {
+        assert_eq!(
+            process_instruction(&p, &mut [], &[tag]),
+            Err(ProgramError::InvalidInstructionData)
+        );
+    }
+}
+
+#[test]
+fn grant_update_checks_the_real_signer_owner_and_config_address_before_mutation() {
+    let program = Address::new_from_array([7; 32]);
+    let publisher = Address::new_from_array([9; 32]);
+    let other = Address::new_from_array([4; 32]);
+    let address = pda(&program, &[CONFIG_SEED]);
+    let config = config(publisher);
+    let bytes = bytemuck::bytes_of(&config);
+    let mut ix = vec![UPDATE_GRANT_ROOT];
+    ix.extend(
+        wincode::serialize(&UpdateGrantRoot {
+            expected_epoch: 0,
+            new_root: [3; 32],
+        })
+        .unwrap(),
+    );
+    for (signer, signed, owner, address, writable) in [
+        (other, true, program, address, true),
+        (publisher, false, program, address, true),
+        (publisher, true, other, address, true),
+        (publisher, true, program, other, true),
+        (publisher, true, program, address, false),
+    ] {
+        let mut accounts = [
+            fixture(signer, Address::default(), signed, false, &[]),
+            fixture(address, owner, false, writable, bytes),
+        ];
+        assert!(process_instruction(&program, &mut accounts, &ix).is_err());
+        assert_eq!(&*accounts[1].try_borrow().unwrap(), bytes);
+    }
+    let mut accounts = [
+        fixture(publisher, Address::default(), true, false, &[]),
+        fixture(address, program, false, true, bytes),
+    ];
+    process_instruction(&program, &mut accounts, &ix).unwrap();
+    let saved = accounts[1].try_borrow().unwrap().to_vec();
+    let updated: SpawnRoomConfig = bytemuck::pod_read_unaligned(&saved);
+    assert_eq!((updated.epoch(), updated.grant_root), (1, [3; 32]));
+    assert!(process_instruction(&program, &mut accounts, &ix).is_err());
+    assert_eq!(&*accounts[1].try_borrow().unwrap(), &saved);
+}
+
+#[test]
+fn duplicate_genesis_refuses_the_permanent_marker_before_settlement() {
+    let program = Address::new_from_array([7; 32]);
+    let writer = Address::new_from_array([9; 32]);
+    let identity = [1; 32];
+    let mut accounts = [
+        fixture(
+            pda(&program, &[CONFIG_SEED]),
+            program,
+            false,
+            false,
+            bytemuck::bytes_of(&config(writer)),
+        ),
+        fixture(writer, Address::default(), true, false, &[]),
+        fixture(
+            pda(&program, &[GENESIS_SEED, &identity]),
+            program,
+            false,
+            true,
+            &GENESIS_DISCRIMINATOR,
+        ),
+        fixture(
+            Address::new_from_array([6; 32]),
+            Address::default(),
+            true,
+            true,
+            &[],
+        ),
+        fixture(pinocchio_system::ID, Address::default(), false, false, &[]),
+    ];
+    let mut ix = vec![CREATE_ROOM];
+    ix.extend(identity);
+    assert_eq!(
+        process_instruction(&program, &mut accounts, &ix),
+        Err(ProgramError::AccountAlreadyInitialized)
+    );
+    assert_eq!(&*accounts[2].try_borrow().unwrap(), &GENESIS_DISCRIMINATOR);
+}
diff --git a/programs/custom-ring/tests/spawn_room_proofs.rs b/programs/custom-ring/tests/spawn_room_proofs.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f36dc96fc4a6f0884b4fe60bf2258533824c2824
--- /dev/null
+++ b/programs/custom-ring/tests/spawn_room_proofs.rs
@@ -0,0 +1,133 @@
+//! Round trips the full Go circuits' localnet Groth16 proofs through the program's verifier.
+#![cfg(feature = "spawn-room-v1-localnet-keys")]
+
+use custom_ring_interface::{
+    key_catalog::RingCircuit,
+    spawn_room::{SpawnRoomGenesisStatementV1, SpawnRoomProof, SpawnRoomStatementV1},
+    verifying_key, CustomRingProof, PlainGroth16Proof,
+};
+use serde_json::Value;
+use spr_client::prover::{Proof, ProofCompressed};
+
+mod advance_vk {
+    include!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/src/instructions/spawn_room/keys/advance.rs"
+    ));
+}
+mod genesis_vk {
+    include!(concat!(
+        env!("CARGO_MANIFEST_DIR"),
+        "/src/instructions/spawn_room/keys/genesis.rs"
+    ));
+}
+
+fn field(v: &Value) -> [u8; 32] {
+    let mut bytes = [0; 32];
+    hex::decode_to_slice(v.as_str().unwrap().strip_prefix("0x").unwrap(), &mut bytes).unwrap();
+    bytes
+}
+fn decode(v: &Value) -> CustomRingProof {
+    let encoded = Proof::from_gnark_json(&v["proof"].to_string()).unwrap();
+    let compact = ProofCompressed::try_from(encoded).unwrap();
+    let commitment = compact.commitment.unwrap();
+    CustomRingProof {
+        groth16: PlainGroth16Proof {
+            proof_a: compact.a,
+            proof_b: compact.compressed_b().unwrap(),
+            proof_c: compact.c,
+        },
+        commitment: commitment.commitment,
+        commitment_pok: commitment.commitment_pok,
+    }
+}
+
+#[test]
+fn real_advance_proof_binds_both_public_inputs_and_current_config() {
+    let v: Value = serde_json::from_str(include_str!(
+        "../../../test-vectors/proof/spawn-room-advance-v1.json"
+    ))
+    .unwrap();
+    let receipt = v["publicInputs"].as_array().unwrap();
+    assert_eq!(receipt.len(), 2);
+    let proof = decode(&v);
+    let s = SpawnRoomStatementV1 {
+        network: field(&v["network"]),
+        application_id: field(&v["applicationId"]),
+        ring_program_id: field(&v["ringProgramId"]),
+        upstream_statement: field(&receipt[0]),
+        grant_root: field(&v["grantRoot"]),
+        grant_epoch: v["grantEpoch"].as_u64().unwrap(),
+    };
+    assert_eq!(
+        s.public_inputs().unwrap(),
+        [field(&receipt[0]), field(&receipt[1])]
+    );
+    let verify = |st: &SpawnRoomStatementV1| {
+        SpawnRoomProof {
+            proof: &proof,
+            statement: st,
+            key: &advance_vk::VERIFYINGKEY,
+        }
+        .verify()
+    };
+    verify(&s).unwrap();
+    for mutate in [
+        |s: &mut SpawnRoomStatementV1| s.grant_root[31] ^= 1,
+        |s: &mut SpawnRoomStatementV1| s.grant_epoch ^= 1,
+        |s: &mut SpawnRoomStatementV1| s.network[0] ^= 0x80,
+        |s: &mut SpawnRoomStatementV1| s.application_id[31] ^= 1,
+        |s: &mut SpawnRoomStatementV1| s.ring_program_id[31] ^= 1,
+        |s: &mut SpawnRoomStatementV1| s.upstream_statement[31] ^= 1,
+    ] {
+        let mut changed = s;
+        mutate(&mut changed);
+        assert!(verify(&changed).is_err());
+    }
+    assert!(SpawnRoomProof {
+        proof: &proof,
+        statement: &s,
+        key: verifying_key(RingCircuit::RegisterKey).unwrap()
+    }
+    .verify()
+    .is_err());
+    assert!(SpawnRoomProof {
+        proof: &proof,
+        statement: &s,
+        key: &genesis_vk::VERIFYINGKEY
+    }
+    .verify()
+    .is_err());
+}
+#[test]
+fn real_genesis_proof_binds_marker_identity_and_writer() {
+    let v: Value = serde_json::from_str(include_str!(
+        "../../../test-vectors/proof/spawn-room-genesis-v1.json"
+    ))
+    .unwrap();
+    let receipt = v["publicInputs"].as_array().unwrap();
+    assert_eq!(receipt.len(), 2);
+    let proof = decode(&v);
+    let s = SpawnRoomGenesisStatementV1 {
+        network: field(&v["network"]),
+        application_id: field(&v["applicationId"]),
+        ring_program_id: field(&v["ringProgramId"]),
+        upstream_statement: field(&receipt[0]),
+        creation_identity: field(&v["creationIdentity"]),
+        writer_owner_hash: field(&v["writerOwnerHash"]),
+    };
+    assert_eq!(
+        s.public_inputs().unwrap(),
+        [field(&receipt[0]), field(&receipt[1])]
+    );
+    s.verify(&proof, &genesis_vk::VERIFYINGKEY).unwrap();
+    let mut stale = s;
+    stale.creation_identity[31] ^= 1;
+    assert!(stale.verify(&proof, &genesis_vk::VERIFYINGKEY).is_err());
+    let mut wrong_writer = s;
+    wrong_writer.writer_owner_hash[31] ^= 1;
+    assert!(wrong_writer
+        .verify(&proof, &genesis_vk::VERIFYINGKEY)
+        .is_err());
+    assert!(s.verify(&proof, &advance_vk::VERIFYINGKEY).is_err());
+}
diff --git a/prover/circuits/transfer/spawn_room_advance.go b/prover/circuits/transfer/spawn_room_advance.go
new file mode 100644
index 0000000000000000000000000000000000000000..df99526e5869e57d3972915cc6d29b812eb013ab
--- /dev/null
+++ b/prover/circuits/transfer/spawn_room_advance.go
@@ -0,0 +1,84 @@
+package transfer
+
+import (
+	"errors"
+
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/shared"
+	"github.com/helius-labs/zolana/prover/server/circuits/gadget"
+	transaction "github.com/helius-labs/zolana/prover/server/circuits/spp_transaction/shared"
+)
+
+// SpawnRoomAdvanceCircuit is a separate experimental key family. It must never
+// be accepted as a room application proof without the state and grant relation.
+// The original transfer key family is unchanged.
+type SpawnRoomAdvanceCircuit struct {
+	TransferCircuit
+}
+
+func NewSpawnRoomAdvanceCircuit(shape Shape) (*SpawnRoomAdvanceCircuit, error) {
+	if shape.Entry {
+		return nil, errors.New("room advances cannot spend default-ring notes")
+	}
+	base, err := NewTransferCircuit(shape)
+	if err != nil {
+		return nil, err
+	}
+	return &SpawnRoomAdvanceCircuit{TransferCircuit: *base}, nil
+}
+
+func (c *SpawnRoomAdvanceCircuit) Define(api frontend.API) error {
+	if c.Shape.Entry {
+		return errors.New("room advances cannot use entry keys")
+	}
+	if err := c.TransferCircuit.Define(api); err != nil {
+		return err
+	}
+	api.AssertIsEqual(c.Hidden, 1)
+	api.AssertIsEqual(c.InProof, 0)
+	api.AssertIsEqual(c.Delegate, 0)
+	api.AssertIsEqual(c.SignerCount, 0)
+	api.AssertIsEqual(c.Shape.Stream().AssertLayout(api, c.Layout), 0)
+	api.AssertIsEqual(api.IsZero(c.PolicyHash), 0)
+	api.AssertIsEqual(api.IsZero(c.TrackingRoot), 0)
+	api.AssertIsEqual(c.WithdrawalCount, 0)
+	for i := range c.PublicAmounts {
+		api.AssertIsEqual(c.PublicAmounts[i], 0)
+		api.AssertIsEqual(c.PublicGross[i], 0)
+	}
+	// The base proof already binds these exact wires to the ordered SPP
+	// transaction. Reopening them here cannot introduce a second witness.
+	for _, input := range c.Inputs[1:] {
+		api.AssertIsEqual(input.Domain, transaction.DummyDomain)
+	}
+	for _, output := range c.Outputs[1:] {
+		api.AssertIsEqual(output.Output.Domain, transaction.DummyDomain)
+	}
+	emptyAddresses := make([]frontend.Variable, len(c.Inputs))
+	for i := range emptyAddresses {
+		emptyAddresses[i] = 0
+	}
+	api.AssertIsEqual(c.AddressChain, gadget.NonZeroHashChain(api, emptyAddresses))
+	assertSpawnRoomNotePair(api, c.RingProgramID, c.Inputs[0].OpenSlot(api), c.Outputs[0].Output.OpenSlot(api))
+	return nil
+}
+
+// This relation deliberately does not choose a state codec, grant verifier,
+// or public-input encoding. It is only the nonfinancial note-shape boundary.
+func assertSpawnRoomNotePair(api frontend.API, ringID frontend.Variable, old, next shared.Output) {
+	api.AssertIsEqual(api.IsZero(ringID), 0)
+	for _, note := range []shared.Output{old, next} {
+		api.AssertIsEqual(note.Utxo, 1)
+		api.AssertIsEqual(note.Ring, 1)
+		api.AssertIsEqual(note.Exit, 0)
+		api.AssertIsEqual(note.RingProgramID, ringID)
+		api.AssertIsEqual(note.Amount, 0)
+		api.AssertIsEqual(api.IsZero(note.OwnerPkHash), 0)
+		api.AssertIsEqual(api.IsZero(note.NullifierPk), 0)
+		api.AssertIsEqual(api.IsZero(api.Sub(note.NullifierPk, shared.ZeroNullifierPk)), 0)
+	}
+	api.AssertIsEqual(old.OwnerPkHash, next.OwnerPkHash)
+	api.AssertIsEqual(old.NullifierPk, next.NullifierPk)
+	api.AssertIsEqual(old.Asset, next.Asset)
+	api.AssertIsEqual(api.IsZero(api.Sub(old.Hash, next.Hash)), 0)
+}
