+        if (child.exitCode === null && child.signalCode === null) {
+          try { process.kill(-child.pid, 'SIGKILL'); } catch { /* already exited */ }
+          await Promise.race([new Promise((done) => child.once('exit', done)), delay(5000)]);
+        }
+      }
+      receipt.cleanup.push({ name: row.name, stopped: child.exitCode !== null || child.signalCode !== null });
+    }
+    if (validatorStarted && binaries) {
+      try {
+        const stop = await command('validator-stop', binaries.zolana, ['dev', 'start', '--local', '--stop', '--skip-prover',
+          '--rpc-port', String(ports.rpc), '--photon-port', String(ports.photon)], { allowFailure: true, timeoutMs: 60_000, cwd: workDirectory });
+        receipt.cleanup.push({ name: 'scoped-validator-and-photon', stopped: stop.exitCode === 0 });
+      } catch (error) { receipt.cleanup.push({ name: 'scoped-validator-and-photon', stopped: false, error: error.message }); }
+    }
+    if (portPreflightPassed) {
+      try { await waitForAvailablePorts([...Object.values(ports), ports.rpc + 1, ports.rpc + 2]); }
+      catch { receipt.cleanup.push({ name: 'owned-port-release', stopped: false }); }
+    }
+    if (receipt.cleanup.some((item) => item.stopped === false || item.error)) {
+      receipt.status = 'failed'; receipt.error ??= 'Owned service cleanup did not finish';
+    }
+    receipt.finishedAt = now();
+    for (const { row } of services) { try { row.logSha256 = (await hashFile(row.logPath)).sha256; } catch { /* spawn may have failed */ } }
+    if (receipt.sources && referenceHostRoot) {
+      try {
+        receipt.sources.after = { application: await sourceManifest(APP_ROOT), referenceHost: await sourceManifest(dirname(referenceHostRoot)) };
+        receipt.sources.unchanged = ['application', 'referenceHost'].every((name) => receipt.sources.before[name].sha256 === receipt.sources.after[name].sha256);
+        receipt.sources.appZolanaUnchanged = git(join(APP_ROOT, 'zolana'), 'rev-parse', 'HEAD') === ZOLANA_PIN &&
+          !git(join(APP_ROOT, 'zolana'), 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none');
+        receipt.sources.referenceHostUnchanged = git(referenceHostRoot, 'rev-parse', 'HEAD') === BACKROOMS_PIN &&
+          !git(referenceHostRoot, 'status', '--porcelain=v1', '--untracked-files=all', '--ignore-submodules=none');
+        receipt.sources.unchanged &&= receipt.sources.appZolanaUnchanged && receipt.sources.referenceHostUnchanged;
+        if (!receipt.sources.unchanged) { receipt.status = 'failed'; receipt.error ??= 'Application or reference-host source changed during this run'; }
+      } catch (error) { receipt.status = 'failed'; receipt.error ??= `Source receipt failed: ${error.message}`; }
+    }
+    receipt.measurements = await measurement.stop();
+    await save();
+    process.off('SIGINT', onInt); process.off('SIGTERM', onTerm);
+  }
+  console.log(`Localnet ${receipt.status}: ${receiptPath}`);
+  if (receipt.status !== 'passed') throw new Error(receipt.error ?? 'Localnet journey failed');
+  return receipt;
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  const args = process.argv.slice(2);
+  if (args.length === 1 && ['--help', '-h'].includes(args[0])) {
+    console.log('Usage: node tools/run-spawn-room-localnet.mjs --config CONFIG.json\n' +
+      'Required config: {"disposableLocalnet":true,"nativeRepo":"/absolute/clean/custom-rings"}.\n' +
+      'Optional: applicationKeysDirectory, nativeKeysDirectory, programId, programSo, referenceHostRoot, workParent, ports, binaries.\n' +
+      'Build prerequisites and prepare the application keys first. See tools/spawn-room-localnet.md.');
