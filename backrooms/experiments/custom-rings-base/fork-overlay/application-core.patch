@@ -0,0 +1,140 @@
+/** Adversarial frames reuse real proofs; this file never builds a proof witness. */
+import { AccountRole, type Address, type Instruction } from "@solana/kit";
+import { SHIELDED_POOL_PROGRAM_ID, type Bytes32 } from "@heliuslabs/spr";
+import { equalBytes, SYSTEM_PROGRAM } from "@heliuslabs/spr/internal";
+import {
+  ringTransactInstruction,
+  type ProvenRingTransfer,
+} from "../../sdk-libs/ts/src/operations/workflow/pipeline.js";
+import { RingTransactData } from "../../sdk-libs/ts/src/protocol/transaction/transact.js";
+import { spawnRoomConfigAddress } from "../../sdk-libs/ts/src/experimental/spawn-room/instructions.js";
+
+export interface SpawnRoomLiveRefusal {
+  readonly name: string;
+  readonly scope: string;
+  readonly instruction: Instruction;
+  readonly error: string | { readonly Custom: number };
+  readonly sppInvoked: boolean;
+}
+
+export async function spawnRoomLiveRefusals(input: {
+  readonly advance: ProvenRingTransfer;
+  readonly wrongOperationProof: Uint8Array;
+  readonly marker: Address;
+  readonly peerNullifier: Bytes32;
+  readonly peerCommitment: Bytes32;
+}): Promise<readonly SpawnRoomLiveRefusal[]> {
+  const { advance } = input;
+  const config = await spawnRoomConfigAddress(advance.ringProgramId);
+  const encode = async (data: RingTransactData): Promise<Instruction> => {
+    // Rebuild settlement/nullifier accounts for the mutated frame. A nullifier
+    // substitution must not fail merely because it retained the old PDA.
+    const ordinary = await ringTransactInstruction(advance.ringProgramId, advance.accounts, data);
+    return {
+      ...ordinary,
+      accounts: [{ address: config, role: AccountRole.READONLY }, ...ordinary.accounts!],
+      data: Uint8Array.of(0x83, ...ordinary.data!.subarray(1)),
+    };
+  };
+  const valid = await encode(advance.data);
+  const firstOutput = advance.data.outputs[0];
+  const firstNullifier = advance.data.nullifiers[0];
+  if (
+    firstOutput?.body.kind !== "recipient" ||
+    firstOutput.body.payload.length === 0 ||
+    firstNullifier === undefined ||
+    advance.data.envelope.length !== 33 ||
+    input.wrongOperationProof.length !== advance.data.proof.length ||
+    equalBytes(input.wrongOperationProof, advance.data.proof) ||
+    equalBytes(input.peerNullifier, firstNullifier) ||
+    equalBytes(input.peerCommitment, firstOutput.hash)
+  )
+    throw new Error("spawn_live_refusal_fixture");
+
+  const replaceAccount = (index: number, address: Address): Instruction => ({
+    ...valid,
+    accounts: valid.accounts!.map((account, at) =>
+      at === index ? { ...account, address } : account,
+    ),
+  });
+  const sppAccounts = valid.accounts!
+    .map((account, index) => ({ account, index }))
+    .filter(({ account }) => account.address === SHIELDED_POOL_PROGRAM_ID);
+  if (sppAccounts.length !== 1) throw new Error("spawn_live_spp_account_count");
+  const envelope = advance.data.envelope.slice();
+  envelope.set(advance.data.envelope.subarray(16, 32), 0);
+  envelope.set(advance.data.envelope.subarray(0, 16), 16);
+  const payload = firstOutput.body.payload.slice();
+  payload[0] = payload[0]! ^ 1;
+
+  return [
+    {
+      name: "reject-wrong-application-config",
+      scope: "canonical application config account admission",
+      instruction: replaceAccount(0, input.marker),
+      error: "InvalidAccountData",
+      sppInvoked: false,
+    },
+    {
+      name: "reject-wrong-ring-policy",
+      scope: "ring policy owner/discriminator admission",
+      instruction: replaceAccount(1, config),
+      error: { Custom: 8300 },
+      sppInvoked: false,
+    },
+    {
+      name: "reject-unapproved-settlement-program",
+      scope: "pinned SPP executable after combined application verification",
+      instruction: replaceAccount(sppAccounts[0]!.index, SYSTEM_PROGRAM),
+      error: { Custom: 8103 },
+      sppInvoked: false,
+    },
+    {
+      name: "reject-wrong-operation-key",
+      scope: "real valid genesis proof refused by the pinned advance verifier",
+      instruction: await encode({ ...advance.data, proof: input.wrongOperationProof.slice() }),
+      error: { Custom: 8101 },
+      sppInvoked: false,
+    },
+    {
+      name: "reject-reordered-audit-frame",
+      scope: "ordered encrypted audit-envelope blocks; lengths and count byte preserved",
+      instruction: await encode({ ...advance.data, envelope }),
+      error: { Custom: 8101 },
+      sppInvoked: false,
+    },
+    {
+      name: "reject-peer-room-input",
+      scope: "actual unspent peer room nullifier substituted under the first writer's proof",
+      instruction: await encode({
+        ...advance.data,
+        nullifiers: [input.peerNullifier, ...advance.data.nullifiers.slice(1)],
+      }),
+      error: { Custom: 8101 },
+      sppInvoked: false,
+    },
+    {
+      name: "reject-bound-output-substitution",
+      scope: "actual peer note commitment substituted after both proofs were authorized",
+      instruction: await encode({
+        ...advance.data,
+        outputs: [{ ...firstOutput, hash: input.peerCommitment }, ...advance.data.outputs.slice(1)],
+      }),
+      error: { Custom: 7008 },
+      sppInvoked: true,
+    },
+    {
+      name: "reject-ciphertext-substitution",
+      scope: "recipient payload byte changed with all lengths, note hash and proofs preserved",
+      instruction: await encode({
+        ...advance.data,
+        outputs: [
+          { ...firstOutput, body: { kind: "recipient", payload } },
+          ...advance.data.outputs.slice(1),
+        ],
+      }),
+      error: { Custom: 7008 },
+      sppInvoked: true,
+    },
+  ];
+}
