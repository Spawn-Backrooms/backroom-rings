+  return result;
+}
+export async function fetchSpawnRoomConfig(
+  client: Pick<ChainReader, "getAccount">,
+  program: Address,
+  context?: RequestContext,
+): Promise<SpawnRoomConfig> {
+  const account = await client.getAccount(await spawnRoomConfigAddress(program), context);
+  if (account === undefined || account.owner !== program) throw new Error("spawn_config_account");
