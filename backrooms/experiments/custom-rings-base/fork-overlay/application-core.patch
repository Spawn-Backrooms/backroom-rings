+package transfer_test
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/test"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringaudit"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringtransfer"
+	"github.com/helius-labs/zolana/prover/server/prover-test/spp/spptest"
+)
+
+func spawnGenesis(t testing.TB, mutation string) *transfer.SpawnRoomGenesisCircuit {
+	t.Helper()
+	w := spawnZeroValueWorld(t)
+	w.Rail = ringtransfer.PublicOwners
+	if mutation != "live input" {
+		w.Inputs = []ringaudit.Input{}
+	}
+	context := transfer.SpawnRoomGenesisContext{
+		Network: transfer.SpawnDigest{11, 17}, ApplicationID: 19,
+		RingProgramID: ringaudit.NewAudit(t, w.Shape.Stream()).RingProgramID,
+	}
+	state := spawnFixture(t).Advance.Old
+	state.Binding.Network = context.Network
+	state.Binding.ApplicationID = context.ApplicationID
+	state.Binding.RingProgramID = context.RingProgramID
+	state.Writer = ringtransfer.Sender(t)
+	state.Revision, state.Predecessor, state.Authorization, state.LastAuthorizationEpoch = 0, 0, 0, 0
+	state.Memory = spawnMemory("", 0)
+	state.Memory.Episode = transfer.SpawnDigest{0, 0}
+	state.Memory.OriginalResult = transfer.SpawnDigest{0, 0}
+	state.Memory.Candidate = transfer.SpawnDigest{0, 0}
+	state.Policy.Scores = [2]frontend.Variable{50, 50}
+	switch mutation {
+	case "nonzero revision":
+		state.Revision = 1
+	case "preloaded memory":
+		state.Memory = spawnMemory("unapproved", 5)
+	case "missing seed":
+		state.SeedManifest = transfer.SpawnDigest{0, 0}
+	case "different network":
+		context.Network[1] = 997
+	case "second live output":
+		w.Omitted = 0
+		w.Outputs[1] = func(slot *ringaudit.Slot) { slot.Utxo.Amount = 0 }
+	}
+	base := w.Outputs[0]
+	w.Outputs[0] = func(slot *ringaudit.Slot) {
+		base(slot)
+		slot.Utxo.DataHash = spawnStateHash(t, state)
+		slot.Utxo.RingDataHash = big.NewInt(0)
+	}
+	b := w.Build(t)
+	c := &transfer.SpawnRoomGenesisCircuit{TransferCircuit: *b.Circuit, Context: context, State: state}
+	c.GenesisStatementHash = spptest.MustHashChain4(t, ringtest.ToBigInts([]frontend.Variable{
+		0x53505247, context.Network[0], context.Network[1], context.ApplicationID, context.RingProgramID,
+		c.PublicInputHash, spawnIdentity(t, state), state.Writer, 1, 10,
+	}))
+	return c
+}
+
+func TestSpawnRoomGenesisRelation(t *testing.T) {
+	for _, mutation := range []string{"honest", "nonzero revision", "preloaded memory", "missing seed", "different network", "second live output", "live input"} {
+		t.Run(mutation, func(t *testing.T) {
+			c := spawnGenesis(t, mutation)
+			err := test.IsSolved(c, c, ecc.BN254.ScalarField())
+			if mutation == "honest" && err != nil {
+				t.Fatal(err)
+			}
+			if mutation != "honest" && err == nil {
+				t.Fatal("accepted invalid room genesis")
+			}
+		})
+	}
+}
diff --git a/prover/circuits/transfer/spawn_room_proof_test.go b/prover/circuits/transfer/spawn_room_proof_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..8e0739ff0cfc9f317300c6ece3fc13c47373fac5
--- /dev/null
+++ b/prover/circuits/transfer/spawn_room_proof_test.go
@@ -0,0 +1,191 @@
+package transfer_test
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"io"
+	"math/big"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark-crypto/ecc/bn254/fr"
+	"github.com/consensys/gnark/backend/groth16"
+	"github.com/consensys/gnark/constraint"
+	"github.com/consensys/gnark/frontend"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringkey"
+	"github.com/helius-labs/zolana/prover/server/prover/common"
+)
+
+// This explicit integration test performs a fresh local single-party setup and
+// generates a real proof for the full ring+application relation. It is not an
+// SPP signature proof or a validator transaction. Its experimental keys must
+// never be installed in the upstream or v0 catalogs.
+func TestSpawnRoomApplicationGroth16Proof(t *testing.T) {
+	directory := os.Getenv("SPAWN_ROOM_PROOF_DIR")
+	if directory == "" {
+		t.Skip("set SPAWN_ROOM_PROOF_DIR to generate and verify the distinct localnet key")
+	}
+	circuit, err := transfer.NewSpawnRoomApplicationCircuit(transfer.Shape{Inputs: 24, Outputs: 2, Withdrawals: 4, Owners: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assignment := spawnCombined(t)
+	context := assignment.Context
+	metadata := map[string]any{
+		"network":       "0x" + hex.EncodeToString(append(ringtest.AsBigInt(context.Network[0]).FillBytes(make([]byte, 16)), ringtest.AsBigInt(context.Network[1]).FillBytes(make([]byte, 16))...)),
+		"applicationId": common.ToHex(ringtest.AsBigInt(context.ApplicationID)),
+		"ringProgramId": common.ToHex(ringtest.AsBigInt(context.RingProgramID)),
+		"grantRoot":     common.ToHex(ringtest.AsBigInt(context.GrantRoot)),
+		"grantEpoch":    ringtest.AsBigInt(context.GrantEpoch).Uint64(),
+	}
+	spawnProveAndExport(t, directory, "spawn-room-advance-v1", circuit, assignment, metadata)
+}
+
+func TestSpawnRoomGenesisGroth16Proof(t *testing.T) {
+	directory := os.Getenv("SPAWN_ROOM_PROOF_DIR")
+	if directory == "" {
+		t.Skip("set SPAWN_ROOM_PROOF_DIR to generate and verify the distinct localnet key")
+	}
+	circuit, err := transfer.NewSpawnRoomGenesisCircuit(transfer.Shape{Inputs: 24, Outputs: 2, Withdrawals: 4, Owners: 4})
+	if err != nil {
+		t.Fatal(err)
+	}
+	assignment := spawnGenesis(t, "honest")
+	context := assignment.Context
+	metadata := map[string]any{
+		"network":          "0x" + hex.EncodeToString(append(ringtest.AsBigInt(context.Network[0]).FillBytes(make([]byte, 16)), ringtest.AsBigInt(context.Network[1]).FillBytes(make([]byte, 16))...)),
+		"applicationId":    common.ToHex(ringtest.AsBigInt(context.ApplicationID)),
+		"ringProgramId":    common.ToHex(ringtest.AsBigInt(context.RingProgramID)),
+		"creationIdentity": common.ToHex(spawnIdentity(t, assignment.State)),
+		"writerOwnerHash":  common.ToHex(ringtest.AsBigInt(assignment.State.Writer)),
+	}
+	spawnProveAndExport(t, directory, "spawn-room-genesis-v1", circuit, assignment, metadata)
+}
+
+func spawnProveAndExport(t testing.TB, directory, name string, circuit, assignment frontend.Circuit, metadata map[string]any) {
+	t.Helper()
+	if err := os.MkdirAll(directory, 0700); err != nil {
+		t.Fatal(err)
+	}
+	t.Log("compiling full", name)
+	cs := ringkey.Compile(t, circuit)
+	if got := cs.GetNbPublicVariables() - 1; got != 2 {
+		t.Fatalf("public inputs=%d, want2", got)
+	}
+	commitments, ok := cs.GetCommitments().(constraint.Groth16Commitments)
+	if !ok || len(commitments) != 1 || commitments[0].NbPublicCommitted != 0 {
+		t.Fatalf("unexpected commitment configuration: %v", cs.GetCommitments())
+	}
+	keyPath := filepath.Join(directory, name+".key")
+	system := &common.ExtensionProofSystem{CircuitType: common.CircuitType(name), ConstraintSystem: cs}
+	if os.Getenv("SPAWN_ROOM_REUSE_LOCAL_KEY") == "1" {
+		t.Log("reloading explicitly requested local key and comparing the complete constraint system")
+		file, err := os.Open(keyPath)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if _, err := system.UnsafeReadFrom(file); err != nil {
+			t.Fatal(err)
+		}
+		if err := file.Close(); err != nil {
+			t.Fatal(err)
+		}
+		compiledHash, loadedHash := sha256.New(), sha256.New()
+		if _, err := cs.WriteTo(compiledHash); err != nil {
+			t.Fatal(err)
+		}
+		if _, err := system.ConstraintSystem.WriteTo(loadedHash); err != nil {
+			t.Fatal(err)
+		}
+		if hex.EncodeToString(compiledHash.Sum(nil)) != hex.EncodeToString(loadedHash.Sum(nil)) {
+			t.Fatal("local key constraint system differs from the current compiled circuit")
+		}
+	} else {
+		t.Logf("compiled %d constraints; performing local single-party setup", cs.GetNbConstraints())
+		var err error
+		system.ProvingKey, system.VerifyingKey, err = groth16.Setup(cs)
+		if err != nil {
+			t.Fatal(err)
+		}
+		writeSpawnArtifact(t, keyPath, system)
+		writeSpawnArtifact(t, filepath.Join(directory, name+".vk.bin"), rawKey{system.VerifyingKey})
+	}
+	pk, vk := system.ProvingKey, system.VerifyingKey
+	keyFile, err := os.Open(keyPath)
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := sha256.New()
+	if _, err := io.Copy(h, keyFile); err != nil {
+		t.Fatal(err)
+	}
+	if err := keyFile.Close(); err != nil {
+		t.Fatal(err)
+	}
+	copy(system.ProvingKeySha256[:], h.Sum(nil))
+	t.Log("proving full", name)
+	full, err := frontend.NewWitness(assignment, ecc.BN254.ScalarField())
+	if err != nil {
+		t.Fatal(err)
+	}
+	proof, err := groth16.Prove(cs, pk, full)
+	if err != nil {
+		t.Fatal(err)
+	}
+	public, err := full.Public()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := groth16.Verify(proof, vk, public); err != nil {
+		t.Fatalf("honest proof refused: %v", err)
+	}
+	inputs := public.Vector().(fr.Vector)
+	metadata["publicInputs"] = []string{common.ToHex(inputs[0].BigInt(new(big.Int))), common.ToHex(inputs[1].BigInt(new(big.Int)))}
+	metadata["constraints"] = cs.GetNbConstraints()
+	metadata["circuit"] = name
+	metadata["proof"] = &common.Proof{Proof: proof, ProvingKeySha256: system.ProvingKeySha256}
+	metadata["setup"] = "experimental localnet single-party setup; no production authorization"
+	encoded, err := json.MarshalIndent(metadata, "", "  ")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(directory, name+".proof.json"), append(encoded, '\n'), 0600); err != nil {
+		t.Fatal(err)
+	}
+	one := fr.One()
+	for i := range inputs {
+		original := inputs[i]
+		inputs[i].Add(&inputs[i], &one)
+		if groth16.Verify(proof, vk, public) == nil {
+			t.Fatalf("proof verified under modified public input%d", i)
+		}
+		inputs[i] = original
+	}
+	t.Logf("verified real proof, rejected both changed public inputs; key SHA256 %x", system.ProvingKeySha256)
+}
+
+type rawKey struct{ groth16.VerifyingKey }
+
+func (k rawKey) WriteTo(w io.Writer) (int64, error) { return k.WriteRawTo(w) }
+
+func writeSpawnArtifact(t testing.TB, path string, value io.WriterTo) {
+	t.Helper()
+	// Never silently replace a key generated by a different setup.
+	f, err := os.OpenFile(path, os.O_WRONLY|os.O_CREATE|os.O_EXCL, 0600)
+	if err != nil {
+		t.Fatal(err)
+	}
+	_, writeErr := value.WriteTo(f)
+	closeErr := f.Close()
+	if writeErr != nil {
+		t.Fatal(writeErr)
+	}
+	if closeErr != nil {
+		t.Fatal(closeErr)
+	}
+}
diff --git a/prover/circuits/transfer/spawn_room_state.go b/prover/circuits/transfer/spawn_room_state.go
new file mode 100644
index 0000000000000000000000000000000000000000..17376b0b9286f74c07f383d2f6dcbb368b2a661b
--- /dev/null
+++ b/prover/circuits/transfer/spawn_room_state.go
@@ -0,0 +1,245 @@
+package transfer
+
+import (
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/std/rangecheck"
+
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/registry"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/shared"
+	"github.com/helius-labs/zolana/prover/server/circuits/gadget"
+)
+
+const (
+	SpawnRoomSchema            = 1
+	SpawnRoomLessonCapacity    = 96
+	SpawnRoomIdentityDomain    = 0x5350524944303031 // SPRID001
+	SpawnRoomStateDomain       = 0x5350525354303031 // SPRST001
+	SpawnAcceptedMemoryDomain  = 0x5350524d454d3031 // SPRMEM01
+	SpawnAcceptanceGrantDomain = 0x5350524752303031 // SPRGR001
+)
+
+// SpawnDigest is the big-endian high and low 128-bit limbs of a 32-byte digest.
+// Keeping both limbs preserves all 256 bits; reducing a digest modulo q does not.
+type SpawnDigest [2]frontend.Variable
+
+func (d SpawnDigest) validate(rc frontend.Rangechecker) {
+	for _, limb := range d {
+		rc.Check(limb, 128)
+	}
+}
+
+func (d SpawnDigest) assertEqual(api frontend.API, other SpawnDigest) {
+	for i := range d {
+		api.AssertIsEqual(d[i], other[i])
+	}
+}
+
+// SpawnRoomContext must be bound by the combined circuit's application statement.
+// The program supplies these values from its actual deployment and current,
+// authenticated authorization configuration. A private caller-selected context
+// alone establishes no authorization. The grant tree is separate from policy and
+// tracking registries even though its membership path reuses their 4-ary gadget.
+type SpawnRoomContext struct {
+	Network                                             SpawnDigest
+	ApplicationID, RingProgramID, GrantRoot, GrantEpoch frontend.Variable
+}
+
+// SpawnRoomBinding is private and remains unchanged after visible genesis.
+// ApplicationID and RingProgramID use the program's canonical field derivations.
+type SpawnRoomBinding struct {
+	Network                      SpawnDigest
+	ApplicationID, RingProgramID frontend.Variable
+	CreationNonce                SpawnDigest
+}
+
+type SpawnAcceptedMemory struct {
+	Lesson                             [SpawnRoomLessonCapacity]frontend.Variable
+	Length, Scope                      frontend.Variable
+	Episode, OriginalResult, Candidate SpawnDigest
+}
+
+type SpawnLearnedPolicy struct {
+	ID     frontend.Variable
+	Scores [2]frontend.Variable
+}
+
+// SpawnRoomState is a new commitment format, not the v0 state or encryption codec.
+// A codec must emit these exact typed values, refuse trailing bytes and noncanonical
+// scalar encodings, and preserve the full digest limbs before building a witness.
+type SpawnRoomState struct {
+	Binding                                            SpawnRoomBinding
+	SeedManifest, FixedMembers                         SpawnDigest
+	Writer, Revision                                   frontend.Variable
+	Memory                                             SpawnAcceptedMemory
+	Policy                                             SpawnLearnedPolicy
+	Predecessor, Authorization, LastAuthorizationEpoch frontend.Variable
+}
+
+// Identity is private on hidden advances. Publishing it, or a per-room account
+// derived from it, would link advances to the visible genesis writer.
+func (s SpawnRoomState) Identity(api frontend.API) frontend.Variable {
+	b := s.Binding
+	return spawnHash(api, []frontend.Variable{SpawnRoomIdentityDomain, SpawnRoomSchema,
+		b.Network[0], b.Network[1], b.ApplicationID, b.RingProgramID,
+		b.CreationNonce[0], b.CreationNonce[1], s.Writer})
+}
+
+// Hash bounds every byte, limb and integer before committing the state. Memory
+// bytes pack as four big-endian 24-byte integers, each strictly below q.
+func (s SpawnRoomState) Hash(api frontend.API) frontend.Variable {
+	rc := rangecheck.New(api)
+	s.Binding.Network.validate(rc)
+	s.Binding.CreationNonce.validate(rc)
+	s.SeedManifest.validate(rc)
+	s.FixedMembers.validate(rc)
+	api.AssertIsEqual(api.IsZero(s.Writer), 0)
+	rc.Check(s.Revision, 64)
+	rc.Check(s.LastAuthorizationEpoch, 64)
+	s.Policy.validate(api, rc)
+	return spawnHash(api, []frontend.Variable{SpawnRoomStateDomain, SpawnRoomSchema,
+		s.Identity(api), s.SeedManifest[0], s.SeedManifest[1], s.FixedMembers[0], s.FixedMembers[1],
+		s.Revision, s.Memory.hash(api, rc), s.Policy.ID, s.Policy.Scores[0], s.Policy.Scores[1],
+		s.Predecessor, s.Authorization, s.LastAuthorizationEpoch})
+}
+
+func (m SpawnAcceptedMemory) hash(api frontend.API, rc frontend.Rangechecker) frontend.Variable {
+	spawnBounded(api, rc, m.Length, SpawnRoomLessonCapacity, 7)
+	api.AssertIsEqual(m.Scope, 0)
+	m.Episode.validate(rc)
+	m.OriginalResult.validate(rc)
+	m.Candidate.validate(rc)
+	fields := []frontend.Variable{SpawnAcceptedMemoryDomain, m.Length, m.Scope}
+	for start := 0; start < len(m.Lesson); start += 24 {
+		chunk := frontend.Variable(0)
+		for i := start; i < start+24; i++ {
+			rc.Check(m.Lesson[i], 8)
+			// Both operands are in 0..96; the top bit is one exactly
+			// when i+1 <= Length. Bytes outside that prefix are zero.
+			live := spawnAtMostByte(api, i+1, m.Length)
+			api.AssertIsEqual(api.Mul(api.Sub(1, live), m.Lesson[i]), 0)
+			chunk = api.Add(api.Mul(chunk, 256), m.Lesson[i])
+		}
+		fields = append(fields, chunk)
+	}
+	fields = append(fields, m.Episode[0], m.Episode[1], m.OriginalResult[0], m.OriginalResult[1], m.Candidate[0], m.Candidate[1])
+	return spawnHash(api, fields)
+}
+
+func (p SpawnLearnedPolicy) validate(api frontend.API, rc frontend.Rangechecker) {
+	api.AssertIsEqual(p.ID, 1)
+	for _, score := range p.Scores {
+		spawnBounded(api, rc, score, 100, 7)
+	}
+}
+
+// SpawnAcceptanceGrant is an exact private authorization leaf. Membership under
+// the live root authenticates it; its commitment alone is not an authorization.
+// Native authority persistence establishes the original result before admission.
+type SpawnAcceptanceGrant struct {
+	RoomIdentity, Actor, Epoch, Predecessor, Ordinal frontend.Variable
+	Memory                                           SpawnAcceptedMemory
+	SelectedProcedure, Negative, Magnitude           frontend.Variable
+	Nonce                                            SpawnDigest
+}
+
+func (g SpawnAcceptanceGrant) hash(api frontend.API, rc frontend.Rangechecker, context SpawnRoomContext) frontend.Variable {
+	rc.Check(g.Epoch, 64)
+	rc.Check(g.Ordinal, 64)
+	api.AssertIsBoolean(g.SelectedProcedure)
+	api.AssertIsBoolean(g.Negative)
+	spawnBounded(api, rc, g.Magnitude, 10, 4)
+	g.Nonce.validate(rc)
+	api.AssertIsEqual(api.Mul(api.IsZero(g.Nonce[0]), api.IsZero(g.Nonce[1])), 0)
+	// Memory.hash permits empty genesis memory; an accepted lesson does not.
+	rc.Check(api.Sub(g.Memory.Length, 1), 7)
+	return spawnHash(api, []frontend.Variable{SpawnAcceptanceGrantDomain, SpawnRoomSchema,
+		context.Network[0], context.Network[1], context.ApplicationID, context.RingProgramID,
+		g.RoomIdentity, g.Actor, g.Epoch, g.Predecessor, g.Ordinal, g.Memory.hash(api, rc),
+		g.SelectedProcedure, g.Negative, g.Magnitude, g.Nonce[0], g.Nonce[1]})
+}
+
+type SpawnRoomAdvanceWitness struct {
+	Old, Next SpawnRoomState
+	Grant     SpawnAcceptanceGrant
+	GrantPath registry.QuadPath
+}
+
+// Assert binds this application transition to the actual note wires passed to
+// TransferCircuit.Define. The caller still proves the full upstream ring/SPP
+// relation, the hidden rail, exact slot profile and the live application statement.
+// Unique genesis and exclusion of alternate settlement paths remain program duties.
+func (w SpawnRoomAdvanceWitness) Assert(api frontend.API, context SpawnRoomContext, input, output shared.UtxoWires) {
+	rc := rangecheck.New(api)
+	context.Network.validate(rc)
+	api.AssertIsEqual(api.IsZero(context.ApplicationID), 0)
+	api.AssertIsEqual(api.IsZero(context.RingProgramID), 0)
+	api.AssertIsEqual(api.IsZero(context.GrantRoot), 0)
+	rc.Check(context.GrantEpoch, 64)
+	oldNote, nextNote := input.OpenSlot(api), output.OpenSlot(api)
+	for _, note := range []shared.Output{oldNote, nextNote} {
+		api.AssertIsEqual(note.Utxo, 1)
+		api.AssertIsEqual(note.Ring, 1)
+		api.AssertIsEqual(note.RingProgramID, context.RingProgramID)
+		api.AssertIsEqual(note.Amount, 0)
+		api.AssertIsEqual(note.RingDataHash, 0)
+		api.AssertIsEqual(api.IsZero(note.NullifierPk), 0)
+		api.AssertIsEqual(api.IsZero(api.Sub(note.NullifierPk, shared.ZeroNullifierPk)), 0)
+	}
+	api.AssertIsEqual(input.OwnerPkHash, output.OwnerPkHash)
+	api.AssertIsEqual(input.NullifierPk, output.NullifierPk)
+	api.AssertIsEqual(input.Asset, output.Asset)
+	for _, state := range []SpawnRoomState{w.Old, w.Next} {
+		state.Binding.Network.assertEqual(api, context.Network)
+		api.AssertIsEqual(state.Binding.ApplicationID, context.ApplicationID)
+		api.AssertIsEqual(state.Binding.RingProgramID, context.RingProgramID)
+		api.AssertIsEqual(state.Writer, input.OwnerPkHash)
+	}
+	w.Old.Binding.CreationNonce.assertEqual(api, w.Next.Binding.CreationNonce)
+	w.Old.SeedManifest.assertEqual(api, w.Next.SeedManifest)
+	w.Old.FixedMembers.assertEqual(api, w.Next.FixedMembers)
+	api.AssertIsEqual(input.DataHash, w.Old.Hash(api))
+	api.AssertIsEqual(output.DataHash, w.Next.Hash(api))
+	// Both revisions are u64, so this field equality cannot wrap an overflow.
+	api.AssertIsEqual(w.Next.Revision, api.Add(w.Old.Revision, 1))
+	api.AssertIsEqual(w.Grant.Ordinal, w.Next.Revision)
+	api.AssertIsEqual(w.Grant.RoomIdentity, w.Old.Identity(api))
+	api.AssertIsEqual(w.Grant.Actor, input.OwnerPkHash)
+	api.AssertIsEqual(w.Grant.Predecessor, oldNote.Hash)
+	api.AssertIsEqual(w.Next.Predecessor, oldNote.Hash)
+	api.AssertIsEqual(w.Grant.Epoch, context.GrantEpoch)
+	api.AssertIsEqual(w.Next.LastAuthorizationEpoch, context.GrantEpoch)
+	// A new authority epoch may reauthorize an existing checkpoint. A rollback
+	// would produce a field difference outside the u64 range and is refused.
+	rc.Check(api.Sub(context.GrantEpoch, w.Old.LastAuthorizationEpoch), 64)
+	grant := w.Grant.hash(api, rc, context)
+	api.AssertIsEqual(w.GrantPath.Root(api, grant), context.GrantRoot)
+	api.AssertIsEqual(w.Next.Authorization, grant)
+	api.AssertIsEqual(w.Next.Memory.hash(api, rc), w.Grant.Memory.hash(api, rc))
+	w.assertLearning(api)
+}
+
+func (w SpawnRoomAdvanceWitness) assertLearning(api frontend.API) {
+	g := w.Grant
+	old := api.Select(g.SelectedProcedure, w.Old.Policy.Scores[1], w.Old.Policy.Scores[0])
+	sum := api.Add(old, g.Magnitude)
+	positive := api.Select(spawnAtMostByte(api, sum, 100), sum, 100)
+	negative := api.Select(spawnAtMostByte(api, old, g.Magnitude), 0, api.Sub(old, g.Magnitude))
+	next := api.Select(g.Negative, negative, positive)
+	api.AssertIsEqual(w.Next.Policy.Scores[0], api.Select(g.SelectedProcedure, w.Old.Policy.Scores[0], next))
+	api.AssertIsEqual(w.Next.Policy.Scores[1], api.Select(g.SelectedProcedure, next, w.Old.Policy.Scores[1]))
+}
+
+func spawnHash(api frontend.API, fields []frontend.Variable) frontend.Variable {
+	return gadget.HashChain4(api, append(fields, len(fields)+1))
+}
+
+func spawnBounded(api frontend.API, rc frontend.Rangechecker, value frontend.Variable, maximum, bits int) {
+	rc.Check(value, bits)
+	rc.Check(api.Sub(maximum, value), bits)
+}
+
+// Both caller-bounded operands are at most 110, so 256+b-a lies in 146..366.
+// Its top bit therefore gives a <= b without a field wrap or an untrusted hint.
+func spawnAtMostByte(api frontend.API, a, b frontend.Variable) frontend.Variable {
+	return api.ToBinary(api.Add(256, api.Sub(b, a)), 9)[8]
+}
diff --git a/prover/circuits/transfer/spawn_room_state_test.go b/prover/circuits/transfer/spawn_room_state_test.go
new file mode 100644
index 0000000000000000000000000000000000000000..1935cb6d8be156d25231763be16f9b2984779e41
--- /dev/null
+++ b/prover/circuits/transfer/spawn_room_state_test.go
@@ -0,0 +1,454 @@
+package transfer_test
+
+import (
+	"math/big"
+	"testing"
+
+	"github.com/consensys/gnark-crypto/ecc"
+	"github.com/consensys/gnark/frontend"
+	"github.com/consensys/gnark/frontend/cs/r1cs"
+	"github.com/consensys/gnark/test"
+
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/registry"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/shared"
+	"github.com/helius-labs/zolana-custom-rings/prover/circuits/transfer"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringaudit"
+	"github.com/helius-labs/zolana-custom-rings/prover/ringtest/ringtransfer"
+	"github.com/helius-labs/zolana/prover/server/prover-test/spp/protocol"
+	"github.com/helius-labs/zolana/prover/server/prover-test/spp/spptest"
+)
+
+// This small circuit tests the application relation against actual UTXO
+// openings. Its public inputs are a test harness, not the application wire format.
+type spawnStateCircuit struct {
+	Context          transfer.SpawnRoomContext `gnark:",public"`
+	InputCommitment  frontend.Variable         `gnark:",public"`
+	OutputCommitment frontend.Variable         `gnark:",public"`
+	Input, Output    shared.UtxoWires
+	Advance          transfer.SpawnRoomAdvanceWitness
+}
+
+func (c *spawnStateCircuit) Define(api frontend.API) error {
+	api.AssertIsEqual(c.Input.OpenSlot(api).Hash, c.InputCommitment)
+	api.AssertIsEqual(c.Output.OpenSlot(api).Hash, c.OutputCommitment)
+	c.Advance.Assert(api, c.Context, c.Input, c.Output)
+	return nil
+}
+
+func spawnMemory(lesson string, seed int) transfer.SpawnAcceptedMemory {
+	m := transfer.SpawnAcceptedMemory{
+		Length: len(lesson), Scope: 0,
+		Episode:        transfer.SpawnDigest{seed, seed + 1},
+		OriginalResult: transfer.SpawnDigest{seed + 2, seed + 3},
+		Candidate:      transfer.SpawnDigest{seed + 4, seed + 5},
+	}
+	for i := range m.Lesson {
+		m.Lesson[i] = 0
+		if i < len(lesson) {
+			m.Lesson[i] = int(lesson[i])
+		}
+	}
+	return m
+}
+
+func spawnFixture(t testing.TB) *spawnStateCircuit {
+	t.Helper()
+	c := &spawnStateCircuit{Context: transfer.SpawnRoomContext{
+		Network:       transfer.SpawnDigest{new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), 128), big.NewInt(1)), 17},
+		ApplicationID: 19, RingProgramID: 13, GrantEpoch: 3,
+	}}
+	old := transfer.SpawnRoomState{
+		Binding:      transfer.SpawnRoomBinding{Network: c.Context.Network, ApplicationID: 19, RingProgramID: 13, CreationNonce: transfer.SpawnDigest{23, 29}},
+		SeedManifest: transfer.SpawnDigest{31, 37}, FixedMembers: transfer.SpawnDigest{41, 43},
+		Writer: 7, Revision: 4, Memory: spawnMemory("older lesson", 47),
+		Policy:      transfer.SpawnLearnedPolicy{ID: 1, Scores: [2]frontend.Variable{50, 50}},
+		Predecessor: 79, Authorization: 83, LastAuthorizationEpoch: 2,
+	}
+	c.Advance.Old, c.Advance.Next = old, old
+	c.Advance.Grant = transfer.SpawnAcceptanceGrant{
+		Actor: 7, Epoch: 3, Ordinal: 5, Memory: spawnMemory("Use a bounded retry.", 53),
+		SelectedProcedure: 0, Negative: 0, Magnitude: 7, Nonce: transfer.SpawnDigest{89, 97},
+	}
+	c.Advance.Next.Revision = 5
+	c.Advance.Next.LastAuthorizationEpoch = 3
+	c.Advance.Next.Memory = c.Advance.Grant.Memory
+	c.Advance.Next.Policy.Scores = [2]frontend.Variable{57, 50}
+	c.Input = shared.UtxoWires{Domain: protocol.UtxoDomain, TreeID: 0, OwnerPkHash: 7, NullifierPk: 9, Asset: 11, Amount: 0, Blinding: 101, DataHash: 0, RingDataHash: 0, RingProgramID: 13}
+	c.Output = c.Input
+	c.Output.Blinding = 103
+	c.Advance.GrantPath.Index = 37
+	empty := big.NewInt(0)
+	for level := range c.Advance.GrantPath.Siblings {
+		for child := range c.Advance.GrantPath.Siblings[level] {
+			c.Advance.GrantPath.Siblings[level][child] = new(big.Int).Set(empty)
+		}
+		empty = ringtest.MustPoseidonHash(t, empty, empty, empty, empty)
+	}
+	spawnRebindInput(t, c)
+	spawnAuthorize(t, c)
+	return c
+}
+
+// Build the application state before the upstream fixture hashes any slots. The
+// fixture's real owner, enrolled key, ring and input blinding are retained.
+func spawnApplicationFixture(t testing.TB) (ringtransfer.Anonymous, *spawnStateCircuit) {
+	t.Helper()
+	w, c := spawnZeroValueWorld(t), spawnFixture(t)
+	c.Input = w.Inputs[0].Utxo.Wires()
+	c.Output = c.Input
+	c.Output.Blinding = 103 // The upstream world derives its actual output blinding.
+	c.Context.RingProgramID = c.Input.RingProgramID
+	c.Advance.Old.Binding.RingProgramID = c.Input.RingProgramID
+	c.Advance.Next.Binding.RingProgramID = c.Input.RingProgramID
+	c.Advance.Old.Writer = c.Input.OwnerPkHash
+	c.Advance.Next.Writer = c.Input.OwnerPkHash
+	c.Advance.Grant.Actor = c.Input.OwnerPkHash
+	spawnRebindInput(t, c)
+	spawnAuthorize(t, c)
+	w.Inputs[0].Utxo.DataHash = ringtest.AsBigInt(c.Input.DataHash)
+	w.Inputs[0].Utxo.RingDataHash = big.NewInt(0)
+	baseOutput := w.Outputs[0]
+	w.Outputs[0] = func(slot *ringaudit.Slot) {
+		baseOutput(slot)
+		slot.Utxo.DataHash = spawnStateHash(t, c.Advance.Next)
+		slot.Utxo.RingDataHash = big.NewInt(0)
+	}
+	return w, c
+}
+
+// These builders compute host commitments with the independent protocol
+// implementation. Mutation cases rehash changed notes and authorized grants so
+// failures exercise the transition constraints rather than a stale hash.
+func spawnClosedHash(t testing.TB, values ...frontend.Variable) *big.Int {
+	t.Helper()
+	values = append(values, len(values)+1)
+	return spptest.MustHashChain4(t, ringtest.ToBigInts(values))
+}
+
+func spawnIdentity(t testing.TB, s transfer.SpawnRoomState) *big.Int {
+	t.Helper()
+	b := s.Binding
+	return spawnClosedHash(t, transfer.SpawnRoomIdentityDomain, transfer.SpawnRoomSchema, b.Network[0], b.Network[1], b.ApplicationID, b.RingProgramID, b.CreationNonce[0], b.CreationNonce[1], s.Writer)
+}
+
+func spawnMemoryHash(t testing.TB, m transfer.SpawnAcceptedMemory) *big.Int {
+	t.Helper()
+	fields := []frontend.Variable{transfer.SpawnAcceptedMemoryDomain, m.Length, m.Scope}
+	for start := 0; start < len(m.Lesson); start += 24 {
+		chunk := big.NewInt(0)
+		for _, value := range m.Lesson[start : start+24] {
+			chunk.Mul(chunk, big.NewInt(256)).Add(chunk, ringtest.AsBigInt(value))
+		}
+		fields = append(fields, chunk)
+	}
+	fields = append(fields, m.Episode[0], m.Episode[1], m.OriginalResult[0], m.OriginalResult[1], m.Candidate[0], m.Candidate[1])
+	return spawnClosedHash(t, fields...)
+}
+
+func spawnStateHash(t testing.TB, s transfer.SpawnRoomState) *big.Int {
+	t.Helper()
+	return spawnClosedHash(t, transfer.SpawnRoomStateDomain, transfer.SpawnRoomSchema, spawnIdentity(t, s), s.SeedManifest[0], s.SeedManifest[1], s.FixedMembers[0], s.FixedMembers[1], s.Revision, spawnMemoryHash(t, s.Memory), s.Policy.ID, s.Policy.Scores[0], s.Policy.Scores[1], s.Predecessor, s.Authorization, s.LastAuthorizationEpoch)
+}
+
+func spawnGrantHash(t testing.TB, c *spawnStateCircuit) *big.Int {
+	t.Helper()
+	g, context := c.Advance.Grant, c.Context
+	return spawnClosedHash(t, transfer.SpawnAcceptanceGrantDomain, transfer.SpawnRoomSchema, context.Network[0], context.Network[1], context.ApplicationID, context.RingProgramID, g.RoomIdentity, g.Actor, g.Epoch, g.Predecessor, g.Ordinal, spawnMemoryHash(t, g.Memory), g.SelectedProcedure, g.Negative, g.Magnitude, g.Nonce[0], g.Nonce[1])
+}
+
+func spawnNoteHash(t testing.TB, note shared.UtxoWires) *big.Int {
+	t.Helper()
+	owner := ringtest.MustPoseidonHash(t, ringtest.AsBigInt(note.OwnerPkHash), ringtest.AsBigInt(note.NullifierPk))
+	return spptest.MustUtxoHash(t, protocol.Utxo{Domain: ringtest.AsBigInt(note.Domain), Owner: owner, Asset: ringtest.AsBigInt(note.Asset), Amount: ringtest.AsBigInt(note.Amount), Blinding: ringtest.AsBigInt(note.Blinding), DataHash: ringtest.AsBigInt(note.DataHash), RingDataHash: ringtest.AsBigInt(note.RingDataHash), RingProgramID: ringtest.AsBigInt(note.RingProgramID)}, ringtest.AsBigInt(note.TreeID))
+}
+
+func spawnGrantRoot(t testing.TB, path registry.QuadPath, leaf *big.Int) *big.Int {
+	t.Helper()
+	index := ringtest.AsBigInt(path.Index).Uint64()
+	for level, row := range path.Siblings {
+		position := (index >> (2 * level)) & 3
+		children := make([]*big.Int, 4)
+		sibling := 0
+		for child := range children {
+			if uint64(child) == position {
+				children[child] = leaf
+			} else {
+				children[child] = ringtest.AsBigInt(row[sibling])
+				sibling++
+			}
+		}
+		leaf = ringtest.MustPoseidonHash(t, children...)
+	}
+	return leaf
+}
+
+func spawnRebindInput(t testing.TB, c *spawnStateCircuit) {
+	t.Helper()
+	c.Input.DataHash = spawnStateHash(t, c.Advance.Old)
+	c.InputCommitment = spawnNoteHash(t, c.Input)
+	c.Advance.Grant.RoomIdentity = spawnIdentity(t, c.Advance.Old)
+	c.Advance.Grant.Predecessor = c.InputCommitment
+	c.Advance.Next.Predecessor = c.InputCommitment
+}
+
